<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the Cleaner workspace from MainWindow.Cleaning.cs (~726 lines
    of named-control, null-checked WPF code-behind).

    Scan target categories, review sizes/safety, select, confirm, and clean.
    The scan is read-only; cleaning is gated behind an injected confirmation
    that defaults to refusing.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.CleanerWorkspaceView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Deltempo.App.WinUI.Converters"
    xmlns:models="using:WinTempCleaner.Models"
    mc:Ignorable="d"
    d:DesignWidth="1000"
    d:DesignHeight="640">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
        <!-- IsEnabled needs a bool; a Visibility converter throws in WinUI 3. -->
        <converters:BoolNegationConverter x:Key="NotBool" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <!-- Shares the ported WPF chip template with the other filter rows. -->
        <Style x:Key="CleanerChip" TargetType="RadioButton" BasedOn="{StaticResource FilterChipRadio}" />

        <DataTemplate x:Key="TargetRowTemplate" x:DataType="models:TargetFolderInfo">
            <Border
                Background="{StaticResource SurfaceSubCardBrush}"
                BorderBrush="{StaticResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,9">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <CheckBox
                        Grid.Column="0"
                        MinWidth="0"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding Name}" />

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextHighBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding Description}"
                            FontSize="10"
                            Foreground="{StaticResource TextMutedBrush}"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Left"
                            MaxWidth="320" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="6,1.5"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Category}"
                            FontSize="9.5"
                            Foreground="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"
                            VerticalAlignment="Center" />
                    </Border>

                    <TextBlock
                        Grid.Column="3"
                        Text="{Binding FormattedSize}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center" />

                    <Border
                        Grid.Column="4"
                        Background="{Binding SafetyBadgeColor, Converter={StaticResource HexToBrush}}"
                        BorderBrush="{Binding SafetyBadgeColor, Converter={StaticResource HexToBrush}}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="6,1.5"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding SafetyBadge}"
                            FontSize="9.5"
                            Foreground="{StaticResource TextHighBrush}"
                            VerticalAlignment="Center" />
                    </Border>

                    <Button
                        Grid.Column="5"
                        Content="Retry"
                        Background="{StaticResource PillButtonBgBrush}"
                        BorderBrush="{StaticResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,3"
                        FontSize="10"
                        Margin="8,0,0,0"
                        Command="{Binding ViewModel.RetryTargetCommand, ElementName=Root}"
                        CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Transparent, not a fill of its own. The shell window already paints the canvas
         scrim over the Mica backdrop, so a panel that painted it again would double the
         scrim and make the content column darker than the navigation pane. What this
         panel has to hide - the Stage 1 placeholder and the Core link card - is collapsed
         by ShowWorkspace instead. -->
    <Grid Padding="18,16" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Hero stats + actions -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Reclaimable" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.HeroSizeText, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ElectricCyanBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Categories" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Targets.Count, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextHighBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <Button
                    Content="AppData Report"
                    ToolTipService.ToolTip="Read-only report: show where your AppData space goes. Nothing is selected and nothing is deleted."
                    AutomationProperties.Name="AppData Footprint Report (read only)"
                    Background="{StaticResource PillButtonBgBrush}"
                    BorderBrush="{StaticResource PillButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,6"
                    FontSize="11.5"
                    Margin="0,0,8,0"
                    Click="OnFootprintRequested" />

                <Button
                    Content="Scan Now"
                    Background="{StaticResource PillButtonBgBrush}"
                    BorderBrush="{StaticResource PillButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,6"
                    FontSize="11.5"
                    Margin="0,0,8,0"
                    IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotBool}}"
                    Command="{x:Bind ViewModel.ScanCommand, Mode=OneTime}" />

                <Button
                    Content="Clean Selected"
                    Background="{StaticResource DestructiveRedBrush}"
                    BorderThickness="0"
                    CornerRadius="14"
                    Padding="14,6"
                    FontSize="11.5"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Command="{x:Bind ViewModel.CleanSelectedCommand, Mode=OneTime}" />
            </StackPanel>
        </Grid>

        <!-- Filter + selection chips -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,12,0,10" VerticalAlignment="Center">
            <TextBlock Text="Selection:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <RadioButton GroupName="CleanerScope" Content="Safe Only" Style="{StaticResource CleanerChip}" Tag="SAFE" Checked="OnSafeOnly" />
            <RadioButton GroupName="CleanerScope" Content="All" Style="{StaticResource CleanerChip}" Tag="ALL" IsChecked="True" Checked="OnSelectAll" />
            <RadioButton GroupName="CleanerScope" Content="None" Style="{StaticResource CleanerChip}" Tag="NONE" Checked="OnDeselectAll" />

            <TextBlock Text="Filter:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
            <RadioButton GroupName="CleanerFilter" Content="All" Style="{StaticResource CleanerChip}" Tag="ALL" IsChecked="True" Checked="OnFilterChanged" />
            <RadioButton GroupName="CleanerFilter" Content="Safe Mode" Style="{StaticResource CleanerChip}" Tag="SAFE" Checked="OnFilterChanged" />
            <RadioButton GroupName="CleanerFilter" Content="System" Style="{StaticResource CleanerChip}" Tag="SYSTEM" Checked="OnFilterChanged" />
        </StackPanel>

        <!-- Target list -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8,6">
            <ListView
                ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                SelectionMode="None"
                HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <StaticResource ResourceKey="TargetRowTemplate" />
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Empty state -->
        <Border
            Grid.Row="2"
            Background="{StaticResource SurfaceCardBrush}"
            BorderBrush="{StaticResource HairlineBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisInv}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="No categories to scan"
                           FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextHighBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Click Scan Now to discover cleanable temporary locations."
                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" MaxWidth="460" />
            </StackPanel>
        </Border>

        <!-- Selection summary -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource HairlineBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CleanButtonText, Mode=OneWay}"
                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMediumBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.HeroSubtext, Mode=OneWay}"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
