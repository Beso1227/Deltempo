<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of Views/Modals/MemoryOptimizerModal.xaml (286 lines).
    Five rows, same as WPF: header, telemetry strip, selection toolbar,
    zone list, footer actions.

    Differences forced by the framework:
      - the zone CheckBox binds to an observable wrapper property, because
        MemoryAreaSnapshot.IsSelected raises no notification and the WPF modal
        compensated with ItemsControl.Items.Refresh()
      - the per-zone Flush button uses a row-level command instead of a Click
        handler reading Button.Tag
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.MemoryOptimizerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Deltempo.App.WinUI.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="840"
    d:DesignHeight="660">

    <Grid Background="Transparent">
        <Border Margin="18,8,18,6"
                Background="{StaticResource SurfaceSubCardBrush}"
                BorderBrush="{StaticResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20,18">

            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

                <!-- 0. Header -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="{StaticResource SurfaceSubCardBrush}"
                                BorderBrush="{StaticResource ElectricCyanBrush}"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE950;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="18"
                                      Foreground="{StaticResource ElectricCyanBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Windows Memory Cleaner &amp; Standby Cache"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextHighBrush}" />
                            <TextBlock Text="Kernel-level Standby List, System File Cache &amp; Working Set Optimizer"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextMediumBrush}" />
                            <TextBlock Text="Note: Windows automatically reclaims and reallocates cached memory as needed by active applications."
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            AutomationProperties.Name="Close memory optimizer"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.CloseCommand, Mode=OneTime}">
                        <FontIcon Glyph="&#xE8BB;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="12"
                                  Foreground="{StaticResource TextMediumBrush}" />
                    </Button>
                </Grid>

                <!-- 1. Telemetry strip -->
                <Grid Margin="0,0,0,12" ColumnDefinitions="*,*,*">
                    <Border Grid.Column="0" Margin="0,0,6,0"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource HairlineBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="TOTAL PHYSICAL RAM" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalRamText, Mode=OneWay}"
                                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextHighBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="{x:Bind ViewModel.UsedRamText, Mode=OneWay}"
                                       FontSize="10.5" Foreground="{StaticResource ElectricCyanBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="3,0,3,0"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource HairlineBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="RECLAIMABLE STANDBY CACHE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.StandbyCacheText, Mode=OneWay}"
                                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SuccessGlowBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="Cached inactive pages" FontSize="10.5" Foreground="{StaticResource SuccessGlowBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="6,0,0,0"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource HairlineBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="KERNEL ISOLATION SHIELD" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="100% IMMUNE" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextHighBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="Windows, Explorer &amp; Security protected" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Selection toolbar -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Select All"
                                Background="{StaticResource PillButtonBgBrush}"
                                BorderBrush="{StaticResource PillButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="8,3"
                                FontSize="10"
                                Margin="0,0,6,0"
                                Command="{x:Bind ViewModel.SelectAllCommand, Mode=OneTime}" />
                        <Button Content="Deselect All"
                                Background="{StaticResource PillButtonBgBrush}"
                                BorderBrush="{StaticResource PillButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="8,3"
                                FontSize="10"
                                Command="{x:Bind ViewModel.DeselectAllCommand, Mode=OneTime}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 3. Zone list -->
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,6"
                        Margin="0,0,0,12"
                        MinHeight="140">
                    <ListView ItemsSource="{x:Bind ViewModel.Zones, Mode=OneWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:MemoryZoneRowViewModel">
                                <Border Background="{StaticResource SurfaceCardBrush}"
                                        BorderBrush="{StaticResource HairlineBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />

                                        <Border Grid.Column="1"
                                                Width="32" Height="32"
                                                CornerRadius="8"
                                                Background="{StaticResource SurfaceSubCardBrush}"
                                                BorderBrush="{StaticResource ElectricCyanBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneTime}"
                                                      FontFamily="{StaticResource IconFont}"
                                                      FontSize="13"
                                                      Foreground="{StaticResource ElectricCyanBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextHighBrush}" />
                                            <TextBlock Text="{x:Bind Description, Mode=OneTime}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left"
                                                       MaxWidth="360"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="3"
                                                Background="{StaticResource SurfaceSubCardBrush}"
                                                BorderBrush="{StaticResource HairlineBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="7,2"
                                                Margin="8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SafetyBadge, Mode=OneTime}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ElectricCyanBrush}" />
                                        </Border>

                                        <Border Grid.Column="4"
                                                Background="{StaticResource SurfaceSubCardBrush}"
                                                BorderBrush="{StaticResource HairlineBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                MinWidth="70">
                                            <TextBlock Text="{x:Bind FormattedCurrent, Mode=OneTime}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextHighBrush}"
                                                       HorizontalAlignment="Right" />
                                        </Border>

                                        <Button Grid.Column="5"
                                                Content="Flush"
                                                Background="{StaticResource PillButtonBgBrush}"
                                                BorderBrush="{StaticResource PillButtonBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="10,4"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"
                                                Command="{x:Bind FlushCommand, Mode=OneTime}"
                                                CommandParameter="{x:Bind}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- 4. Footer actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Quick Trim Working Sets"
                            Background="{StaticResource PillButtonBgBrush}"
                            BorderBrush="{StaticResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Padding="14,6"
                            FontSize="11"
                            Command="{x:Bind ViewModel.QuickTrimCommand, Mode=OneTime}" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Purge Selected Zones"
                                Background="{StaticResource ElectricCyanBrush}"
                                Foreground="{StaticResource HeroActionBtnTextBrush}"
                                BorderThickness="0"
                                CornerRadius="14"
                                Padding="18,7"
                                FontSize="11.5"
                                Margin="0,0,8,0"
                                Command="{x:Bind ViewModel.PurgeSelectedCommand, Mode=OneTime}" />
                        <Button Content="Close"
                                Background="{StaticResource PillButtonBgBrush}"
                                BorderBrush="{StaticResource PillButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,7"
                                FontSize="11"
                                Command="{x:Bind ViewModel.CloseCommand, Mode=OneTime}" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>