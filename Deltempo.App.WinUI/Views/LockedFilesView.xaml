<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of Views/Modals/LockedFilesModal.xaml (239 lines).
    Layout is 1:1: header, summary bar with bulk action, file list, footer actions.

    Differences forced by the framework:
      - The two WPF MessageBox calls become ContentDialog (WinUI has no MessageBox).
      - The per-row button binds to a row-level command instead of a Click handler
        reading Button.DataContext.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.LockedFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Deltempo.App.WinUI.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="600">

    <Grid Background="Transparent">
        <Border Margin="24,14,24,14"
                Background="{StaticResource SurfaceSubCardBrush}"
                BorderBrush="{StaticResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22,18">

            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- 0. Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="{StaticResource SurfaceSubCardBrush}"
                                BorderBrush="{StaticResource AmberWarningBrush}"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE7BA;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="18"
                                      Foreground="{StaticResource AmberWarningBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="In-Use &amp; Locked Files Inspector"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextHighBrush}" />
                            <TextBlock Text="Files held open by active running applications during cleanup"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextMediumBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            AutomationProperties.Name="Close locked files inspector"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.CloseCommand, Mode=OneTime}">
                        <FontIcon Glyph="&#xE8BB;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="12"
                                  Foreground="{StaticResource TextMediumBrush}" />
                    </Button>
                </Grid>

                <!-- 1. Summary bar + bulk schedule action -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextHighBrush}" />
                            <TextBlock Text="You can close the locking application, or schedule files for automatic deletion on next reboot."
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                AutomationProperties.Name="Schedule all locked files for deletion on reboot"
                                ToolTipService.ToolTip="Registers all in-use files with Windows Session Manager (MoveFileEx) for deletion upon reboot"
                                Background="{StaticResource PillButtonBgBrush}"
                                BorderBrush="{StaticResource PillButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,6"
                                Command="{x:Bind ViewModel.ScheduleAllCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE777;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="11"
                                          Margin="0,0,5,0"
                                          Foreground="{StaticResource ElectricCyanBrush}" />
                                <TextBlock Text="Schedule All for Reboot Purge" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. File list -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,8"
                        Margin="0,0,0,12">
                    <ListView ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:LockedFileRowViewModel">
                                <Border Background="{StaticResource SurfaceCardBrush}"
                                        BorderBrush="{StaticResource HairlineBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                                        <Border Grid.Column="0"
                                                Width="36"
                                                Height="36"
                                                CornerRadius="8"
                                                Background="{StaticResource SurfaceSubCardBrush}"
                                                BorderBrush="{StaticResource HairlineBorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;"
                                                      FontFamily="{StaticResource IconFont}"
                                                      FontSize="14"
                                                      Foreground="{StaticResource AmberWarningBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FileName, Mode=OneTime}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextHighBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Left"
                                                           MaxWidth="380" />
                                                <Border Background="#FF2A1E16"
                                                        BorderBrush="{StaticResource AmberWarningBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="6,1.5"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="{x:Bind DisplayProcessInfo, Mode=OneTime}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AmberWarningBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind FilePath, Mode=OneTime}"
                                                       FontSize="10.5"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left"
                                                       MaxWidth="440"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{StaticResource SurfaceSubCardBrush}"
                                                BorderBrush="{StaticResource HairlineBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedSize, Mode=OneTime}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ElectricCyanBrush}" />
                                        </Border>

                                        <Border Grid.Column="3"
                                                Background="{StaticResource SurfaceSubCardBrush}"
                                                BorderBrush="{StaticResource HairlineBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextMediumBrush}" />
                                        </Border>

                                        <Button Grid.Column="4"
                                                AutomationProperties.Name="Schedule this file for deletion on reboot"
                                                Content="Schedule Reboot Delete"
                                                Background="{StaticResource PillButtonBgBrush}"
                                                BorderBrush="{StaticResource PillButtonBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="10,5"
                                                FontSize="10.5"
                                                VerticalAlignment="Center"
                                                Command="{x:Bind ScheduleCommand, Mode=OneTime}"
                                                CommandParameter="{x:Bind}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- 3. Footer -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.FooterNotice, Mode=OneWay}"
                               FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            AutomationProperties.Name="Close locked files inspector"
                            Content="Close"
                            Background="{StaticResource ElectricCyanBrush}"
                            Foreground="{StaticResource HeroActionBtnTextBrush}"
                            BorderThickness="0"
                            CornerRadius="14"
                            Padding="26,7.5"
                            FontSize="12"
                            Command="{x:Bind ViewModel.CloseCommand, Mode=OneTime}" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>