<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the memory hero card from MainWindow.xaml (lines ~838-925)
    plus MainWindow.Memory.cs.

    This is the first WORKSPACE panel rather than an overlay. The WPF version
    kept this card's six named controls (HeroRamPercentText, HeroRamDetailText,
    HeroRamProgressBar, HeroBoostRamBtn, HeroRamLabel, HeroRamBtnText) in sync
    from a hand-written PropertyChanged handler. Every property here is bound
    directly, so there is no named-control list to maintain.

    The detailed memory manager stays an overlay, opened by
    OpenDetailedViewCommand, mirroring the WPF hero's jump button.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.MemoryWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Deltempo.App.WinUI.Converters"
    mc:Ignorable="d"
    d:DesignWidth="900"
    d:DesignHeight="420">

    <UserControl.Resources>
        <!-- NotBool, not a Visibility converter: IsEnabled needs a bool and WinUI 3
         throws if handed one. -->
        <converters:BoolNegationConverter x:Key="NotBool" />
    </UserControl.Resources>

    <!-- Transparent, not a fill of its own: the shell paints the one canvas scrim over
         the Mica backdrop, and a second copy here would make the content darker than the
         navigation pane. ShowWorkspace collapses what this panel would otherwise reveal. -->
    <Grid Padding="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Telemetry card -->
        <Border Grid.Row="0"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="13"
                Padding="14,10"
                AutomationProperties.Name="System Memory RAM Telemetry">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE950;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="12"
                                  Foreground="{ThemeResource ElectricCyanBrush}"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="RAM Memory"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextHighBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.UsedPercentText, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource ElectricCyanBrush}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />

                        <Button Background="{ThemeResource PillButtonBgBrush}"
                                BorderBrush="{ThemeResource PillButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,3"
                                ToolTipService.ToolTip="Open the detailed kernel memory and standby cache manager"
                                Command="{x:Bind ViewModel.OpenDetailedViewCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE950;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="10.5"
                                          Foreground="{ThemeResource ElectricCyanBrush}"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Memory Manager"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource ElectricCyanBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{x:Bind ViewModel.UsedPercent, Mode=OneWay}"
                             Height="6"
                             Foreground="{ThemeResource ElectricCyanBrush}"
                             Background="{ThemeResource TrackBgBrush}"
                             BorderThickness="0"
                             Margin="0,0,0,6" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.RamDetailText, Mode=OneWay}"
                               FontSize="10.5"
                               Foreground="{ThemeResource TextMediumBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />

                    <!-- Boost issues privileged NT memory operations, so the
                         help text states plainly that it is not a speed boost. -->
                    <Button Grid.Column="1"
                            Content="{x:Bind ViewModel.BoostButtonText, Mode=OneWay}"
                            AutomationProperties.Name="Trim memory (cache eviction)"
                            AutomationProperties.HelpText="Trims working sets and discards cached pages. This raises available memory but is not a speed boost - evicted pages are re-read from disk on demand."
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,4"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.IsBoosting, Mode=OneWay, Converter={StaticResource NotBool}}"
                            Click="OnBoostClick" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Standby + zone summary. The per-zone detail lives in the overlay. -->
        <Border Grid.Row="1"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="13"
                Padding="18,16"
                Margin="0,12,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE9F9;"
                          FontFamily="{StaticResource IconFont}"
                          FontSize="34"
                          Foreground="{ThemeResource ElectricCyanBrush}"
                          HorizontalAlignment="Center" />

                <TextBlock Text="Memory Optimization"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextHighBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />

                <TextBlock Text="Trim working sets, evict the standby cache, and reclaim locked or standby-only pages."
                           FontSize="11.5"
                           Foreground="{ThemeResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="460"
                           Margin="0,6,0,14" />

                <Button Content="Open Memory Manager"
                        Background="{StaticResource DestructiveRedBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="14"
                        Padding="18,7"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.OpenDetailedViewCommand, Mode=OneTime}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>