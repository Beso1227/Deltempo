<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the Large File Hunter workspace from MainWindow.LargeFiles.cs
    (~600 lines of named-control, null-checked WPF code-behind).

    Drive scan, deterministic safety verdicts, per-file selection and
    Recycle Bin recycling. The scan is read-only; recycling is gated behind an
    injected confirmation that defaults to refusing.

    The list/treemap view mode toggle and per-row checkboxes replace the WPF
    named CheckBoxes, ComboBoxes and Treemap Canvas with bound data.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.LargeFilesWorkspaceView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Deltempo.App.WinUI.Converters"
    xmlns:services="using:WinTempCleaner.Services"
    mc:Ignorable="d"
    d:DesignWidth="1000"
    d:DesignHeight="640">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolNegationConverter x:Key="NotBool" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <Style x:Key="LargeFileChip" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{StaticResource TextMediumBrush}" />
            <Setter Property="Background" Value="{StaticResource PillButtonBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PillButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <DataTemplate x:Key="LargeFileRowTemplate" x:DataType="services:LargeFileInfo">
            <Border
                Background="{StaticResource SurfaceSubCardBrush}"
                BorderBrush="{StaticResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <CheckBox
                            IsChecked="{Binding IsSelected, Mode=OneWay}"
                            Checked="OnItemChecked"
                            Unchecked="OnItemUnchecked"
                            AutomationProperties.Name="{Binding FileName}" />
                        <FontIcon
                            Glyph="{Binding CategoryIcon}"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="14"
                            Foreground="{StaticResource TextMutedBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding FileName}"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextHighBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="260"
                            VerticalAlignment="Center" />
                        <Border
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource HairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,1.5">
                            <TextBlock
                                Text="{Binding Category}"
                                FontSize="10"
                                Foreground="{StaticResource TextMutedBrush}"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Text="{Binding FormattedSize}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{Binding BadgeColor, Converter={StaticResource HexToBrush}}"
                            VerticalAlignment="Center" />
                        <Border
                            Background="{Binding BadgeBackground, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{Binding BadgeBorder, Converter={StaticResource HexToBrush}}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,1.5"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding VerdictShort}"
                                FontSize="9.5"
                                FontWeight="SemiBold"
                                Foreground="{Binding BadgeColor, Converter={StaticResource HexToBrush}}"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Text="{Binding FormattedDate}"
                            FontSize="10"
                            Foreground="{StaticResource TextMutedBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="150"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <Button
                            Content="Reveal"
                            Background="{StaticResource PillButtonBgBrush}"
                            BorderBrush="{StaticResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Command="{Binding DataContext.ViewModel.RevealCommand, ElementName=Root}"
                            CommandParameter="{Binding}" />
                        <Button
                            Content="Recycle"
                            ToolTipService.ToolTip="Move this file to the Windows Recycle Bin."
                            Background="{StaticResource DestructiveRedBrush}"
                            BorderBrush="{StaticResource DestructiveRedBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            FontSize="11"
                            IsEnabled="{Binding IsSafe, Mode=OneWay}"
                            Command="{Binding DataContext.ViewModel.RecycleItemCommand, ElementName=Root}"
                            CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Opaque background: a transparent panel lets the nav rail bleed through. -->
    <Grid Padding="18,16" Background="{StaticResource CanvasDarkBrush}" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Hero stats + actions -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Total storage" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalStorageText, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextHighBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Safe to clean" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SafeStorageText, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrightBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Protected" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ProtectedStorageText, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource RoseErrorBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <Button
                    Content="Scan Now"
                    Background="{StaticResource PillButtonBgBrush}"
                    BorderBrush="{StaticResource PillButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,6"
                    FontSize="11.5"
                    Margin="0,0,8,0"
                    IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotBool}}"
                    Command="{x:Bind ViewModel.ScanCommand, Mode=OneTime}" />

                <Button
                    Content="Recycle Selected"
                    Background="{StaticResource DestructiveRedBrush}"
                    BorderThickness="0"
                    CornerRadius="14"
                    Padding="14,6"
                    FontSize="11.5"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource NotBool}}"
                    Command="{x:Bind ViewModel.RecycleSelectedCommand, Mode=OneTime}" />
            </StackPanel>
        </Grid>

        <!-- Filter chips + view mode -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,12,0,10" VerticalAlignment="Center">
            <TextBlock Text="Scope:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <RadioButton GroupName="LargeFileScope" Content="All Drives" Style="{StaticResource LargeFileChip}" Tag="ALL" Checked="OnScopeChanged" />
            <RadioButton GroupName="LargeFileScope" Content="User Profile" Style="{StaticResource LargeFileChip}" Tag="USER" Checked="OnScopeChanged" />

            <TextBlock Text="Min size:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
            <RadioButton GroupName="LargeFileSize" Content="50 MB" Style="{StaticResource LargeFileChip}" Tag="50MB" IsChecked="True" Checked="OnSizeChanged" />
            <RadioButton GroupName="LargeFileSize" Content="100 MB" Style="{StaticResource LargeFileChip}" Tag="100MB" Checked="OnSizeChanged" />

            <TextBlock Text="View:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
            <RadioButton GroupName="LargeFileView" Content="List" Style="{StaticResource LargeFileChip}" Tag="LIST" IsChecked="True" Checked="OnViewModeChanged" />
            <RadioButton GroupName="LargeFileView" Content="Treemap" Style="{StaticResource LargeFileChip}" Tag="TREEMAP" Checked="OnViewModeChanged" />
        </StackPanel>

        <!-- Content: list or treemap -->
        <Grid Grid.Row="2">
            <ListView
                x:Name="LargeFilesList"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                SelectionMode="None"
                HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <StaticResource ResourceKey="LargeFileRowTemplate" />
                </ListView.ItemTemplate>
            </ListView>

            <Canvas
                x:Name="TreemapCanvas"
                Background="{StaticResource SurfaceCardBrush}"
                Visibility="Collapsed"
                SizeChanged="OnTreemapSizeChanged" />
        </Grid>

        <!-- Empty state -->
        <Border
            Grid.Row="2"
            Background="{StaticResource SurfaceCardBrush}"
            BorderBrush="{StaticResource HairlineBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource NotBool}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="No large files found"
                           FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextHighBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Scan your drives to see large files. Safe-to-clean files are marked with a green badge."
                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" MaxWidth="460" />
            </StackPanel>
        </Border>

        <!-- Selection summary + actions -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource HairlineBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource NotBool}}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.SelectedSummaryText, Mode=OneWay}"
                           FontSize="11" Foreground="{StaticResource TextMediumBrush}" VerticalAlignment="Center" />
                <Button
                    Content="Select Safe"
                    Background="{StaticResource PillButtonBgBrush}"
                    BorderBrush="{StaticResource PillButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,4"
                    FontSize="11"
                    Command="{x:Bind ViewModel.SelectSafeCommand, Mode=OneTime}" />
                <Button
                    Content="Select All"
                    Background="{StaticResource PillButtonBgBrush}"
                    BorderBrush="{StaticResource PillButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,4"
                    FontSize="11"
                    Command="{x:Bind ViewModel.SelectAllCommand, Mode=OneTime}" />
                <Button
                    Content="Clear"
                    Background="{StaticResource PillButtonBgBrush}"
                    BorderBrush="{StaticResource PillButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,4"
                    FontSize="11"
                    Command="{x:Bind ViewModel.ClearSelectionCommand, Mode=OneTime}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
