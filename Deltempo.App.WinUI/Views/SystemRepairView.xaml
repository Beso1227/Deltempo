<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of Views/Modals/SystemRepairModal.xaml (1054 lines).

    This is the most safety-critical surface in the app: every tool behind it is
    a privileged, mutating system operation (DISM RestoreHealth, SFC, WinSxS
    cleanup, CHKDSK, Windows Update reset, Winsock reset).

    Two structural rules the layout enforces, because they are safety rules and
    not styling:

      - Every repair button's IsEnabled binds to ViewModel.CanRunTools, which is
        simply !IsRunning. In the WPF version each of the nine buttons set its
        own IsEnabled imperatively, so a tenth tool could easily forget. Here
        they all read one flag that the re-entrancy lock owns.
      - The cancel button binds to CanCancel, which is IsRunning. It is
        therefore impossible to show an idle screen with no way to stop a run.

    Status colours arrive as hex from the ViewModel (SubsystemRowViewModel and
    RemediationVerdictViewModel) rather than being resolved here, because the
    WPF version scattered BrushConverter calls through its code-behind and the
    green/red rule should live in exactly one place.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.SystemRepairView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Deltempo.App.WinUI.Converters"
    xmlns:viewmodels="using:Deltempo.App.WinUI.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="1100"
    d:DesignHeight="820">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
        <!-- IsEnabled needs a bool; a Visibility converter throws in WinUI 3. -->
        <converters:BoolNegationConverter x:Key="NotBool" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Margin="24,14,24,14"
                Background="{ThemeResource SurfaceSubCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20,16">

            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- ============================ HEADER ============================ -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="{ThemeResource SurfaceCardBrush}"
                                BorderBrush="{ThemeResource ElectricCyanBrush}"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE90F;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="18"
                                      Foreground="{ThemeResource ElectricCyanBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="System Repair &amp; Health Console"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextHighBrush}" />
                            <TextBlock Text="Diagnose and repair Windows integrity, component store, filesystem, and networking"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextMediumBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Elevation badge: colour follows IsAdministrator from the
                         ViewModel so it cannot disagree with the banner. -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource SurfaceCardBrush}"
                            BorderBrush="{ThemeResource ElectricCyanBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsAdministrator, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Bind ViewModel.ElevationBadgeText, Mode=OneWay}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource ElectricCyanBrush}" />
                    </Border>

                    <!-- Standard-user badge. Both badges read one flag, so the
                         shell can never claim elevation it does not have. -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource WarningBadgeBgBrush}"
                            BorderBrush="{ThemeResource WarningBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.NeedsElevation, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Bind ViewModel.ElevationBadgeText, Mode=OneWay}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource WarningBadgeTextBrush}" />
                    </Border>

                    <Button Grid.Column="2"
                            Content="Copy Log"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,5"
                            FontSize="11"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.CopyLogCommand, Mode=OneTime}" />

                    <Button Grid.Column="3"
                            AutomationProperties.Name="Close system repair console"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.CloseCommand, Mode=OneTime}">
                        <FontIcon Glyph="&#xE8BB;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextMediumBrush}" />
                    </Button>
                </Grid>

                <!-- ============ ELEVATION BANNER + HERO ACTIONS + PROGRESS ============ -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">

                    <!-- Non-admin users see this instead of silently failing mid-operation. -->
                    <Border Background="{ThemeResource WarningBadgeBgBrush}"
                            BorderBrush="{ThemeResource WarningBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="0,0,0,10"
                            Visibility="{x:Bind ViewModel.NeedsElevation, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE7BA;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="13"
                                      Foreground="{ThemeResource WarningBadgeTextBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />

                            <TextBlock Grid.Column="1"
                                       Text="Repair tools need Administrator. Deltempo is running unprivileged, so DISM, SFC, CHKDSK, and the stack resets will fail or be incomplete."
                                       FontSize="11"
                                       Foreground="{ThemeResource WarningBadgeTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="2"
                                    Content="Restart as Administrator"
                                    Background="{StaticResource DestructiveRedBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    CornerRadius="12"
                                    Padding="14,5"
                                    FontSize="11"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.ElevateCommand, Mode=OneTime}" />
                        </Grid>
                    </Border>

                    <!-- Hero actions + live progress -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                AutomationProperties.Name="Run quick integrity assessment"
                                ToolTipService.ToolTip="Read-only 4-point check of the component store, system files, filesystem, and servicing stack."
                                Background="{ThemeResource SurfaceCardBrush}"
                                BorderBrush="{ThemeResource ElectricCyanBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,7"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="0,0,8,0"
                                IsEnabled="{x:Bind ViewModel.CanRunTools, Mode=OneWay}"
                                Command="{x:Bind ViewModel.QuickAssessmentCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9D9;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="12"
                                          Foreground="{ThemeResource ElectricCyanBrush}"
                                          Margin="0,0,6,0" />
                                <TextBlock Text="Quick Assessment" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                AutomationProperties.Name="Run autonomous system repair"
                                ToolTipService.ToolTip="Runs DISM, SFC, and filesystem verification and restores anything it finds corrupted."
                                Background="{StaticResource DestructiveRedBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="14"
                                Padding="18,7"
                                FontSize="12"
                                FontWeight="SemiBold"
                                IsEnabled="{x:Bind ViewModel.CanRunTools, Mode=OneWay}"
                                Command="{x:Bind ViewModel.AutonomousRepairCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="12"
                                          Margin="0,0,6,0" />
                                <TextBlock Text="Autonomous Repair" />
                            </StackPanel>
                        </Button>

                        <Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressBar Grid.Column="0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                                         Height="6"
                                         VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource ElectricCyanBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,10,0" />

                            <Button Grid.Column="2"
                                    Content="Cancel"
                                    ToolTipService.ToolTip="Stop the running repair. Interrupting DISM or CHKDSK can leave Windows needing further repair."
                                    Background="{ThemeResource PillButtonBgBrush}"
                                    BorderBrush="{StaticResource DestructiveRedBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,5"
                                    FontSize="11"
                                    IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CancelCommand, Mode=OneTime}" />
                        </Grid>
                    </Grid>
                </StackPanel>

                <!-- BODY: TOOLS | TERMINAL | RESTORE POINTS -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">

                    <!-- Tool column -->
                    <StackPanel Grid.Column="0" Width="250" Margin="0,0,12,0">

                        <TextBlock Text="REPAIR TOOLS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   Margin="0,0,0,6" />

                        <Button Content="System File Checker (SFC)"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="{ThemeResource SurfaceCardBrush}"
                                BorderBrush="{ThemeResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                FontSize="11.5"
                                Margin="0,0,0,6"
                                IsEnabled="{x:Bind ViewModel.CanRunTools, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SfcCommand, Mode=OneTime}" />

                        <Button Content="DISM RestoreHealth"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="{ThemeResource SurfaceCardBrush}"
                                BorderBrush="{ThemeResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                FontSize="11.5"
                                Margin="0,0,0,6"
                                IsEnabled="{x:Bind ViewModel.CanRunTools, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DismCommand, Mode=OneTime}" />

                        <Button Content="WinSxS Component Cleanup"
                                ToolTipService.ToolTip="Scavenges superseded component versions. Reclaims disk but cannot be undone."
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="{ThemeResource SurfaceCardBrush}"
                                BorderBrush="{ThemeResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                FontSize="11.5"
                                Margin="0,0,0,6"
                                IsEnabled="{x:Bind ViewModel.CanRunTools, Mode=OneWay}"
                                Command="{x:Bind ViewModel.WinSxSCommand, Mode=OneTime}" />

                        <Button Content="Filesystem Integrity (CHKDSK C:)"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="{ThemeResource SurfaceCardBrush}"
                                BorderBrush="{ThemeResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                FontSize="11.5"
                                Margin="0,0,0,6"
                                IsEnabled="{x:Bind ViewModel.CanRunTools, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ChkdskCommand, Mode=OneTime}" />

                        <Button Content="Windows Update Stack Reset"
                                ToolTipService.ToolTip="Stops update services, renames the SoftwareDistribution cache, and restarts them."
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="{ThemeResource SurfaceCardBrush}"
                                BorderBrush="{ThemeResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                FontSize="11.5"
                                Margin="0,0,0,6"
                                IsEnabled="{x:Bind ViewModel.CanRunTools, Mode=OneWay}"
                                Command="{x:Bind ViewModel.UpdateResetCommand, Mode=OneTime}" />

                        <Button Content="Network &amp; Winsock Reset"
                                ToolTipService.ToolTip="Resets the Winsock catalog. Usually requires a reboot afterwards."
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="{ThemeResource SurfaceCardBrush}"
                                BorderBrush="{ThemeResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                FontSize="11.5"
                                Margin="0,0,0,10"
                                IsEnabled="{x:Bind ViewModel.CanRunTools, Mode=OneWay}"
                                Command="{x:Bind ViewModel.NetworkResetCommand, Mode=OneTime}" />

                        <Button Content="Launch CTT WinUtil"
                                ToolTipService.ToolTip="Opens the Chris Titus Tech Windows Utility in an elevated PowerShell window."
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="{ThemeResource PillButtonBgBrush}"
                                BorderBrush="{ThemeResource PillButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                FontSize="11.5"
                                Margin="0,0,0,10"
                                Command="{x:Bind ViewModel.LaunchWinUtilCommand, Mode=OneTime}" />

                        <Border Background="{ThemeResource SurfaceCardBrush}"
                                BorderBrush="{ThemeResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="SUBSYSTEM HEALTH"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextMutedBrush}"
                                           Margin="0,0,0,8" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.Subsystems, Mode=OneTime}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:SubsystemRowViewModel">
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0"
                                                         Width="7"
                                                         Height="7"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{x:Bind IndicatorHex, Mode=OneWay, Converter={StaticResource HexToBrush}}" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextHighBrush}" />
                                                    <TextBlock Text="{x:Bind Details, Mode=OneWay}"
                                                               FontSize="10"
                                                               Foreground="{x:Bind IndicatorHex, Mode=OneWay, Converter={StaticResource HexToBrush}}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1"
                                        Background="{ThemeResource HairlineBorderBrush}"
                                        Margin="0,6,0,8" />

                                <TextBlock Text="{x:Bind ViewModel.OverallRatingText, Mode=OneWay}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.OverallRatingHex, Mode=OneWay, Converter={StaticResource HexToBrush}}"
                                           TextWrapping="Wrap" />

                                <!-- Verdict card: colours arrive from the ViewModel so the
                                     green/red rule lives in one place. -->
                                <Border Background="{x:Bind ViewModel.Verdict.BackgroundHex, Mode=OneWay, Converter={StaticResource HexToBrush}}"
                                        BorderBrush="{x:Bind ViewModel.Verdict.BorderHex, Mode=OneWay, Converter={StaticResource HexToBrush}}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,8"
                                        Margin="0,8,0,0"
                                        Visibility="{x:Bind ViewModel.IsVerdictVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Glyph="{x:Bind ViewModel.Verdict.Glyph, Mode=OneWay}"
                                                      FontFamily="{StaticResource IconFont}"
                                                      FontSize="13"
                                                      Foreground="{x:Bind ViewModel.Verdict.AccentHex, Mode=OneWay, Converter={StaticResource HexToBrush}}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,7,0" />
                                            <TextBlock Text="{x:Bind ViewModel.Verdict.Title, Mode=OneWay}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{x:Bind ViewModel.Verdict.AccentHex, Mode=OneWay, Converter={StaticResource HexToBrush}}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.Verdict.Details, Mode=OneWay}"
                                                   Margin="0,5,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource TextMediumBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Terminal -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource HeaderDockBrush}"
                            BorderBrush="{ThemeResource HairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8"
                            Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="TERMINAL OUTPUT"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextMutedBrush}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Content="Clear"
                                        Background="{ThemeResource PillButtonBgBrush}"
                                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10,3"
                                        FontSize="10.5"
                                        Command="{x:Bind ViewModel.ClearLogCommand, Mode=OneTime}" />
                            </Grid>

                            <!-- IsReadOnly: the transcript is an output, not an input. -->
                            <TextBox Grid.Row="1"
                                     x:Name="TerminalBox"
                                     Text="{x:Bind ViewModel.TerminalText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="10.5"
                                     Foreground="{ThemeResource ElectricCyanBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Top" />
                        </Grid>
                    </Border>

                    <!-- Restore points -->
                    <Border Grid.Column="2"
                            Width="230"
                            Background="{ThemeResource SurfaceCardBrush}"
                            BorderBrush="{ThemeResource HairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,10">
                        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                            <TextBlock Grid.Row="0"
                                       Text="RESTORE POINTS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextMutedBrush}" />

                            <TextBlock Grid.Row="1"
                                       Text="{x:Bind ViewModel.RestorePointsBadgeText, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource ElectricCyanBrush}"
                                       Margin="0,2,0,4" />

                            <TextBlock Grid.Row="2"
                                       Text="{x:Bind ViewModel.RestorePointsSummaryText, Mode=OneWay}"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       TextWrapping="Wrap" />

                            <ListView Grid.Row="3"
                                      ItemsSource="{x:Bind ViewModel.RestorePoints, Mode=OneWay}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      SelectionMode="None"
                                      Margin="0,8,0,0"
                                      Visibility="{x:Bind ViewModel.HasRestorePoints, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="10.5"
                                                       Foreground="{ThemeResource TextHighBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="9.5"
                                                       Foreground="{ThemeResource TextMutedBrush}">
                                                <Run Text="{Binding FormattedTime, Mode=OneWay}" />
                                                <Run Text=" - seq " />
                                                <Run Text="{Binding SequenceNumber, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                                <Button Content="Refresh"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource PillButtonBgBrush}"
                                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        FontSize="11"
                                        Margin="0,0,0,6"
                                        IsEnabled="{x:Bind ViewModel.IsLoadingRestorePoints, Mode=OneWay, Converter={StaticResource NotBool}}"
                                        Command="{x:Bind ViewModel.RefreshRestorePointsCommand, Mode=OneTime}" />

                                <!-- Prune only unlocks with more than one snapshot, so
                                     there is always a restore point left behind. -->
                                <Button Content="Prune Older"
                                        HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="Purges older VSS snapshots while keeping the newest one intact."
                                        Background="{ThemeResource PillButtonBgBrush}"
                                        BorderBrush="{ThemeResource WarningBadgeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        FontSize="11"
                                        IsEnabled="{x:Bind ViewModel.CanPruneRestorePoints, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.PruneRestorePointsCommand, Mode=OneTime}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================== FOOTER ============================== -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="1"
                            Content="Close"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18,6"
                            FontSize="11.5"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.CloseCommand, Mode=OneTime}" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>