<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- xunit.v3 runs on Microsoft.Testing.Platform (MTP) rather than VSTest.
         OutputType Exe is required by MTP, and this flag keeps `dotnet test` working
         as a translation layer so the existing CI command line does not change. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- TreatWarningsAsErrors stays ON globally (Directory.Build.props), so any new
         diagnostic would otherwise break the build. These are demoted to visible warnings
         rather than silently ignored, and each is a deliberate call:

         xUnit1051 - v3 asks every CancellationToken-taking call to pass
                    TestContext.Current.CancellationToken. That is a cancellation-
                    responsiveness preference, not a correctness rule, and threading it
                    through the safety-critical suite is a separate, testable change.
                    Surfaced in the build log; not fatal. This is the ONLY non-fatal
                    diagnostic in the repository - every other warning is still an error.
                    NOTE: several sites (notably the cancellation-path tests) must supply
                    their own token rather than TestContext's, so a clean sweep of this
                    rule is not a mechanical change and must not be attempted casually. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);xUnit1051</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only: BLAKE3 vs SHA-256 comparison benchmark (Category=Benchmark, excluded from CI). -->
    <PackageReference Include="Blake3" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Provides the MTP coverage option used by CI to emit coverage.cobertura.xml. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- xunit.v3 replaces xunit 2.x + xunit.runner.visualstudio: the analysers, assert
         library and runner all ship in this single package. -->
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Deltempo.Core\Deltempo.Core.csproj" />
    <Compile Include="..\..\src\Deltempo.App.Wpf\Converters\PercentWidthConverter.cs" Link="Converters\PercentWidthConverter.cs" />
    <Compile Include="..\..\src\Deltempo.App.Wpf\Converters\ShareWidthConverter.cs" Link="Converters\ShareWidthConverter.cs" />
    <Compile Include="..\..\src\Deltempo.App.Wpf\Converters\SubtractConverter.cs" Link="Converters\SubtractConverter.cs" />
    <Compile Include="..\..\src\Deltempo.App.Wpf\Converters\WidthConverters.cs" Link="Converters\WidthConverters.cs" />

    <!-- The WinUI 3 shell's ViewModels are referenced, not linked.

         They are compiled by src/Deltempo.App.WinUI.ViewModels into their own
         assembly, which the WinUI app also references. Referencing rather than
         linking matters for the coverage gate: the coverage collector excludes
         the test assembly, so ViewModels linked into it would be executed by
         every test and never reported - tested but unmeasured.

         Every ViewModel is deliberately framework-free: each takes its
         dependencies (the confirmation host, the path picker, the folder opener)
         through its constructor and DEFAULTS TO REFUSING, which is what makes
         them testable at all. SystemRepairViewModel was the last one holding a
         direct Microsoft.UI.Dispatching reference; it now goes through the
         shared UiDispatcher abstraction like every other service, which also
         removes a fire-and-forget race the abstraction was written to avoid. -->
    <ProjectReference Include="..\..\src\Deltempo.App.WinUI.ViewModels\Deltempo.App.WinUI.ViewModels.csproj" />
  </ItemGroup>

</Project>
