<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Deltempo</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>Deltempo - Windows Cleaner and Memory Optimizer</ApplicationTitle>
    <!-- Version/FileVersion/AssemblyVersion are centralized in Directory.Build.props -->
    <NeutralLanguage>en-US</NeutralLanguage>
    <RepositoryUrl>https://github.com/Beso1227/Deltempo</RepositoryUrl>
    <PackageProjectUrl>https://beso1227.github.io/Deltempo/</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Beso1227</Authors>
    <Company>Deltempo Open Source Project</Company>
    <Product>Deltempo Windows Cleaner</Product>
    <Description>Open source Windows cache cleaner and memory optimizer with zero telemetry.</Description>
    <Copyright>Copyright (c) 2026 Beso1227 / Deltempo Project. MIT Licensed.</Copyright>
    <Title>Deltempo</Title>
    <Publisher>Beso1227</Publisher>

    <!-- Target RIDs for self-contained single-file publishing -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Compile Remove="Cli\**" />
    <EmbeddedResource Remove="Cli\**" />
    <None Remove="Cli\**" />
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Compile Remove="Core\**" />
    <EmbeddedResource Remove="Core\**" />
    <None Remove="Core\**" />
    <Compile Remove="Services\**" />
    <EmbeddedResource Remove="Services\**" />
    <None Remove="Services\**" />
    <Compile Remove="Models\**" />
    <EmbeddedResource Remove="Models\**" />
    <None Remove="Models\**" />
    <Compile Remove="ViewModels\**" />
    <EmbeddedResource Remove="ViewModels\**" />
    <None Remove="ViewModels\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\**\*.xaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\Deltempo.Core.csproj" />
  </ItemGroup>

</Project>
