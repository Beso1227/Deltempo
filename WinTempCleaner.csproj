<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Deltempo</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>Deltempo - Windows Cleaner and Memory Optimizer</ApplicationTitle>
    <!-- Version/FileVersion/AssemblyVersion are centralized in Directory.Build.props -->
    <NeutralLanguage>en-US</NeutralLanguage>
    <RepositoryUrl>https://github.com/Beso1227/Deltempo</RepositoryUrl>
    <PackageProjectUrl>https://beso1227.github.io/Deltempo/</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Beso1227</Authors>
    <Company>Deltempo Open Source Project</Company>
    <Product>Deltempo Windows Cleaner</Product>
    <Description>Open source Windows cache cleaner and memory optimizer with zero telemetry.</Description>
    <Copyright>Copyright (c) 2026 Beso1227 / Deltempo Project. MIT Licensed.</Copyright>
    <Title>Deltempo</Title>
    <Publisher>Beso1227</Publisher>

    <!-- Target RIDs for self-contained single-file publishing.
         win-x64 remains the primary/supported release target; win-arm64 is built
         alongside it so Windows-on-ARM devices get a native binary instead of
         falling back to x64 emulation. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- Nested projects. Each of these folders is its own project with its own
         root, and their sources must not be globbed into this one - otherwise the
         same types are compiled twice (CS0579 duplicate assembly attributes). -->
    <Compile Remove="src\**" />
    <EmbeddedResource Remove="src\**" />
    <None Remove="src\**" />
    <Compile Remove="Cli\**" />
    <EmbeddedResource Remove="Cli\**" />
    <None Remove="Cli\**" />
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <!-- The WinUI 3 shell is a separate project with its own project root; its XAML must
         not be globbed into this WPF project (Page items) or the two XAML stacks collide. -->
    <Compile Remove="Deltempo.App.WinUI\**" />
    <Page Remove="Deltempo.App.WinUI\**" />
    <ApplicationDefinition Remove="Deltempo.App.WinUI\**" />
    <EmbeddedResource Remove="Deltempo.App.WinUI\**" />
    <None Remove="Deltempo.App.WinUI\**" />
  </ItemGroup>

  <!--
    Interface sounds are embedded rather than shipped loose, so the single-file
    publish stays a single executable. LogicalName is set explicitly because the
    same four files are also embedded into Deltempo.Core.dll (which compiles
    Services\SoundService.cs too), and both copies must resolve the same name.
  -->
  <ItemGroup>
    <EmbeddedResource Include="src\Deltempo.Core\Assets\Sounds\click.wav">
      <LogicalName>WinTempCleaner.Assets.Sounds.click.wav</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="src\Deltempo.Core\Assets\Sounds\success.wav">
      <LogicalName>WinTempCleaner.Assets.Sounds.success.wav</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="src\Deltempo.Core\Assets\Sounds\error.wav">
      <LogicalName>WinTempCleaner.Assets.Sounds.error.wav</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="src\Deltempo.Core\Assets\Sounds\warning.wav">
      <LogicalName>WinTempCleaner.Assets.Sounds.warning.wav</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\**\*.xaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <Page Update="Views\Modals\LockedFilesModal.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Modals\ForceDeleteModal.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Deltempo.Core\Deltempo.Core.csproj" />
  </ItemGroup>

</Project>
