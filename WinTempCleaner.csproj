<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Deltempo</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>Deltempo - Pure Precision Windows Cleaner</ApplicationTitle>
    <Authors>Beso1227</Authors>
    <Company>Deltempo Open Source Project</Company>
    <Product>Deltempo Windows Cleaner</Product>
    <Description>Pure precision Windows temporary cache, GPU shader, AppData, and system cleaner with zero telemetry.</Description>
    <Copyright>Copyright © 2026 Beso1227 / Deltempo Project. MIT Licensed.</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <RepositoryUrl>https://github.com/Beso1227/Deltempo</RepositoryUrl>
    <PackageProjectUrl>https://beso1227.github.io/Deltempo/</PackageProjectUrl>
    
    <!-- Unified 100% Standalone Self-Contained Executable -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app_icon.png" />
    <Resource Include="app.ico" />
    <Compile Remove="Cli\**" />
    <EmbeddedResource Remove="Cli\**" />
    <None Remove="Cli\**" />
  </ItemGroup>

</Project>
