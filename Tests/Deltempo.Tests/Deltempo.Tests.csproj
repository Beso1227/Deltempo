<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- xunit.v3 runs on Microsoft.Testing.Platform (MTP) rather than VSTest.
         OutputType Exe is required by MTP, and this flag keeps `dotnet test` working
         as a translation layer so the existing CI command line does not change. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- TreatWarningsAsErrors stays ON globally (Directory.Build.props), so any new
         diagnostic would otherwise break the build. These are demoted to visible warnings
         rather than silently ignored, and each is a deliberate call:

         xUnit1051 - v3 asks every CancellationToken-taking call to pass
                    TestContext.Current.CancellationToken. That is a cancellation-
                    responsiveness preference for 67 test call sites, not a correctness
                    rule, and threading it through the safety-critical suite is a
                    separate, testable change. Surfaced in the build log; not fatal. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);xUnit1051</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only: BLAKE3 vs SHA-256 comparison benchmark (Category=Benchmark, excluded from CI). -->
    <PackageReference Include="Blake3" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Provides the MTP coverage option used by CI to emit coverage.cobertura.xml. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- xunit.v3 replaces xunit 2.x + xunit.runner.visualstudio: the analysers, assert
         library and runner all ship in this single package. -->
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Deltempo.Core.csproj" />
    <Compile Include="..\..\Converters\PercentWidthConverter.cs" Link="Converters\PercentWidthConverter.cs" />
    <Compile Include="..\..\Converters\SubtractConverter.cs" Link="Converters\SubtractConverter.cs" />
    <Compile Include="..\..\Converters\WidthConverters.cs" Link="Converters\WidthConverters.cs" />
  </ItemGroup>

</Project>
