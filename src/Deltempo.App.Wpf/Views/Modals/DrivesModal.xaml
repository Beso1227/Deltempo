<UserControl x:Class="WinTempCleaner.Views.Modals.DrivesModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="860">
    <Grid Background="Transparent">
        <Border Margin="24,14,24,14"
                Background="{DynamicResource DoubleBezelOuterBrush}"
                BorderBrush="{DynamicResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="2">
            <Border Background="{DynamicResource ModalSurfaceBrush}"
                    CornerRadius="14"
                    Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: header -->
                        <RowDefinition Height="Auto"/> <!-- 1: summary + data-source note -->
                        <RowDefinition Height="Auto"/> <!-- 2: live status -->
                        <RowDefinition Height="*"/>    <!-- 3: rows -->
                        <RowDefinition Height="Auto"/> <!-- 4: footer -->
                    </Grid.RowDefinitions>

                    <!-- 0. Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40"
                                    CornerRadius="12"
                                    Background="{DynamicResource SurfaceSubCardBrush}"
                                    BorderBrush="{DynamicResource ElectricCyanBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,12,0">
                                <TextBlock Text="&#xE7F4;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           Foreground="{DynamicResource ElectricCyanBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText"
                                           Text="Drives Health"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextHighBrush}"/>
                                <TextBlock x:Name="SubtitleText"
                                           Text="Every storage device connected to this PC"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{DynamicResource WindowCloseButton}"
                                Content="&#xE8BB;"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Close the drive report"
                                Click="Close_Click"/>
                    </Grid>

                    <!-- 1. Summary + honesty note about where the numbers come from -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceSubCardBrush}"
                            BorderBrush="{DynamicResource HairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="SummaryText"
                                       Text="Reading storage device health from the Windows Storage provider..."
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextHighBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SourceNoteText"
                                       Text="One row is one physical device: a disk with C: and D: is a single row, labelled with both letters. Health, model, media type and serial come from MSFT_Disk / MSFT_PhysicalDisk. Temperature, wear and power-on hours come from MSFT_StorageReliabilityCounter, which Windows only exposes to an elevated process - they read 'Not reported' rather than a guess when unavailable. The speed test writes one temporary file per device, reads it back with unbuffered I/O and deletes it."
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Status line -->
                    <TextBlock x:Name="StatusText"
                               Grid.Row="2"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="2,0,2,8"/>

                    <!-- 3. Rows: health template and speed template share the slot -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource SurfaceSubCardBrush}"
                            BorderBrush="{DynamicResource HairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,8"
                            Margin="0,0,0,12">
                        <Grid>
                            <ScrollViewer x:Name="HealthScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HealthItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceCardBrush}"
                                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextHighBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource TextMediumBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <Border Background="Transparent"
                                                                BorderBrush="{Binding StatusBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="7,2"
                                                                HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Status}"
                                                                       FontSize="10.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding StatusBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Metric1}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMediumBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Metric2}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMediumBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding Metric3}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMediumBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer x:Name="SpeedScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <ItemsControl x:Name="SpeedItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceCardBrush}"
                                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextHighBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource TextMediumBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,18,0">
                                                        <TextBlock Text="{Binding ReadSpeed}"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding StatusBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Text="sequential read"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="92">
                                                        <TextBlock Text="{Binding WriteSpeed}"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextHighBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Text="sequential write"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 4. Footer -->
                    <Grid Grid.Row="4">
                        <TextBlock x:Name="FooterText"
                                   Text="Health is read-only."
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,180,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ActionBtn"
                                    Content="Run Speed Test"
                                    Style="{DynamicResource PillButton}"
                                    Padding="14,6"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="Run the drive speed test"
                                    Click="Action_Click"/>
                            <Button x:Name="CloseBtn"
                                    Content="Close"
                                    Style="{DynamicResource PillButton}"
                                    Padding="14,6"
                                    FontSize="11"
                                    AutomationProperties.Name="Close the drive report"
                                    Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
