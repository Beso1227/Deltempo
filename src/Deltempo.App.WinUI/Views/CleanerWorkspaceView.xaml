<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the Cleaner workspace from MainWindow.Cleaning.cs (~726 lines
    of named-control, null-checked WPF code-behind).

    Scan target categories, review sizes/safety, select, confirm, and clean.
    The scan is read-only; cleaning is gated behind an injected confirmation
    that defaults to refusing.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.CleanerWorkspaceView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Deltempo.App.WinUI.Converters"
    xmlns:loc="using:Deltempo.App.WinUI.Localization"
    xmlns:models="using:WinTempCleaner.Models"
    mc:Ignorable="d"
    d:DesignWidth="1000"
    d:DesignHeight="640">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
        <!-- IsEnabled needs a bool; a Visibility converter throws in WinUI 3. -->
        <converters:BoolNegationConverter x:Key="NotBool" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource HairlineBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <!-- Shares the ported WPF chip template with the other filter rows. -->
        <Style x:Key="CleanerChip" TargetType="RadioButton" BasedOn="{StaticResource FilterChipRadio}" />

        <DataTemplate x:Key="TargetRowTemplate" x:DataType="models:TargetFolderInfo">
            <Border
                Background="{ThemeResource SurfaceSubCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,9">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <CheckBox
                        Grid.Column="0"
                        MinWidth="0"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding Name}" />

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextHighBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding Description}"
                            FontSize="10"
                            Foreground="{ThemeResource TextMutedBrush}"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Left"
                            MaxWidth="320" />

                        <!-- Why Clean reclaimed less than the scan total: bytes the
                             safety engine will not delete. Same line and wording as the
                             WPF card, and it is the only explanation a 0 B result has. -->
                        <TextBlock
                            Text="{Binding RetentionInfo}"
                            FontSize="10"
                            Foreground="{ThemeResource AmberWarningBrush}"
                            Margin="0,2,0,0"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Left"
                            MaxWidth="420"
                            ToolTipService.ToolTip="Bytes the safety engine will not delete: protected items, and executables or recent files held for manual review."
                            Visibility="{Binding HasRetentionInfo, Converter={StaticResource BoolToVis}}" />

                        <TextBlock
                            Text="{Binding ErrorMessage}"
                            FontSize="10"
                            Foreground="{ThemeResource RoseErrorBrush}"
                            Margin="0,3,0,0"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Left"
                            MaxWidth="420"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="6,1.5"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Category}"
                            FontSize="9.5"
                            Foreground="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="88">
                        <TextBlock
                            Text="{Binding FormattedSize}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextHighBrush}"
                            HorizontalAlignment="Right" />
                        <!-- WPF printed "1,204 files - 38 folders" under the size, which is
                             the difference between a big cache and a thousand tiny files. -->
                        <TextBlock
                            Text="{Binding FormattedStats}"
                            FontSize="9.5"
                            Foreground="{ThemeResource TextMutedBrush}"
                            HorizontalAlignment="Right"
                            Margin="0,1,0,0" />
                    </StackPanel>

                    <Border
                        Grid.Column="4"
                        Background="{Binding SafetyBadgeColor, Converter={StaticResource HexToBrush}}"
                        BorderBrush="{Binding SafetyBadgeColor, Converter={StaticResource HexToBrush}}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="6,1.5"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding SafetyBadge}"
                            FontSize="9.5"
                            Foreground="{ThemeResource TextHighBrush}"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- The per-category state ("Scanned", "Cleaned", "Retrying...") and
                         the Retry affordance. WPF showed the status line on every row and
                         the Repair button only when that row had actually failed; the port
                         showed a Retry button on rows that had never errored. -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock
                            Text="{Binding StatusMessage}"
                            FontSize="9.5"
                            Foreground="{ThemeResource TextMutedBrush}"
                            MaxWidth="140"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />

                        <!-- WPF's row inspect pill (InspectLargeFiles): peek at the top
                             files of a scanned category without cleaning anything. -->
                        <Button
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,3"
                            FontSize="10"
                            Margin="6,0,0,0"
                            AutomationProperties.Name="Inspect Large Files"
                            ToolTipService.ToolTip="Show the largest files found in this category"
                            Click="OnInspectTargetClick"
                            Visibility="{Binding HasTopFiles, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE721;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="10"
                                          Foreground="{ThemeResource ElectricCyanBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock loc:Loc.Key="Inspect" Text="Inspect" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Content="Retry"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{StaticResource DestructiveRedBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,3"
                            FontSize="10"
                            Margin="6,0,0,0"
                            AutomationProperties.Name="Retry this category"
                            Click="OnRowRetryClick"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Transparent, not a fill of its own. The shell window already paints the canvas
         scrim over the Mica backdrop, so a panel that painted it again would double the
         scrim and make the content column darker than the navigation pane. What this
         panel has to hide - the Stage 1 placeholder and the Core link card - is collapsed
         by ShowWorkspace instead. -->
    <Grid Padding="18,16" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Hero stats + actions. Two stacked rows, mirroring the WPF hero's left
             cluster: stat cards (now including the drive telemetry card) and the
             scrollable action strip below them. WPF scrolls the same strip because
             at the 800px minimum width the trailing actions would otherwise clip. -->
        <StackPanel Grid.Row="0" x:Name="CleanerHeader" Spacing="10">

            <StackPanel x:Name="CleanerHeaderStats" Orientation="Horizontal" Spacing="10">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock loc:Loc.Key="StatReclaimable" Text="Reclaimable" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.HeroSizeText, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource ElectricCyanBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock loc:Loc.Key="StatCategories" Text="Categories" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Targets.Count, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextHighBrush}" />
                    </StackPanel>
                </Border>

                <!-- Bytes this shell has freed since launch. Hidden until a run
                     actually freed something, like WPF's "Reclaimed X this session"
                     subtext which only appeared after the first clean. -->
                <Border Style="{StaticResource StatCard}"
                        Visibility="{x:Bind ViewModel.HasSessionFreed, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock loc:Loc.Key="StatSession" Text="This Session" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SessionFreedText, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource SuccessAccentBrush}" />
                    </StackPanel>
                </Border>

                <!-- Drive telemetry card: free percentage, used bar, details, S.M.A.R.T.
                     health pill and the read benchmark. Port of the WPF hero's drive
                     card; Speed Test is the one interactive piece. -->
                <Border Style="{StaticResource StatCard}" Width="252" Padding="12,8">
                    <StackPanel Spacing="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F4;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="11"
                                          Foreground="{ThemeResource AccentBlueBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DriveLabel, Mode=OneWay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextHighBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.DriveFreeText, Mode=OneWay}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{ThemeResource ElectricCyanBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ProgressBar
                            Minimum="0" Maximum="100"
                            Value="{x:Bind ViewModel.DriveUsedPercent, Mode=OneWay}"
                            Height="6"
                            Foreground="{ThemeResource ElectricCyanBrush}"
                            Background="{ThemeResource TrackBgBrush}"
                            BorderThickness="0" />

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.DriveDetailsText, Mode=OneWay}"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextMediumBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1"
                                    Background="{ThemeResource SuccessSurfaceBrush}"
                                    BorderBrush="{ThemeResource HairlineBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="5,1"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="NVMe / SSD S.M.A.R.T. Health Status"
                                    AutomationProperties.Name="Drive S.M.A.R.T. Health Status">
                                <TextBlock Text="{x:Bind ViewModel.DriveHealthText, Mode=OneWay}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{x:Bind ViewModel.DriveHealthColor, Mode=OneWay, Converter={StaticResource HexToBrush}}" />
                            </Border>
                            <Button Grid.Column="2"
                                    loc:Loc.Key="DriveSpeedTest"
                                    Content="Speed Test"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Padding="8,2.5"
                                    CornerRadius="12"
                                    Background="{ThemeResource PillButtonBgBrush}"
                                    BorderBrush="{ThemeResource HairlineBorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{ThemeResource TextHighBrush}"
                                    IsEnabled="{x:Bind ViewModel.IsBenchmarking, Mode=OneWay, Converter={StaticResource NotBool}}"
                                    ToolTipService.ToolTip="Run non-destructive sequential read speed test"
                                    AutomationProperties.Name="Run non-destructive sequential read speed test"
                                    Click="OnSpeedTestClick"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- WPF's drive-card shortcut into the Large Files scanner
                             (MainWindow.xaml:770, Click="OpenLargeFilesModal_Click"):
                             the shell owns the section map, the pill only asks. -->
                        <Button
                            HorizontalAlignment="Left"
                            Padding="8,2.5"
                            CornerRadius="12"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource HairlineBorderBrush}"
                            BorderThickness="1"
                            ToolTipService.ToolTip="Scan Drive for AI-categorized Large Files"
                            AutomationProperties.Name="Open the Large Files scanner"
                            Click="OnOpenLargeFilesClick"
                            HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8B7;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="10.5"
                                          Foreground="{ThemeResource ElectricCyanBrush}" />
                                <TextBlock Text="Large Files"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextHighBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- RAM Telemetry & Quick Optimizer Card (WPF MainWindow.xaml:834-918):
                     live used percent, RAM Cleaner walk to the Memory workspace and the
                     Quick Boost trim. The RAM Cleaner pill only asks - the shell owns
                     the section map, the same rule as the Large Files pill above. -->
                <Border Style="{StaticResource StatCard}" Width="252" Padding="12,8"
                        AutomationProperties.Name="System Memory RAM Telemetry">
                    <StackPanel Spacing="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE950;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="11"
                                          Foreground="{ThemeResource ElectricCyanBrush}" />
                                <TextBlock loc:Loc.Key="HeroRamLabel" Text="RAM Memory"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextHighBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="RamPercentText"
                                           Text="{x:Bind ViewModel.RamUsedPercentText, Mode=OneWay}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{ThemeResource ElectricCyanBrush}"
                                           VerticalAlignment="Center" />
                                <Button loc:Loc.Key="HeroRamBtn" Content="RAM Cleaner"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Padding="8,2.5"
                                        CornerRadius="12"
                                        Background="{ThemeResource PillButtonBgBrush}"
                                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                                        BorderThickness="1"
                                        Foreground="{ThemeResource ElectricCyanBrush}"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Open Deep Kernel Memory &amp; Cache Cleaner"
                                        AutomationProperties.Name="Open Deep Kernel Memory and Cache Cleaner"
                                        Click="OnMemoryCleanerClick" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar
                            x:Name="RamProgressBar"
                            Minimum="0" Maximum="100"
                            Value="{x:Bind ViewModel.RamUsedPercent, Mode=OneWay}"
                            Height="6"
                            Foreground="{ThemeResource ElectricCyanBrush}"
                            Background="{ThemeResource TrackBgBrush}"
                            BorderThickness="0" />

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.RamDetailText, Mode=OneWay}"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextMediumBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Content="{x:Bind ViewModel.BoostButtonText, Mode=OneWay}"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Padding="8,3"
                                    CornerRadius="12"
                                    Background="{ThemeResource PillButtonBgBrush}"
                                    BorderBrush="{ThemeResource HairlineBorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{ThemeResource TextHighBrush}"
                                    IsEnabled="{x:Bind ViewModel.IsBoosting, Mode=OneWay, Converter={StaticResource NotBool}}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Trim memory (cache eviction)"
                                    AutomationProperties.HelpText="Trims working sets and discards cached pages. This raises available memory but is not a speed boost - evicted pages are re-read from disk on demand."
                                    Command="{x:Bind ViewModel.RamBoostCommand, Mode=OneTime}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer x:Name="CleanerHeaderActionScroller"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled"
                          Background="Transparent">
                <StackPanel x:Name="CleanerHeaderActions" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                    <Button
                        Style="{StaticResource CommandBarButton}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotBool}}"
                        ToolTipService.ToolTip="Scan all temporary scopes, caches, and storage locations (Shortcut: F5)"
                        AutomationProperties.Name="Scan PC for Reclaimable Files"
                        Command="{x:Bind ViewModel.ScanCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextMediumBrush}" />
                            <TextBlock loc:Loc.Key="HeroScanNow" Text="Scan Now" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource CommandBarDivider}" />

                    <Button
                        Style="{StaticResource CommandBarButton}"
                        ToolTipService.ToolTip="Autonomous 1-Click Deep Clean: purges all safe disk caches, superseded Windows updates, old restore points and flushes RAM"
                        AutomationProperties.Name="1-Click Deep Clean"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotBool}}"
                        Command="{x:Bind ViewModel.DeepCleanCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7E8;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="11"
                                      Foreground="{ThemeResource ElectricCyanBrush}" />
                            <TextBlock loc:Loc.Key="HeroOneClick" Text="Deep Clean" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource CommandBarDivider}" />

                    <Button
                        Style="{StaticResource CommandBarButton}"
                        ToolTipService.ToolTip="Read-only report: show where your AppData space goes. Nothing is selected and nothing is deleted."
                        AutomationProperties.Name="AppData Footprint Report (read only)"
                        Click="OnFootprintRequested">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D2;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextMediumBrush}" />
                            <TextBlock loc:Loc.Key="AppDataReport" Text="AppData Report" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource CommandBarDivider}" />

                    <Button
                        Style="{StaticResource CommandBarButton}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.GameBoostToolTip, Mode=OneWay}"
                        AutomationProperties.Name="1-Click Game Boost"
                        IsEnabled="{x:Bind ViewModel.IsGameBoostBusy, Mode=OneWay, Converter={StaticResource NotBool}}"
                        Click="OnGameBoostClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7FC;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="11"
                                      Foreground="{x:Bind ViewModel.GameBoostIconColor, Mode=OneWay, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Text="{x:Bind ViewModel.GameBoostText, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource CommandBarDivider}" />

                    <Button
                        Style="{StaticResource CommandBarButton}"
                        ToolTipService.ToolTip="Launch Chris Titus Tech Windows Utility (CTT WinUtil) for system debloating, tweaks &amp; winget installs"
                        AutomationProperties.Name="Launch Chris Titus WinUtil"
                        Click="OnWinUtilClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE756;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="11"
                                      Foreground="{ThemeResource ElectricCyanBrush}" />
                            <TextBlock loc:Loc.Key="HeroWinUtil" Text="CTT WinUtil" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource CommandBarDivider}" />

                    <Button
                        Background="{StaticResource DestructiveRedBrush}"
                        BorderThickness="0"
                        CornerRadius="14"
                        Padding="12,6"
                        FontSize="11.5"
                        IsEnabled="{x:Bind ViewModel.CanClean, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CleanSelectedCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="11"
                                      Foreground="{ThemeResource HeroActionBtnTextBrush}" />
                            <TextBlock loc:Loc.Key="CleanSelected" Text="Clean Selected" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <!-- Filter + selection chips -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock loc:Loc.Key="SelectionLabel" Text="Selection:" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <RadioButton GroupName="CleanerScope" loc:Loc.Key="SelectSafe" Content="Safe Only" Style="{StaticResource CleanerChip}" Tag="SAFE" Checked="OnSafeOnly" />
                <RadioButton GroupName="CleanerScope" loc:Loc.Key="SelectAll" Content="All" Style="{StaticResource CleanerChip}" Tag="ALL" IsChecked="True" Checked="OnSelectAll" />
                <RadioButton GroupName="CleanerScope" loc:Loc.Key="Clear" Content="None" Style="{StaticResource CleanerChip}" Tag="NONE" Checked="OnDeselectAll" />

                <Grid Width="240" Margin="16,0,0,0">
                    <TextBox loc:Loc.PlaceholderKey="SearchTargets"
                             PlaceholderText="Search targets..."
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11.5"
                             Padding="26,5,8,5"
                             CornerRadius="14"
                             Background="{ThemeResource SurfaceCardBrush}"
                             BorderBrush="{ThemeResource HairlineBorderBrush}"
                             BorderThickness="1"
                             Foreground="{ThemeResource TextHighBrush}" />
                    <FontIcon Glyph="&#xE721;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="11"
                              Foreground="{ThemeResource TextMutedBrush}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"
                              IsHitTestVisible="False" />
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock loc:Loc.Key="FilterLabel" Text="Filter:" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <RadioButton GroupName="CleanerFilter" loc:Loc.Key="FilterAll" Content="All" Style="{StaticResource CleanerChip}" Tag="ALL" IsChecked="True" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" loc:Loc.Key="FilterSafe" Content="Safe Mode" Style="{StaticResource CleanerChip}" Tag="SAFE" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" loc:Loc.Key="FilterSystem" Content="System" Style="{StaticResource CleanerChip}" Tag="SYSTEM" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" loc:Loc.Key="FilterGaming" Content="Gaming" Style="{StaticResource CleanerChip}" Tag="GAMING" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" loc:Loc.Key="FilterMedia" Content="Media" Style="{StaticResource CleanerChip}" Tag="MEDIA" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" loc:Loc.Key="FilterDev" Content="Dev" Style="{StaticResource CleanerChip}" Tag="DEV" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" loc:Loc.Key="FilterRulepack" Content="Rulepacks" Style="{StaticResource CleanerChip}" Tag="RULEPACK" Checked="OnFilterChanged" />

                <!-- WPF kept Smart Clean as a one-press pill in this action strip, next
                     to the selection chips. It ticks the safe categories and starts the
                     clean, which still asks for confirmation. -->
                <Border Style="{StaticResource CommandBarDivider}" Margin="8,0" />

                <Button
                    loc:Loc.Key="SmartClean"
                    Content="Smart Clean"
                    ToolTipService.ToolTip="1-Click Smart Clean: select the 100% safe categories and clean them now. Orphaned app leftovers stay unticked for you to review."
                    AutomationProperties.Name="1-Click Smart Clean"
                    Background="{ThemeResource PillButtonBgBrush}"
                    BorderBrush="{ThemeResource ElectricCyanBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="11,4"
                    FontSize="10.5"
                    IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotBool}}"
                    Command="{x:Bind ViewModel.SmartCleanCommand, Mode=OneTime}" />
            </StackPanel>
        </StackPanel>

        <!-- Target list -->
        <Border Grid.Row="2"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8,6">
            <ListView
                ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                SelectionMode="None"
                HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <StaticResource ResourceKey="TargetRowTemplate" />
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Empty state -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource SurfaceCardBrush}"
            BorderBrush="{ThemeResource HairlineBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisInv}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{ThemeResource TextMutedBrush}" />
                <TextBlock loc:Loc.Key="NoCategoriesTitle" Text="No categories to scan"
                           FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextHighBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock loc:Loc.Key="NoCategoriesBody" Text="Click Scan Now to discover cleanable temporary locations."
                           FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}" TextAlignment="Center" MaxWidth="460" />
            </StackPanel>
        </Border>

        <!-- Action + progress dock. WPF kept one strip at the bottom of the window with
             the Safety Shield, the activity-log toggle, the audit export and Cancel, and
             the status line under them. Same order here, split across two rows so nothing
             clips at the 800px minimum window width: shield + log + audit + Cancel want
             more than the 700px of content once the status text is beside them.

             The audit export lives here rather than in the header because this is where
             WPF put it, and because five buttons plus the stats overflowed the header. -->
        <Border Grid.Row="3"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,7">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row A: the switches and actions -->
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              loc:Loc.Key="SafetyShield"
                              Content="Safety Shield (&gt;24h)"
                              IsChecked="{x:Bind ViewModel.SafeMode, Mode=TwoWay}"
                              FontSize="10.5"
                              MinWidth="0"
                              Padding="4,0"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Safety Shield Filter"
                              AutomationProperties.HelpText="Protects files created or modified within the last 24 hours"
                              ToolTipService.ToolTip="Preserve anything written in the last 24 hours, in both the measurement and the clean" />

                    <!-- Shell-owned drawer: this raises, and MainWindow shows the panel.
                         Unseen lines leave a dot on the top-right, exactly like WPF's
                         LogNotificationBadge. -->
                    <Button Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            AutomationProperties.Name="Toggle Activity Log Stream"
                            ToolTipService.ToolTip="Show every scan, clean and refusal this session logged"
                            Click="OnToggleActivityLogClick">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="LogToggleIcon"
                                          Glyph="&#xE756;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="10"
                                          Foreground="{ThemeResource ElectricCyanBrush}" />
                                <TextBlock x:Name="LogToggleText"
                                           loc:Loc.Key="ActivityLog"
                                           Text="Activity Log"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextMediumBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="LogToggleBadge"
                                    Width="6"
                                    Height="6"
                                    CornerRadius="3"
                                    Background="{StaticResource DestructiveRedBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-3,-3,0"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button Grid.Column="2"
                            ToolTipService.ToolTip="Write a cleanup audit report for the categories on screen to the Desktop"
                            AutomationProperties.Name="Export Cleanup Audit Report"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            FontSize="10.5"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ExportAuditCommand, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE8A5;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="10"
                                      Foreground="{ThemeResource ElectricCyanBrush}" />
                            <TextBlock loc:Loc.Key="ExportReport" Text="Audit Report" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4"
                            loc:Loc.Key="Cancel"
                            Content="Cancel"
                            FontSize="11"
                            Padding="12,4"
                            CornerRadius="12"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{StaticResource DestructiveRedBrush}"
                            BorderThickness="1"
                            AutomationProperties.Name="Stop the running scan or clean"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Command="{x:Bind ViewModel.CancelCommand, Mode=OneTime}" />
                </Grid>

                <!-- Row B: what the run is doing -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextMediumBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <ProgressBar Grid.Column="1"
                                 Width="160"
                                 Maximum="100"
                                 Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                 VerticalAlignment="Center"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Column="2"
                               Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Width="40"
                               TextAlignment="Right"
                               Foreground="{ThemeResource TextHighBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Selection summary -->
        <Border Grid.Row="4"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CleanButtonText, Mode=OneWay}"
                           FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextMediumBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.HeroSubtext, Mode=OneWay}"
                           FontSize="11" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
