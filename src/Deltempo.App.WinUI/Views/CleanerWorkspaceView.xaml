<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the Cleaner workspace from MainWindow.Cleaning.cs (~726 lines
    of named-control, null-checked WPF code-behind).

    Scan target categories, review sizes/safety, select, confirm, and clean.
    The scan is read-only; cleaning is gated behind an injected confirmation
    that defaults to refusing.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.CleanerWorkspaceView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Deltempo.App.WinUI.Converters"
    xmlns:models="using:WinTempCleaner.Models"
    mc:Ignorable="d"
    d:DesignWidth="1000"
    d:DesignHeight="640">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
        <!-- IsEnabled needs a bool; a Visibility converter throws in WinUI 3. -->
        <converters:BoolNegationConverter x:Key="NotBool" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource HairlineBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <!-- Shares the ported WPF chip template with the other filter rows. -->
        <Style x:Key="CleanerChip" TargetType="RadioButton" BasedOn="{StaticResource FilterChipRadio}" />

        <DataTemplate x:Key="TargetRowTemplate" x:DataType="models:TargetFolderInfo">
            <Border
                Background="{ThemeResource SurfaceSubCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,9">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <CheckBox
                        Grid.Column="0"
                        MinWidth="0"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding Name}" />

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextHighBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding Description}"
                            FontSize="10"
                            Foreground="{ThemeResource TextMutedBrush}"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Left"
                            MaxWidth="320" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="6,1.5"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Category}"
                            FontSize="9.5"
                            Foreground="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"
                            VerticalAlignment="Center" />
                    </Border>

                    <TextBlock
                        Grid.Column="3"
                        Text="{Binding FormattedSize}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextMutedBrush}"
                        VerticalAlignment="Center" />

                    <Border
                        Grid.Column="4"
                        Background="{Binding SafetyBadgeColor, Converter={StaticResource HexToBrush}}"
                        BorderBrush="{Binding SafetyBadgeColor, Converter={StaticResource HexToBrush}}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="6,1.5"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding SafetyBadge}"
                            FontSize="9.5"
                            Foreground="{ThemeResource TextHighBrush}"
                            VerticalAlignment="Center" />
                    </Border>

                    <Button
                        Grid.Column="5"
                        Content="Retry"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,3"
                        FontSize="10"
                        Margin="8,0,0,0"
                        Command="{Binding ViewModel.RetryTargetCommand, ElementName=Root}"
                        CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Transparent, not a fill of its own. The shell window already paints the canvas
         scrim over the Mica backdrop, so a panel that painted it again would double the
         scrim and make the content column darker than the navigation pane. What this
         panel has to hide - the Stage 1 placeholder and the Core link card - is collapsed
         by ShowWorkspace instead. -->
    <Grid Padding="18,16" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Hero stats + actions -->
        <Grid Grid.Row="0" x:Name="CleanerHeader">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" x:Name="CleanerHeaderStats" Orientation="Horizontal" Spacing="10">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Reclaimable" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.HeroSizeText, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource ElectricCyanBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Categories" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Targets.Count, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextHighBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" x:Name="CleanerHeaderActions" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <Button
                    Style="{StaticResource CommandBarButton}"
                    ToolTipService.ToolTip="Read-only report: show where your AppData space goes. Nothing is selected and nothing is deleted."
                    AutomationProperties.Name="AppData Footprint Report (read only)"
                    Click="OnFootprintRequested">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D2;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="11"
                                  Foreground="{ThemeResource TextMediumBrush}" />
                        <TextBlock Text="AppData Report" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource CommandBarDivider}" />

                <Button
                    Style="{StaticResource CommandBarButton}"
                    IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotBool}}"
                    Command="{x:Bind ViewModel.ScanCommand, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="11"
                                  Foreground="{ThemeResource TextMediumBrush}" />
                        <TextBlock Text="Scan Now" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource CommandBarDivider}" />

                <Button
                    Style="{StaticResource CommandBarButton}"
                    ToolTipService.ToolTip="Autonomous 1-Click Deep Clean: purges all safe disk caches, superseded Windows updates, old restore points and flushes RAM"
                    AutomationProperties.Name="1-Click Deep Clean"
                    IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotBool}}"
                    Command="{x:Bind ViewModel.DeepCleanCommand, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="11"
                                  Foreground="{ThemeResource ElectricCyanBrush}" />
                        <TextBlock Text="Deep Clean" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource CommandBarDivider}" />
                <Button
                    Background="{StaticResource DestructiveRedBrush}"
                    BorderThickness="0"
                    CornerRadius="14"
                    Padding="12,6"
                    FontSize="11.5"
                    IsEnabled="{x:Bind ViewModel.CanClean, Mode=OneWay}"
                    Command="{x:Bind ViewModel.CleanSelectedCommand, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="11"
                                  Foreground="{ThemeResource HeroActionBtnTextBrush}" />
                        <TextBlock Text="Clean Selected" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter + selection chips -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Selection:" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <RadioButton GroupName="CleanerScope" Content="Safe Only" Style="{StaticResource CleanerChip}" Tag="SAFE" Checked="OnSafeOnly" />
                <RadioButton GroupName="CleanerScope" Content="All" Style="{StaticResource CleanerChip}" Tag="ALL" IsChecked="True" Checked="OnSelectAll" />
                <RadioButton GroupName="CleanerScope" Content="None" Style="{StaticResource CleanerChip}" Tag="NONE" Checked="OnDeselectAll" />

                <Grid Width="240" Margin="16,0,0,0">
                    <TextBox PlaceholderText="Search targets..."
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11.5"
                             Padding="26,5,8,5"
                             CornerRadius="14"
                             Background="{ThemeResource SurfaceCardBrush}"
                             BorderBrush="{ThemeResource HairlineBorderBrush}"
                             BorderThickness="1"
                             Foreground="{ThemeResource TextHighBrush}" />
                    <FontIcon Glyph="&#xE721;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="11"
                              Foreground="{ThemeResource TextMutedBrush}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"
                              IsHitTestVisible="False" />
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Filter:" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <RadioButton GroupName="CleanerFilter" Content="All" Style="{StaticResource CleanerChip}" Tag="ALL" IsChecked="True" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" Content="Safe Mode" Style="{StaticResource CleanerChip}" Tag="SAFE" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" Content="System" Style="{StaticResource CleanerChip}" Tag="SYSTEM" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" Content="Gaming" Style="{StaticResource CleanerChip}" Tag="GAMING" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" Content="Media" Style="{StaticResource CleanerChip}" Tag="MEDIA" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" Content="Dev" Style="{StaticResource CleanerChip}" Tag="DEV" Checked="OnFilterChanged" />
                <RadioButton GroupName="CleanerFilter" Content="Rulepacks" Style="{StaticResource CleanerChip}" Tag="RULEPACK" Checked="OnFilterChanged" />

                <!-- WPF kept Smart Clean as a one-press pill in this action strip, next
                     to the selection chips. It ticks the safe categories and starts the
                     clean, which still asks for confirmation. -->
                <Border Style="{StaticResource CommandBarDivider}" Margin="8,0" />

                <Button
                    Content="Smart Clean"
                    ToolTipService.ToolTip="1-Click Smart Clean: select the 100% safe categories and clean them now. Orphaned app leftovers stay unticked for you to review."
                    AutomationProperties.Name="1-Click Smart Clean"
                    Background="{ThemeResource PillButtonBgBrush}"
                    BorderBrush="{ThemeResource ElectricCyanBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="11,4"
                    FontSize="10.5"
                    IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotBool}}"
                    Command="{x:Bind ViewModel.SmartCleanCommand, Mode=OneTime}" />
            </StackPanel>
        </StackPanel>

        <!-- Target list -->
        <Border Grid.Row="2"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8,6">
            <ListView
                ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                SelectionMode="None"
                HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <StaticResource ResourceKey="TargetRowTemplate" />
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Empty state -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource SurfaceCardBrush}"
            BorderBrush="{ThemeResource HairlineBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisInv}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{ThemeResource TextMutedBrush}" />
                <TextBlock Text="No categories to scan"
                           FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextHighBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Click Scan Now to discover cleanable temporary locations."
                           FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}" TextAlignment="Center" MaxWidth="460" />
            </StackPanel>
        </Border>

        <!-- Progress / status dock. WPF kept the same strip at the bottom of the window:
             status text, percentage, bar, and a Cancel button for the run in flight.
             It stays visible after a run so the result line is still readable.
             The audit export lives here rather than in the header because that is
             where WPF put it - beside the log toggle and Cancel - and because five
             buttons plus the stats overflowed the content column at the 800px
             minimum window width. -->
        <Border Grid.Row="3"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,7">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        ToolTipService.ToolTip="Write a cleanup audit report for the categories on screen to the Desktop"
                        AutomationProperties.Name="Export Cleanup Audit Report"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        FontSize="10.5"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ExportAuditCommand, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8A5;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="10"
                                  Foreground="{ThemeResource TextMediumBrush}" />
                        <TextBlock Text="Audit Report" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextMediumBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <ProgressBar Grid.Column="2"
                             Width="160"
                             Maximum="100"
                             Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                             VerticalAlignment="Center"
                             Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Column="3"
                           Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Width="40"
                           TextAlignment="Right"
                           Foreground="{ThemeResource TextHighBrush}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="4"
                        Content="Cancel"
                        FontSize="11"
                        Padding="12,4"
                        CornerRadius="12"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{StaticResource DestructiveRedBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="Stop the running scan or clean"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        Command="{x:Bind ViewModel.CancelCommand, Mode=OneTime}" />
            </Grid>
        </Border>

        <!-- Selection summary -->
        <Border Grid.Row="4"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CleanButtonText, Mode=OneWay}"
                           FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextMediumBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.HeroSubtext, Mode=OneWay}"
                           FontSize="11" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
