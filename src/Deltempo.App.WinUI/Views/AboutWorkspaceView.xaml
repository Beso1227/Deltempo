<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the WPF about panel (the About button in MainWindow.xaml).

    Version and build facts come from the assembly, so they cannot drift from what
    actually shipped. The links open the real pages; nothing here is decorative.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.AboutWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="900"
    d:DesignHeight="460">

    <Grid Padding="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="13"
                Padding="18,16"
                AutomationProperties.Name="About Deltempo">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE946;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="20"
                              Foreground="{ThemeResource ElectricCyanBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Deltempo"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextHighBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="VersionText"
                           FontSize="12"
                           Foreground="{ThemeResource TextMediumBrush}"
                           HorizontalAlignment="Left" />

                <TextBlock Text="Windows cleaner and memory optimizer. Open source, MIT licensed, and it never phones home: there is no telemetry, no account and no cloud service."
                           FontSize="12"
                           Foreground="{ThemeResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           MaxWidth="720" />
            </StackPanel>
        </Border>

        <!-- Trust & Safety card, the WPF About modal's own summary of the shell's
             guarantees; kept in step with that modal so the two UIs promise the same
             five things in the same words. -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10"
                AutomationProperties.Name="Trust and safety summary">
            <StackPanel Spacing="3">
                <TextBlock Text="TRUST &amp; SAFETY"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextMutedBrush}" />
                <TextBlock Text="✓ 100% Open Source (MIT License)"
                           FontSize="11" Foreground="{ThemeResource TextHighBrush}" />
                <TextBlock Text="✓ Zero telemetry — no tracking, no analytics, no phone home"
                           FontSize="11" Foreground="{ThemeResource TextHighBrush}" />
                <TextBlock Text="✓ Safety Shield protects files modified in the last 24 hours"
                           FontSize="11" Foreground="{ThemeResource TextHighBrush}" />
                <TextBlock Text="✓ Recycle Bin mode available — deleted files can be restored"
                           FontSize="11" Foreground="{ThemeResource TextHighBrush}" />
                <TextBlock Text="✓ Deterministic rule-based safety engine — no heuristics guessing"
                           FontSize="11" Foreground="{ThemeResource TextHighBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10"
                AutomationProperties.Name="Publisher">
            <StackPanel Spacing="3">
                <TextBlock Text="PUBLISHER"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextMutedBrush}" />
                <TextBlock Text="Beso1227"
                           FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextHighBrush}" />
                <TextBlock Text="Deltempo Open Source Project"
                           FontSize="11" Foreground="{ThemeResource TextMediumBrush}" />
                <TextBlock Text="https://github.com/Beso1227/Deltempo"
                           FontSize="10.5" Foreground="{ThemeResource ElectricCyanBrush}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4"
                   Margin="0,10,0,0"
                   Text="If you see a Windows SmartScreen warning, it is because this executable is not yet code-signed with a trusted publisher certificate. The app is open source — you can inspect, build, and verify the code yourself at the link above."
                   FontSize="11"
                   Foreground="{ThemeResource TextMediumBrush}"
                   TextWrapping="Wrap"
                   MaxWidth="720" />

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,12"
                AutomationProperties.Name="About links and license">
            <StackPanel Spacing="8">
                <TextBlock Text="Links"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextHighBrush}"
                           HorizontalAlignment="Left" />

                <Button Content="Project page on GitHub"
                        Click="OnOpenRepositoryClick"
                        AutomationProperties.Name="Open the Deltempo project page on GitHub"
                        HorizontalAlignment="Left" />

                <Button Content="Documentation"
                        Click="OnOpenDocumentationClick"
                        AutomationProperties.Name="Open the Deltempo documentation"
                        HorizontalAlignment="Left" />

                <Button Content="MIT license"
                        Click="OnOpenLicenseClick"
                        AutomationProperties.Name="Open the MIT license"
                        HorizontalAlignment="Left" />

                <TextBlock Text="Deltempo is free software released under the MIT license."
                           FontSize="11"
                           Foreground="{ThemeResource TextMutedBrush}"
                           HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
