<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the WPF update modal (UpdateModalOverlay in MainWindow.xaml,
    driven by MainWindow.Updates.cs).

    Same offer: the version tag, the release subtitle, the changelog exactly as the
    release published it, and two ways out. What it deliberately does not have is
    WPF's "Update Now" button, which streamed a binary and replaced the running
    executable in place. This shell is a preview build that ships beside the WPF app,
    so it reports the release and hands the download to the browser instead of
    rewriting itself: no background install, and nothing on this screen claims a
    signature was checked.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.UpdateOfferView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="860"
    d:DesignHeight="620">

    <Grid Background="Transparent">

        <Border MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SurfaceSubCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="28,24">

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                <!-- 0. Mark + title -->
                <StackPanel Grid.Row="0" Spacing="10" HorizontalAlignment="Center">
                    <Border Width="52"
                            Height="52"
                            CornerRadius="26"
                            Background="{ThemeResource ElectricCyanBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE896;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="24"
                                  Foreground="{ThemeResource HeroActionBtnTextBrush}" />
                    </Border>

                    <TextBlock Text="Update Available"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextHighBrush}"
                               HorizontalAlignment="Center" />

                    <Border Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource ElectricCyanBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,2"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="VersionText"
                                   Text="v0.0.0"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource ElectricCyanBrush}" />
                    </Border>

                    <TextBlock x:Name="SubtitleText"
                               Text="A new official release of Deltempo is available"
                               FontSize="12.5"
                               Foreground="{ThemeResource TextMediumBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 1. Changelog as the release published it -->
                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <ScrollViewer MaxHeight="170"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ChangelogText"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextMediumBrush}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Border>

                <!-- 2. What this button does and does not do -->
                <TextBlock Grid.Row="2"
                           Margin="0,12,0,0"
                           Text="This preview build never downloads or replaces itself. The new version opens on GitHub Releases, where you download it yourself."
                           FontSize="10.5"
                           Foreground="{ThemeResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />

                <!-- 3. Actions -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="0,18,0,0">

                    <Button Content="Later"
                            FontSize="11.5"
                            Padding="18,6"
                            CornerRadius="14"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            AutomationProperties.Name="Remind me about this release another time"
                            Click="OnLaterClicked" />

                    <Button Content="Download on GitHub"
                            FontSize="11.5"
                            Padding="22,6"
                            CornerRadius="14"
                            Background="{ThemeResource ElectricCyanBrush}"
                            Foreground="{ThemeResource HeroActionBtnTextBrush}"
                            BorderThickness="0"
                            AutomationProperties.Name="Open this release on GitHub Releases"
                            Click="OnDownloadClicked" />
                </StackPanel>

                <!-- 4. Where the click went -->
                <TextBlock x:Name="StatusLine"
                           Grid.Row="4"
                           Margin="0,10,0,0"
                           FontSize="10.5"
                           Foreground="{ThemeResource TextMutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
