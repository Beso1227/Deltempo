<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the WPF process manager overlay (MainWindow.xaml's
    ProcessModalOverlay, driven from MainWindow.Memory.cs).

    A workspace here rather than an overlay: it is a tool in its own right, not a
    sub-dialog of the memory screen, and the WPF header gave it its own button.

    Protected system processes are not listed at all - see ProcessWorkspaceViewModel
    for why that is stricter than simply refusing to act on them.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.ProcessWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Deltempo.App.WinUI.ViewModels"
    mc:Ignorable="d"
    x:DataType="vm:ProcessWorkspaceViewModel"
    d:DesignWidth="900"
    d:DesignHeight="460">

    <Grid Padding="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="13"
                Padding="14,10"
                AutomationProperties.Name="Process Manager toolbar">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9F5;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="12"
                              Foreground="{ThemeResource ElectricCyanBrush}"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Process Manager"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextHighBrush}"
                               VerticalAlignment="Center" />
                    <!-- WPF's ProcessSearchBox: match by name or window title. -->
                    <Border Background="{ThemeResource SurfaceSubCardBrush}"
                            BorderBrush="{ThemeResource HairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,3"
                            Height="28"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE721;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextMutedBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0" />
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Search processes by name or title..."
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="11"
                                     MinWidth="170"
                                     VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextMutedBrush}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               MaxWidth="480"
                               HorizontalAlignment="Left" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Click="OnRefreshClick"
                        AutomationProperties.Name="Refresh process list"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Process list -->
        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="13"
                AutomationProperties.Name="Process list">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Processes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProcessRow">
                            <Grid Padding="14,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind TitleText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextHighBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind MemoryText}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextMutedBrush}"
                                               HorizontalAlignment="Left" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ProcessId}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextMutedBrush}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="Trim"
                                        Click="OnTrimClick"
                                        IsEnabled="{x:Bind CanTrim}"
                                        AutomationProperties.Name="Trim working set"
                                        VerticalAlignment="Center" />

                                <Button Grid.Column="3"
                                        Content="End task"
                                        Click="OnEndTaskClick"
                                        IsEnabled="{x:Bind CanEndTask}"
                                        AutomationProperties.Name="End selected process"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status line -->
        <TextBlock Grid.Row="2"
                   Margin="2,8,0,0"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   FontSize="11"
                   Foreground="{ThemeResource TextMutedBrush}"
                   HorizontalAlignment="Left" />
    </Grid>
</UserControl>
