<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the WPF InspectorModalOverlay ("Large Files Inspector Dialog").

    Layout preserved from the WPF modal: header (title, subtitle, close), the file
    list, and a Close footer. One deliberate difference: the WPF modal asked the
    DataContext of a code-behind_COLLECTION `BuiltItems`; here Open() hands the
    rows in, so the overlay owns no viewmodel at all - it is a pure display of the
    TopFiles the scan already collected, and deletes nothing.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.TopFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinTempCleaner.Models"
    mc:Ignorable="d"
    d:DesignWidth="660"
    d:DesignHeight="520">

    <Grid Background="{ThemeResource ModalBackdropBrush}">
        <Border Margin="24,14,24,14"
                MinWidth="420" MaxWidth="660"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource ModalSurfaceBrush}"
                BorderBrush="{ThemeResource ElectricCyanBrush}"
                BorderThickness="1.5"
                CornerRadius="16"
                Padding="22,18">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="Largest Junk Files Inspector"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource TextHighBrush}" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="Showing individual large files discovered in this category"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextMediumBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            AutomationProperties.Name="Close Inspector Dialog"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="OnCloseClick">
                        <FontIcon Glyph="&#xE8BB;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextMediumBrush}" />
                    </Button>
                </Grid>

                <!-- Items list -->
                <Border Grid.Row="1"
                        Background="{ThemeResource SurfaceSubCardBrush}"
                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FilesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:JunkFileItem">
                                    <Border Background="{ThemeResource SurfaceCardBrush}"
                                            BorderBrush="{ThemeResource HairlineBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,0,0,6"
                                            Padding="12,9">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Bind FileName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextHighBrush}" />
                                                <TextBlock Text="{x:Bind FilePath}"
                                                           FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{ThemeResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FormattedSize}"
                                                           FontSize="13.5"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource ElectricCyanBrush}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind FormattedDate}"
                                                           FontSize="10"
                                                           Foreground="{ThemeResource TextMediumBrush}"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Footer -->
                <Button Grid.Row="2"
                        Content="Close Inspector"
                        AutomationProperties.Name="Close Inspector Dialog"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18,7"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
