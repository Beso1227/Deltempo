<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the Large File Hunter workspace from MainWindow.LargeFiles.cs
    (~600 lines of named-control, null-checked WPF code-behind).

    Drive scan, deterministic safety verdicts, per-file selection and
    Recycle Bin recycling. The scan is read-only; recycling is gated behind an
    injected confirmation that defaults to refusing.

    The list/treemap view mode toggle and per-row checkboxes replace the WPF
    named CheckBoxes, ComboBoxes and Treemap Canvas with bound data.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.LargeFilesWorkspaceView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Deltempo.App.WinUI.Converters"
    xmlns:services="using:WinTempCleaner.Services"
    mc:Ignorable="d"
    d:DesignWidth="1000"
    d:DesignHeight="640">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolNegationConverter x:Key="NotBool" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource HairlineBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <!-- Shares the ported WPF chip template with the other filter rows. -->
        <Style x:Key="LargeFileChip" TargetType="RadioButton" BasedOn="{StaticResource FilterChipRadio}" />

        <DataTemplate x:Key="LargeFileRowTemplate" x:DataType="services:LargeFileInfo">
            <Border
                Background="{ThemeResource SurfaceSubCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,9">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <CheckBox
                            MinWidth="0"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding FileName}" />
                        <FontIcon
                            Glyph="{Binding CategoryIcon}"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="14"
                            Foreground="{ThemeResource TextMutedBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding FileName}"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextHighBrush}"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Left"
                            MaxWidth="260"
                            VerticalAlignment="Center" />
                        <Border
                            Background="{ThemeResource SurfaceCardBrush}"
                            BorderBrush="{ThemeResource HairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,1.5">
                            <TextBlock
                                Text="{Binding Category}"
                                FontSize="10"
                                Foreground="{ThemeResource TextMutedBrush}"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Text="{Binding FormattedSize}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{Binding BadgeColor, Converter={StaticResource HexToBrush}}"
                            VerticalAlignment="Center" />
                        <Border
                            Background="{Binding BadgeBackground, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{Binding BadgeBorder, Converter={StaticResource HexToBrush}}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,1.5"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding VerdictShort}"
                                FontSize="9.5"
                                FontWeight="SemiBold"
                                Foreground="{Binding BadgeColor, Converter={StaticResource HexToBrush}}"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Text="{Binding FormattedDate}"
                            FontSize="10"
                            Foreground="{ThemeResource TextMutedBrush}"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Left"
                            MaxWidth="150"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <Button
                            Content="Reveal"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Command="{Binding ViewModel.RevealCommand, ElementName=Root}"
                            CommandParameter="{Binding}" />
                        <Button
                            Content="Ask AI"
                            ToolTipService.ToolTip="Connect to AI / Internet to fetch real-world info on this file"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"
                            IsEnabled="{Binding IsAiAnalyzing, Converter={StaticResource NotBool}}"
                            Command="{Binding ViewModel.AnalyzeItemCommand, ElementName=Root}"
                            CommandParameter="{Binding}" />
                        <Button
                            Content="Recycle"
                            ToolTipService.ToolTip="Move this file to the Windows Recycle Bin."
                            Background="{StaticResource DestructiveRedBrush}"
                            BorderBrush="{StaticResource DestructiveRedBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            FontSize="11"
                            IsEnabled="{Binding IsSafe, Mode=OneWay}"
                            Command="{Binding ViewModel.RecycleItemCommand, ElementName=Root}"
                            CommandParameter="{Binding}" />
                    </StackPanel>

                    <!-- Row 2: the AI explanation capsule, WPF's row 3
                         (MainWindow.xaml:4822). Filled by ApplyOnlineReport; hidden
                         until the row was verified online, with "Analyzing..."
                         covering the fetch window like WPF's AskAiLargeFile_Click. -->
                    <StackPanel Grid.Row="1">
                        <Border
                            Background="{ThemeResource SurfaceCardBrush}"
                            BorderBrush="{ThemeResource HairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,5"
                            Visibility="{Binding IsAiOnlineVerified, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Text="{Binding Origin}"
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextHighBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <Border
                                        Grid.Column="1"
                                        Background="{ThemeResource SurfaceSubCardBrush}"
                                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,1">
                                        <TextBlock
                                            Text="{Binding AiProviderLabel}"
                                            FontSize="9"
                                            Foreground="{ThemeResource TextMutedBrush}"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock
                                    Text="{Binding Explanation}"
                                    FontSize="10.5"
                                    Foreground="{ThemeResource TextMediumBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding AiRecommendation}"
                                    FontSize="10"
                                    Foreground="{ThemeResource SuccessTextBrightBrush}"
                                    Margin="0,3,0,0"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Text="Analyzing..."
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextMutedBrush}"
                            Visibility="{Binding IsAiAnalyzing, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Transparent, not a fill of its own: the shell paints the one canvas scrim over
         the Mica backdrop, and a second copy here would make the content darker than the
         navigation pane. ShowWorkspace collapses what this panel would otherwise reveal. -->
    <Grid Padding="18,16" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Hero stats + actions -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Total storage" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalStorageText, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextHighBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Safe to clean" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SafeStorageText, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource SuccessTextBrightBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Protected" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ProtectedStorageText, Mode=OneWay}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource RoseErrorBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <Button
                    Content="Scan Now"
                    Background="{ThemeResource PillButtonBgBrush}"
                    BorderBrush="{ThemeResource PillButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,6"
                    FontSize="11.5"
                    Margin="0,0,8,0"
                    IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotBool}}"
                    Command="{x:Bind ViewModel.ScanCommand, Mode=OneTime}" />

                <!-- WPF disabled its Scan button for the length of the scan and never
                     exposed the CTS it kept, so a slow drive could not be stopped.
                     The command is the same request, now reachable. -->
                <Button
                    Content="Cancel"
                    Background="{ThemeResource PillButtonBgBrush}"
                    BorderBrush="{StaticResource DestructiveRedBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,6"
                    FontSize="11.5"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Stop the running scan"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Command="{x:Bind ViewModel.CancelScanCommand, Mode=OneTime}" />

                <Button
                    Content="{x:Bind ViewModel.RecycleSelectedText, Mode=OneWay}"
                    Background="{StaticResource DestructiveRedBrush}"
                    BorderThickness="0"
                    CornerRadius="14"
                    Padding="14,6"
                    FontSize="11.5"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Command="{x:Bind ViewModel.RecycleSelectedCommand, Mode=OneTime}" />
            </StackPanel>
        </Grid>

        <!-- Filter chips + view mode, organized as a two-row card. One long
             StackPanel overflowed the workspace at the app's default width -
             scope chips, size chips, two combos and the view toggle could not
             fit a row - so the controls group by function: Row A answers "where
             and how to show it", Row B answers "what to include and how to rank
             it". Names, handlers and tags are unchanged for the code-behind. -->
        <Border Grid.Row="1"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,12,0,10">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row A: scope chips + the list/treemap toggle -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Scope:" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                    <!-- Filled at load: All Drives, then one chip per drive, then User Profile.
                         A fixed pair of chips could not express "scan only D:". -->
                    <StackPanel x:Name="ScopeChips" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="View:" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <RadioButton GroupName="LargeFileView" Content="List" Style="{StaticResource LargeFileChip}" Tag="LIST" IsChecked="True" Checked="OnViewModeChanged" />
                    <RadioButton GroupName="LargeFileView" Content="Treemap" Style="{StaticResource LargeFileChip}" Tag="TREEMAP" Checked="OnViewModeChanged" />
                </StackPanel>

                <!-- Row B: size threshold chips + the filter / sort combos,
                     right-aligned so the combos never push the chips off-card -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Min size:" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <RadioButton GroupName="LargeFileSize" Content="50 MB" Style="{StaticResource LargeFileChip}" Tag="52428800" IsChecked="True" Checked="OnSizeChanged" />
                    <RadioButton GroupName="LargeFileSize" Content="100 MB" Style="{StaticResource LargeFileChip}" Tag="104857600" Checked="OnSizeChanged" />
                    <RadioButton GroupName="LargeFileSize" Content="500 MB" Style="{StaticResource LargeFileChip}" Tag="524288000" Checked="OnSizeChanged" />
                    <RadioButton GroupName="LargeFileSize" Content="1 GB" Style="{StaticResource LargeFileChip}" Tag="1073741824" Checked="OnSizeChanged" />
                    <RadioButton GroupName="LargeFileSize" Content="5 GB" Style="{StaticResource LargeFileChip}" Tag="5368709120" Checked="OnSizeChanged" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- WPF's LargeFileCategoryComboBox port: the same tags drive the
                         OrdinalIgnoreCase category match, SAFE = safe-only, RISK = unsafe-only. -->
                    <ComboBox x:Name="CategoryFilterCombo"
                              Width="150"
                              SelectionChanged="OnCategoryFilterChanged"
                              AutomationProperties.Name="Filter large files by category">
                        <ComboBoxItem Content="All Items" Tag="ALL" IsSelected="True" />
                        <ComboBoxItem Content="Safe to Delete Only" Tag="SAFE" />
                        <ComboBoxItem Content="Protected Files Only" Tag="RISK" />
                        <ComboBoxItem Content="Installers &amp; ISOs" Tag="Installer / ISO" />
                        <ComboBoxItem Content="Game Assets" Tag="Game Asset / Pak" />
                        <ComboBoxItem Content="Media &amp; Videos" Tag="Video / Media" />
                        <ComboBoxItem Content="Archives" Tag="Archive" />
                    </ComboBox>
                    <!-- WPF's LargeFileSortComboBox port. -->
                    <ComboBox x:Name="SortModeCombo"
                              Width="150"
                              SelectionChanged="OnSortModeChanged"
                              AutomationProperties.Name="Sort large files">
                        <ComboBoxItem Content="Largest First" Tag="SIZE_DESC" IsSelected="True" />
                        <ComboBoxItem Content="Smallest First" Tag="SIZE_ASC" />
                        <ComboBoxItem Content="Safety Verdict" Tag="SAFETY" />
                        <ComboBoxItem Content="File Name" Tag="NAME" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content: list or treemap -->
        <Grid Grid.Row="2">
            <ListView
                x:Name="LargeFilesList"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                SelectionMode="None"
                HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <StaticResource ResourceKey="LargeFileRowTemplate" />
                </ListView.ItemTemplate>
            </ListView>

            <Canvas
                x:Name="TreemapCanvas"
                Background="{ThemeResource SurfaceCardBrush}"
                Visibility="Collapsed"
                SizeChanged="OnTreemapSizeChanged" />
        </Grid>

        <!-- Empty state -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource SurfaceCardBrush}"
            BorderBrush="{ThemeResource HairlineBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{ThemeResource TextMutedBrush}" />
                <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                           FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextHighBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                           FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}" TextAlignment="Center" MaxWidth="460" />
            </StackPanel>
        </Border>

        <!-- Selection summary + actions. Visible whenever there is something to
             select, so Select Safe / Select All / Clear stay reachable without a
             first manual tick. Left column mirrors the WPF footer: the Recycle Bin
             shortcut and the scan/recycle status line. -->
        <Border Grid.Row="3"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button
                        Content="Open Recycle Bin"
                        ToolTipService.ToolTip="Open Windows Recycle Bin to restore any recycled file"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="11,5"
                        FontSize="10.5"
                        Command="{x:Bind ViewModel.OpenRecycleBinCommand, Mode=OneTime}" />

                    <!-- WPF's AskAiSelectedLargeFilesBtn (MainWindow.xaml:4672 /
                         MainWindow.Settings.cs:339): ticked files first, then anything
                         never verified online, then everything scanned. Online AI -
                         never wired into the self-test. -->
                    <Button
                        Content="{x:Bind ViewModel.BatchAnalyzeText, Mode=OneWay}"
                        ToolTipService.ToolTip="Connect to AI / Internet to fetch real-world info on the selected large files"
                        AutomationProperties.Name="Ask AI about the selected large files"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="11,5"
                        FontSize="10.5"
                        Command="{x:Bind ViewModel.BatchAnalyzeCommand, Mode=OneTime}"
                        Margin="0,0,8,0" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="10.5"
                               Foreground="{ThemeResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SelectedSummaryText, Mode=OneWay}"
                               FontSize="11" Foreground="{ThemeResource TextMediumBrush}" VerticalAlignment="Center" />
                    <Button
                        Content="Select Safe"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        FontSize="11"
                        Command="{x:Bind ViewModel.SelectSafeCommand, Mode=OneTime}" />
                    <Button
                        Content="Select All"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        FontSize="11"
                        Command="{x:Bind ViewModel.SelectAllCommand, Mode=OneTime}" />
                    <Button
                        Content="Clear"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        FontSize="11"
                        Command="{x:Bind ViewModel.ClearSelectionCommand, Mode=OneTime}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
