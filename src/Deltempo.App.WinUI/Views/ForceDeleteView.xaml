<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of Views/Modals/ForceDeleteModal.xaml (420 lines).
    Five rows preserved: header, picker bar, summary + options, target list,
    footer actions.

    Differences forced by the framework:
      - the gate-tier badge colours are resolved in the row ViewModel, because
        the WPF version used Style.Triggers/DataTrigger and WinUI 3 has no
        DataTrigger
      - a shielded row's checkbox is disabled and uncheckable, matching the WPF
        DataTrigger that disabled it
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.ForceDeleteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Deltempo.App.WinUI.Converters"
    xmlns:viewmodels="using:Deltempo.App.WinUI.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="860"
    d:DesignHeight="600">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Margin="24,14,24,14"
                Background="{ThemeResource SurfaceSubCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22,18">

            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

                <!-- 0. Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="{ThemeResource SurfaceSubCardBrush}"
                                BorderBrush="{StaticResource DestructiveRedBrush}"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE74D;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="18"
                                      Foreground="{ThemeResource DestructiveRedTextBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Force Delete &amp; Stubborn Purge"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextHighBrush}" />
                            <TextBlock Text="Bypass locks, attributes, ownership and ACLs to permanently remove stubborn files and folders"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextMediumBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            AutomationProperties.Name="Close force delete"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.CloseCommand, Mode=OneTime}">
                        <FontIcon Glyph="&#xE8BB;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextMediumBrush}" />
                    </Button>
                </Grid>

                <!-- 1. Picker bar -->
                <Border Grid.Row="1"
                        Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,9"
                        Margin="0,0,0,12">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                        <Button Grid.Column="0"
                                AutomationProperties.Name="Add files to the force delete list"
                                ToolTipService.ToolTip="Choose one or more files to permanently force delete"
                                Background="{ThemeResource PillButtonBgBrush}"
                                BorderBrush="{ThemeResource PillButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,6"
                                FontSize="11.5"
                                Margin="0,0,8,0"
                                IsEnabled="{x:Bind ViewModel.CanStage, Mode=OneWay}"
                                Command="{x:Bind ViewModel.AddFilesCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8E5;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="11"
                                          Margin="0,0,5,0"
                                          Foreground="{ThemeResource ElectricCyanBrush}" />
                                <TextBlock Text="Add Files" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                AutomationProperties.Name="Add a folder to the force delete list"
                                ToolTipService.ToolTip="Choose a folder to recursively force delete"
                                Background="{ThemeResource PillButtonBgBrush}"
                                BorderBrush="{ThemeResource PillButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,6"
                                FontSize="11.5"
                                Margin="0,0,12,0"
                                IsEnabled="{x:Bind ViewModel.CanStage, Mode=OneWay}"
                                Command="{x:Bind ViewModel.AddFolderCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;"
                                          FontFamily="{StaticResource IconFont}"
                                          FontSize="11"
                                          Margin="0,0,5,0"
                                          Foreground="{ThemeResource ElectricCyanBrush}" />
                                <TextBlock Text="Add Folder" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="2"
                                   Text="Pick files or folders to purge. Add as many as you need before running."
                                   FontSize="10.5"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,12,0" />

                        <Button Grid.Column="3"
                                AutomationProperties.Name="Clear all staged targets"
                                ToolTipService.ToolTip="Remove every staged target from the list"
                                Content="Clear All"
                                Background="{ThemeResource PillButtonBgBrush}"
                                BorderBrush="{ThemeResource PillButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12,6"
                                FontSize="11.5"
                                Command="{x:Bind ViewModel.ClearAllCommand, Mode=OneTime}"
                            IsEnabled="{x:Bind ViewModel.CanStage, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- 2. Summary + options -->
                <Border Grid.Row="2"
                        Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextHighBrush}" />
                                <TextBlock Text="Absolute-blocked system paths are shielded and can never be removed."
                                           FontSize="10.5"
                                           Foreground="{ThemeResource TextMutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Terminate lockers"
                                          IsChecked="{x:Bind ViewModel.TerminateLockers, Mode=TwoWay}"
                                          Margin="0,0,16,0"
                                          FontSize="11.5"
                                          ToolTipService.ToolTip="Force-kill the applications holding a handle on the target before deleting" />
                                <CheckBox Content="Recycle bin"
                                          IsChecked="{x:Bind ViewModel.SendToRecycleBin, Mode=TwoWay}"
                                          FontSize="11.5"
                                          ToolTipService.ToolTip="Send items to the Recycle Bin instead of a permanent purge" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{ThemeResource WarningBadgeBgBrush}"
                                BorderBrush="{ThemeResource WarningBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,10,0,0"
                                Visibility="{x:Bind ViewModel.HasProtectedNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Bind ViewModel.ProtectedNotice, Mode=OneWay}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource WarningBadgeTextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. Target list -->
                <Border Grid.Row="3"
                        Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,8"
                        Margin="0,0,0,12">
                    <ListView ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ForceDeleteTargetRowViewModel">
                                <Border Background="{ThemeResource SurfaceCardBrush}"
                                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                                        <!-- Shielded rows cannot be selected: the WPF version
                                             disabled this box with a DataTrigger. -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind IsSelectable, Mode=OneWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  ToolTipService.ToolTip="Include this target in the purge"
                                                  AutomationProperties.Name="{x:Bind FileName, Mode=OneTime}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FileName, Mode=OneTime}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextHighBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Left"
                                                           MaxWidth="330" />
                                                <Border Background="{ThemeResource SurfaceSubCardBrush}"
                                                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="6,1.5"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="{x:Bind Item.KindLabel, Mode=OneTime}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextMediumBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{x:Bind FilePath, Mode=OneTime}"
                                                       FontSize="10.5"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{ThemeResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left"
                                                       MaxWidth="420"
                                                       Margin="0,2,0,0" />

                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{x:Bind IssueSummary, Mode=OneTime}"
                                                           FontSize="10.5"
                                                           Foreground="{ThemeResource AmberWarningBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Left"
                                                           MaxWidth="330" />
                                                <TextBlock Text="{x:Bind Item.DisplayProcessInfo, Mode=OneTime}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource RoseErrorBrush}"
                                                           Margin="8,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{ThemeResource SurfaceSubCardBrush}"
                                                BorderBrush="{ThemeResource HairlineBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedSize, Mode=OneTime}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource ElectricCyanBrush}" />
                                        </Border>

                                        <!-- Gate tier badge: colours resolved in the ViewModel. -->
                                        <Border Grid.Column="3"
                                                Background="{x:Bind BadgeBackgroundHex, Mode=OneTime, Converter={StaticResource HexToBrush}}"
                                                BorderBrush="{x:Bind BadgeBorderHex, Mode=OneTime, Converter={StaticResource HexToBrush}}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind BadgeText, Mode=OneTime}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{x:Bind BadgeForegroundHex, Mode=OneTime, Converter={StaticResource HexToBrush}}" />
                                        </Border>

                                        <Border Grid.Column="4"
                                                Background="{ThemeResource SurfaceSubCardBrush}"
                                                BorderBrush="{ThemeResource HairlineBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneTime}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextMutedBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- 4. Footer actions -->
                <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               Text="A confirmation prompt appears before anything is deleted."
                               FontSize="10.5"
                               Foreground="{ThemeResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />

                    <Button Grid.Column="1"
                            Content="Dry Run"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16,6"
                            FontSize="11.5"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.CanRunPurge, Mode=OneWay}"
                            Command="{x:Bind ViewModel.DryRunCommand, Mode=OneTime}" />

                    <Button Grid.Column="2"
                            Content="Force Delete"
                            AutomationProperties.Name="Permanently delete the selected targets"
                            ToolTipService.ToolTip="Permanently removes the selected targets. You will be asked to confirm before anything is deleted."
                            Background="{StaticResource DestructiveRedBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="14"
                            Padding="24,7.5"
                            FontSize="12"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.CanRunPurge, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ExecuteCommand, Mode=OneTime}" />

                    <Button Grid.Column="3"
                            Content="Close"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18,6"
                            FontSize="11.5"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.CloseCommand, Mode=OneTime}" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>