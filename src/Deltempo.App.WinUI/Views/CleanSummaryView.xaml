<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of Views/Modals/CelebrationModal.xaml.

    Same job as the WPF modal: after a clean, state what was reclaimed, how many
    files and folders went, how long it took, and what was deliberately left
    behind. Shown by the shell over whatever workspace is open, so the numbers
    survive a navigation.

    Differences forced by the framework: the WPF modal was a XAML storyboard with
    a scale-punch; here the shell animates the overlay through ShellMotion on the
    compositor, which is the one motion system the rest of the shell uses.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.CleanSummaryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="860"
    d:DesignHeight="620">

    <UserControl.Resources>
        <!-- Same tile treatment as the workspace stat cards. Each view declares this
             style locally; it is not in the token dictionary. -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource HairlineBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">

        <Border MaxWidth="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SurfaceSubCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="28,24">

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                <!-- 0. Mark + title -->
                <StackPanel Grid.Row="0" Spacing="10" HorizontalAlignment="Center">
                    <Border Width="52"
                            Height="52"
                            CornerRadius="26"
                            Background="{ThemeResource ElectricCyanBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="24"
                                  Foreground="{ThemeResource HeroActionBtnTextBrush}" />
                    </Border>

                    <TextBlock x:Name="TitleText"
                               Text="Cleanup Completed!"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextHighBrush}"
                               HorizontalAlignment="Center" />

                    <TextBlock x:Name="ReclaimedText"
                               Text="Successfully Reclaimed 0 B"
                               FontSize="12.5"
                               Foreground="{ThemeResource ElectricCyanBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />

                    <!-- Deep clean also flushes standby memory, so it has a second
                         number to report. Collapsed for a selected-category clean,
                         where it would always read 0 B. -->
                    <TextBlock x:Name="RamText"
                               FontSize="11.5"
                               Foreground="{ThemeResource TextMediumBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="Collapsed" />

                    <!-- What was deliberately kept. WPF printed this on the same line as
                         the title; a separate line keeps a long breakdown readable. -->
                    <TextBlock x:Name="SkipText"
                               FontSize="11"
                               Foreground="{ThemeResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- 1. Numbers -->
                <Grid Grid.Row="1" Margin="0,18,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="Files Deleted"
                                       FontSize="9.5"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="FilesText"
                                       Text="0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextHighBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="Folders Removed"
                                       FontSize="9.5"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="FoldersText"
                                       Text="0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextHighBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="Time Elapsed"
                                       FontSize="9.5"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="TimeText"
                                       Text="0.0s"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextHighBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Export outcome / errors. Hidden until the user presses Export. -->
                <TextBlock x:Name="StatusLine"
                           Grid.Row="2"
                           Margin="0,14,0,0"
                           FontSize="11"
                           Foreground="{ThemeResource TextMediumBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!-- 3. Actions -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="0,20,0,0">

                    <Button x:Name="ExportButton"
                            Content="Export Report"
                            FontSize="11.5"
                            Padding="16,6"
                            CornerRadius="14"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            AutomationProperties.Name="Save an audit report of this clean to the Desktop"
                            Click="OnExportClicked" />

                    <Button Content="Done"
                            FontSize="11.5"
                            Padding="22,6"
                            CornerRadius="14"
                            Background="{ThemeResource ElectricCyanBrush}"
                            Foreground="{ThemeResource HeroActionBtnTextBrush}"
                            BorderThickness="0"
                            AutomationProperties.Name="Close the clean summary"
                            Click="OnDoneClicked" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
