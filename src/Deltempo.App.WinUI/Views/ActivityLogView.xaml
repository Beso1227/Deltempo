<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the WPF activity log drawer (MainWindow.xaml LogDrawerBorder).

    The WPF drawer was a collapsible strip above the bottom action dock: a title,
    Copy and Clear, then the entries - timestamp, level glyph, message, coloured by
    level. Same jobs here, hosted by the shell so a line written by any workspace
    lands in the same stream.

    Entries are bound to the shell's LogEntry collection (shared Core model), so the
    view never composes the text; it only renders it.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.ActivityLogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Deltempo.App.WinUI.Converters"
    xmlns:loc="using:Deltempo.App.WinUI.Localization"
    xmlns:models="using:WinTempCleaner.Models"
    mc:Ignorable="d"
    d:DesignWidth="1000"
    d:DesignHeight="200">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Border
        Background="{ThemeResource SurfaceCardBrush}"
        BorderBrush="{ThemeResource HairlineBorderBrush}"
        BorderThickness="0,1,0,0"
        Padding="16,7">
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                    <FontIcon
                        Glyph="&#xE81C;"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="10.5"
                        Foreground="{ThemeResource ElectricCyanBrush}" />
                    <TextBlock
                        loc:Loc.Key="ActivityLogStream"
                        Text="ACTIVITY LOG STREAM"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextHighBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                    <Button
                        loc:Loc.Key="CopyLog"
                        Content="Copy"
                        AutomationProperties.Name="Copy log to the clipboard"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,2"
                        FontSize="10"
                        Click="OnCopyClick" />
                    <Button
                        loc:Loc.Key="ClearLog"
                        Content="Clear"
                        AutomationProperties.Name="Clear the activity log"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,2"
                        FontSize="10"
                        Click="OnClearClick" />
                </StackPanel>
            </Grid>

            <ScrollViewer
                x:Name="LogScroller"
                Grid.Row="1"
                MaxHeight="132"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="LogItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:LogEntry">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind FormattedTime}"
                                    FontFamily="{StaticResource MonoFont}"
                                    FontSize="10.5"
                                    Foreground="{ThemeResource TextMediumBrush}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind LevelGlyph}"
                                    FontFamily="{StaticResource MonoFont}"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{x:Bind BadgeColor, Converter={StaticResource HexToBrush}}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Top" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind Message}"
                                    FontFamily="{StaticResource MonoFont}"
                                    FontSize="10.5"
                                    Foreground="{x:Bind BadgeColor, Converter={StaticResource HexToBrush}}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
