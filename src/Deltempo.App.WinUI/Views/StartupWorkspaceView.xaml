<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of the Startup Applications workspace from MainWindow.xaml and
    MainWindow.SystemManagers.cs.

    Safety note: a protected startup entry (driver, security agent, or other
    system-critical launch) must not be toggleable or removable. That rule lives
    in StartupManagerService.IsProtectedStartupItem and is enforced there; the
    row binds to CanToggle / CanCleanOrphaned purely so the UI offers no control
    it would then have to refuse.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.StartupWorkspaceView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Deltempo.App.WinUI.Converters"
    xmlns:viewmodels="using:Deltempo.App.WinUI.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="1000"
    d:DesignHeight="640">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolNegationConverter x:Key="NotBool" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />
        <converters:BytesToBitmapImageConverter x:Key="BytesToImage" DecodePixelWidth="40" />

        <!-- Shares the ported WPF chip template with the other filter rows. -->
        <Style x:Key="StartupChip" TargetType="RadioButton" BasedOn="{StaticResource FilterChipRadio}" />

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource HairlineBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
    </UserControl.Resources>

    <!-- Transparent, not a fill of its own: the shell paints the one canvas scrim over
         the Mica backdrop, and a second copy here would make the content darker than the
         navigation pane. ShowWorkspace collapses what this panel would otherwise reveal. -->
    <Grid Padding="18,16"
          RowDefinitions="Auto,Auto,*">

        <!-- Hero stats + actions -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Total" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextHighBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="High impact" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.HighImpactText, Mode=OneWay}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AmberWarningBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Boot delay" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.BootDelayText, Mode=OneWay}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource ElectricCyanBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Orphaned" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.OrphanedText, Mode=OneWay}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource RoseErrorBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Optimize Boot"
                        ToolTipService.ToolTip="Disable non-essential high-impact startup entries to shorten the next boot."
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,6"
                        FontSize="11.5"
                        Margin="0,0,8,0"
                        Command="{x:Bind ViewModel.OptimizeBootCommand, Mode=OneTime}" />

                <Button Content="Refresh"
                        Background="{ThemeResource PillButtonBgBrush}"
                        BorderBrush="{ThemeResource PillButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,6"
                        FontSize="11.5"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource NotBool}}"
                        Command="{x:Bind ViewModel.RefreshCommand, Mode=OneTime}" />
            </StackPanel>
        </Grid>

        <!-- Filter chips -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
            <RadioButton GroupName="StartupFilter" Content="All"
                         Style="{StaticResource StartupChip}" Tag="All" IsChecked="True"
                         Checked="OnFilterChanged" />
            <RadioButton GroupName="StartupFilter" Content="High Impact"
                         Style="{StaticResource StartupChip}" Tag="HighImpact"
                         Checked="OnFilterChanged" />
            <RadioButton GroupName="StartupFilter" Content="Disabled"
                         Style="{StaticResource StartupChip}" Tag="Disabled"
                         Checked="OnFilterChanged" />
            <RadioButton GroupName="StartupFilter" Content="Orphaned"
                         Style="{StaticResource StartupChip}" Tag="Orphaned"
                         Checked="OnFilterChanged" />
        </StackPanel>

        <!-- Item list -->
        <Border Grid.Row="2"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8,6">
            <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      Background="Transparent"
                      BorderThickness="0"
                      SelectionMode="None"
                      HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <!-- StartupItem is live INotifyPropertyChanged and toggling an entry
                     mutates IsEnabled in place, so this template binds directly
                     rather than through a row wrapper. -->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource SurfaceSubCardBrush}"
                                BorderBrush="{ThemeResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,9">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextHighBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left"
                                                       MaxWidth="320" />

                                            <Border Background="{ThemeResource SurfaceCardBrush}"
                                                    BorderBrush="{ThemeResource HairlineBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="6,1.5"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding LocationDisplay}"
                                                           FontSize="10.5"
                                                           Foreground="{ThemeResource TextMutedBrush}" />
                                            </Border>

                                            <Border Background="{ThemeResource SurfaceCardBrush}"
                                                    BorderBrush="{Binding ImpactColor, Converter={StaticResource HexToBrush}}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="6,1.5"
                                                    Margin="6,0,0,0">
                                                <TextBlock Text="{Binding ImpactText}"
                                                           FontSize="10.5"
                                                           Foreground="{Binding ImpactColor, Converter={StaticResource HexToBrush}}" />
                                            </Border>

                                            <!-- Protected entries are labelled rather than
                                                 silently locked: the user deserves to know
                                                 why a control is missing. -->
                                            <Border Background="{ThemeResource WarningBadgeBgBrush}"
                                                    BorderBrush="{ThemeResource WarningBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="6,1.5"
                                                    Margin="6,0,0,0"
                                                    Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Protected"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource WarningBadgeTextBrush}" />
                                            </Border>

                                            <Border Background="{ThemeResource WarningBadgeBgBrush}"
                                                    BorderBrush="{ThemeResource WarningBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="6,1.5"
                                                    Margin="6,0,0,0"
                                                    Visibility="{Binding IsFileMissing, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="File Missing"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource WarningBadgeTextBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Publisher}"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Left"
                                                   MaxWidth="460"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Reveal"
                                                Background="{ThemeResource PillButtonBgBrush}"
                                                BorderBrush="{ThemeResource PillButtonBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,4"
                                                FontSize="11"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding CanReveal, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.ViewModel.RevealCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />

                                        <Button Content="Clean"
                                                ToolTipService.ToolTip="Remove this orphaned registry entry."
                                                Background="{ThemeResource PillButtonBgBrush}"
                                                BorderBrush="{ThemeResource WarningBadgeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,4"
                                                FontSize="11"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding CanCleanOrphaned, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.ViewModel.CleanOrphanedCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />

                                        <!-- Toggle is offered only when the entry is not
                                             protected. The service refuses regardless.

                                             OneWay on purpose: ToggleSwitch is not a
                                             ButtonBase in WinUI 3 and has no Command,
                                             so the mutation goes through the
                                             Toggled event. A TwoWay binding would
                                             write IsEnabled straight into the model
                                             before the service had agreed to it,
                                             leaving the UI claiming a change the
                                             registry rejected. The model stays the
                                             source of truth and the switch reflects it. -->
                                        <ToggleSwitch IsOn="{Binding IsEnabled, Mode=OneWay}"
                                                      OnContent="On"
                                                      OffContent="Off"
                                                      IsEnabled="{Binding CanToggle, Mode=OneWay}"
                                                      AutomationProperties.Name="Run at startup"
                                                      MinWidth="0"
                                                      Toggled="OnToggleToggled" />

                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                Margin="8,0,0,0"
                                                AutomationProperties.Name="Expand startup entry details"
                                                Command="{Binding DataContext.ViewModel.ToggleExpandCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                            <FontIcon Glyph="&#xE70D;"
                                                      FontFamily="{StaticResource IconFont}"
                                                      FontSize="11"
                                                      Foreground="{ThemeResource TextMutedBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Expandable detail -->
                                <Border Margin="0,8,0,0"
                                        Background="{ThemeResource SurfaceCardBrush}"
                                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="12,9"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextHighBrush}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="10"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{ThemeResource TextMutedBrush}"
                                                   TextWrapping="Wrap">
                                            <Run Text="Command: " />
                                            <Run Text="{Binding Command, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource ElectricCyanBrush}"
                                                   TextWrapping="Wrap">
                                            <Run Text="Recommendation: " />
                                            <Run Text="{Binding Recommendation, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource AmberWarningBrush}"
                                                   TextWrapping="Wrap">
                                            <Run Text="Impact: " />
                                            <Run Text="{Binding DisableImpact, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>