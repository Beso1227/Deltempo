<?xml version="1.0" encoding="utf-8"?>
<!--
    WinUI 3 port of Views/Modals/AppDataFootprintModal.xaml.

    Layout is 1:1 with the WPF version (header, read-only summary card, folder
    list, footer). Two deliberate changes:
      1. Share-bar width comes from the ViewModel (BarWidth) instead of a
         MultiBinding - WinUI 3 has no MultiBinding.
      2. Row colors arrive as ARGB hex strings and are resolved by
         HexToBrushConverter, keeping the ViewModel free of WinUI media types.
-->
<UserControl
    x:Class="Deltempo.App.WinUI.Views.AppDataFootprintView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Deltempo.App.WinUI.ViewModels"
    xmlns:converters="using:Deltempo.App.WinUI.Converters"
    xmlns:loc="using:Deltempo.App.WinUI.Localization"
    mc:Ignorable="d"
    d:DesignWidth="860"
    d:DesignHeight="620">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrush" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource ModalBackdropBrush}">
        <Border Margin="24,14,24,14"
                Background="{ThemeResource ModalSurfaceBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22,18">

            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- 0. Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="{ThemeResource SurfaceSubCardBrush}"
                                BorderBrush="{ThemeResource ElectricCyanBrush}"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE7B3;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="18"
                                      Foreground="{ThemeResource ElectricCyanBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock loc:Loc.Key="AppDataFootprintTitle"
                                       Text="AppData Footprint"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextHighBrush}" />
                            <TextBlock loc:Loc.Key="AppDataFootprintSubtitle"
                                       Text="Where your application data is actually stored"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextMediumBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            AutomationProperties.Name="Close AppData footprint report"
                            x:Name="CloseButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8BB;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextMediumBrush}" />
                    </Button>
                </Grid>

                <!-- 1. Summary + the read-only contract, stated in the UI itself -->
                <Border Grid.Row="1"
                        Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextHighBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock loc:Loc.Key="AppDataFootprintNote"
                                   Text="Report only - nothing here is selected, and nothing is deleted. Rows marked 'covered by an existing scope' can be cleaned by the matching Deltempo scope in the Cleaner."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextMutedBrush}"
                                   Margin="0,4,0,0" />
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                     Height="2"
                                     Margin="0,8,0,0"
                                     Foreground="{ThemeResource ElectricCyanBrush}" />
                    </StackPanel>
                </Border>

                <!-- 2. Folder list -->
                <Border Grid.Row="2"
                        Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,8"
                        Margin="0,0,0,12">
                    <ListView ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:FootprintRowViewModel">
                                <Border Background="{ThemeResource SurfaceCardBrush}"
                                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10">
                                    <Grid ColumnDefinitions="Auto,*,150,Auto">

                                        <!-- glyph -->
                                        <Border Grid.Column="0"
                                                Width="34"
                                                Height="34"
                                                CornerRadius="8"
                                                Background="{ThemeResource SurfaceSubCardBrush}"
                                                BorderBrush="{ThemeResource HairlineBorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B7;"
                                                      FontFamily="{StaticResource IconFont}"
                                                      FontSize="13"
                                                      Foreground="{ThemeResource ElectricCyanBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>

                                        <!-- name + path -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextHighBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Path}"
                                                       FontSize="10.5"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{ThemeResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- share of the largest folder. Track width is fixed
                                             because a track sized by its own fill measures
                                             circularly and collapses to zero. -->
                                        <Grid Grid.Column="2" Width="150" Height="6"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0">
                                            <Border Height="6"
                                                    CornerRadius="3"
                                                    Background="{ThemeResource SurfaceSubCardBrush}"
                                                    BorderBrush="{ThemeResource HairlineBorderBrush}"
                                                    BorderThickness="1" />
                                            <Border Height="6"
                                                    CornerRadius="3"
                                                    HorizontalAlignment="Left"
                                                    Background="{x:Bind BarColor, Converter={StaticResource HexToBrush}}"
                                                    Width="{x:Bind BarWidth, Mode=OneTime}" />
                                        </Grid>

                                        <!-- size + badge -->
                                        <StackPanel Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind FormattedSize}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextHighBrush}"
                                                       HorizontalAlignment="Right" />
                                            <Border Background="{x:Bind BadgeBackground, Converter={StaticResource HexToBrush}}"
                                                    BorderBrush="{x:Bind BadgeForeground, Converter={StaticResource HexToBrush}}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="6,1.5"
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind BadgeText}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{x:Bind BadgeForeground, Converter={StaticResource HexToBrush}}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- 3. Footer -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{x:Bind ViewModel.FooterText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{ThemeResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />

                    <Button Grid.Column="1"
                            AutomationProperties.Name="Re-measure the AppData footprint"
                            ToolTipService.ToolTip="Rescan the three AppData trees and re-measure every folder"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            Background="{ThemeResource PillButtonBgBrush}"
                            BorderBrush="{ThemeResource PillButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,6"
                            IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;"
                                      FontFamily="{StaticResource IconFont}"
                                      FontSize="11"
                                      Margin="0,0,5,0"
                                      Foreground="{ThemeResource ElectricCyanBrush}" />
                            <TextBlock loc:Loc.Key="Remeasure" Text="Re-measure" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>