<Window
    x:Class="Deltempo.App.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Deltempo.App.WinUI.Views"
    xmlns:loc="using:Deltempo.App.WinUI.Localization"
    mc:Ignorable="d"
    Title="Deltempo">

    <Grid x:Name="RootGrid" Background="{ThemeResource CanvasDarkBrush}">

        <!-- Shortcut parity with the WPF window's Window_KeyDown handler: Escape
             closes the overlay on top, F5 / Ctrl+R re-runs the active workspace's
             scan, Ctrl+Enter starts the cleaner's confirmed clean. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRefreshInvoked" />
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnCleanSelectedInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Custom title bar. ExtendsContentIntoTitleBar is set in code-behind; the
             48px drag region mirrors the WPF caption height. -->
        <Grid x:Name="TitleBarHost"
              Grid.Row="0"
              Background="{ThemeResource HeaderDockBrush}"
              BorderBrush="{ThemeResource HairlineBorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <!-- Reserved for the system caption buttons. With
                     ExtendsContentIntoTitleBar the min/max/close buttons are drawn over
                     this row by the shell, so nothing of ours may live in this column -
                     the section label used to sit here and ran under the buttons. -->
                <ColumnDefinition Width="144" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        Padding="16,0,0,0">
                <!-- WPF's 34px rounded logo chip (MainWindow.xaml "Brand Identity"):
                     the top bar leads with the app icon, then the name. -->
                <Border Width="34"
                        Height="34"
                        CornerRadius="9"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource HairlineBorderBrush}"
                        BorderThickness="1">
                    <Image x:Name="TitleBarLogo"
                           Margin="2.5"
                           Stretch="Uniform"
                           AutomationProperties.Name="Deltempo Logo" />
                </Border>
                <Border Width="3"
                        Height="16"
                        CornerRadius="2"
                        Background="{ThemeResource ElectricCyanBrush}" />
                <TextBlock Text="Deltempo"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextHighBrush}"
                           VerticalAlignment="Center" />
                <Border Width="1"
                        Height="13"
                        Background="{ThemeResource HairlineStrongBrush}"
                        VerticalAlignment="Center" />
                <!-- The privilege capsule is clickable, like WPF's AdminElevationButton
                     (MainWindow.xaml:355 → AdminElevationButton_Click, xaml.cs:673):
                     standard-user + click = confirm dialog, then RestartAsAdmin. -->
                <Button x:Name="PrivilegeCapsule"
                        VerticalAlignment="Center"
                        Padding="8,3"
                        CornerRadius="10"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnPrivilegeCapsuleClick"
                        ToolTipService.ToolTip="Status of Administrator Privileges (Click to Elevate)"
                        AutomationProperties.Name="Administrator privileges status">
                    <TextBlock x:Name="PrivilegeLabel"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Text="" />
                </Button>
            </StackPanel>

            <!-- Section search, centred in the title bar. The rail is icon-only, so
                 the fastest way to reach a tool is to type its name. The suggestion
                 list is filled from the same section table the rail is built from,
                 so it can never offer a destination the rail does not have. -->
            <AutoSuggestBox x:Name="SectionSearchBox"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="320"
                            Height="28"
                            loc:Loc.PlaceholderKey="JumpToTool"
                            loc:Loc.NameKey="JumpToTool"
                            PlaceholderText="Jump to a tool"
                            QueryIcon="Find"
                            SuggestionChosen="OnSectionSearchChosen"
                            AutomationProperties.Name="Jump to a tool" />
        </Grid>

        <!-- Body: navigation rail + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Icon strip. The WPF header collapsed its labels below 1280px and
                     showed glyphs alone; here the rail is icon-only at every width and
                     the section name arrives as a tooltip on hover (BuildNavigation),
                     which is what keeps 64px of rail able to carry eight destinations
                     without guessing from glyphs alone. -->
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation pane. Acrylic rather than a flat fill, which is what a WinUI
                 NavigationView pane uses and what lets the Mica backdrop read through
                 the rail as well as the content.

                 The tools sit at the top and the preferences at the bottom, with a
                 rule between them: a tool is something you go and do, a preference
                 is something you set once and forget. -->
            <Border Grid.Column="0"
                    Background="{ThemeResource PaneAcrylicBrush}"
                    BorderBrush="{ThemeResource HairlineBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid x:Name="RailHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- The selection pill: one element for the whole rail rather than
                         a bar inside every item. Switching sections then moves the bar
                         to its new row instead of blinking one off and another on, and
                         it can travel across the rule into the preference cluster.

                         It lives in a Canvas, so its layout position stays pinned at
                         the pane's top-left and the compositor carries the movement.
                         Animating a Margin or a Canvas.Top would re-run layout on
                         every frame of the slide. -->
                    <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                        <Border x:Name="NavSelectionPill"
                                Width="3"
                                Height="20"
                                CornerRadius="2"
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Background="{ThemeResource ElectricCyanBrush}"
                                Opacity="0" />
                    </Canvas>

                    <ListView x:Name="NavList"
                              Grid.Row="0"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single"
                              IsItemClickEnabled="False"
                              ItemContainerStyle="{StaticResource RailItemStyle}"
                              Padding="0,8,0,4"
                              VerticalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                    <!-- The rule between the tools and the preferences: a tool is
                         something you go and do, a preference is something you set
                         once and forget, so the two clusters are separated. -->
                    <Border Grid.Row="1"
                            Height="1"
                            Margin="12,7,12,7"
                            Background="{ThemeResource HairlineBorderBrush}" />

                    <ListView x:Name="NavFooterList"
                              Grid.Row="2"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single"
                              IsItemClickEnabled="False"
                              ItemContainerStyle="{StaticResource RailItemStyle}"
                              Padding="0,0,0,8"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>

            <!-- Content column: a shell-owned page header, then the workspace host.
                 The page header lives here rather than in each panel so all eight
                 workspaces announce themselves with the same eyebrow / title /
                 description treatment and the title cannot drift per view. Named
                 because ShowWorkspace hands it to ShellMotion on every switch. -->
            <Grid Grid.Column="1" x:Name="ContentColumn">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Page header. A leading tile carries the section's glyph, the title
                     names the screen and the line under it says what the screen will
                     and will not do - the same information the WPF header carried, in
                     the arrangement the rest of the world uses for an app's top
                     screen. -->
                <Grid Grid.Row="0"
                      Margin="20,14,20,12"
                      ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="46"
                            Height="46"
                            CornerRadius="13"
                            Background="{ThemeResource SurfaceCardBrush}"
                            BorderBrush="{ThemeResource HairlineBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <FontIcon x:Name="PageHeaderIcon"
                                  Glyph="&#xE856;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="20"
                                  Foreground="{ThemeResource ElectricCyanBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="PageTitle"
                                       Style="{StaticResource PageTitleText}"
                                       Text="Cleaner Workspace" />
                            <Border Background="{ThemeResource SurfaceSubCardBrush}"
                                    CornerRadius="6"
                                    Padding="7,2,7,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="PageEyebrow"
                                           Style="{StaticResource EyebrowText}"
                                           Text="WORKSPACE" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="PageDescription"
                                   Style="{StaticResource PageDescriptionText}"
                                   MaxWidth="760"
                                   HorizontalAlignment="Left"
                                   Text="Finds temp files and caches. Nothing is deleted until you press Clean." />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Stage 1 content placeholder. Real screens land in Stage 2. -->
                    <StackPanel x:Name="PlaceholderPanel"
                                Grid.Row="0"
                                Margin="32"
                                Spacing="14"
                                VerticalAlignment="Top">
                        <TextBlock x:Name="PlaceholderTitle"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextHighBrush}"
                                   Text="Cleaner Workspace" />
                        <TextBlock x:Name="PlaceholderBody"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextMediumBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="640"
                                   HorizontalAlignment="Left"
                                   Text="Stage 1 shell. This screen is a placeholder - no cleanup logic is wired up and nothing here touches disk." />
                    </StackPanel>

                    <!-- Core connectivity proof: proves the WinUI 3 app can consume the
                         existing Core assembly, which is the whole point of this stage. -->
                    <Border x:Name="CoreLinkCard"
                            Grid.Row="1"
                            Margin="32,0,32,24"
                            Padding="14"
                            CornerRadius="8"
                            Background="{ThemeResource SurfaceCardBrush}"
                            BorderBrush="{ThemeResource HairlineBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextMediumBrush}"
                                       Text="CORE LINK CHECK" />
                            <TextBlock x:Name="CoreStatus"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextHighBrush}"
                                       TextWrapping="Wrap"
                                       Text="checking..." />
                        </StackPanel>
                    </Border>

                    <!-- Stage 3 workspace panels. They live inside the workspace host
                         and span both of its rows, so a panel can never cover the
                         navigation rail or the page header the way a child of the outer
                         grid's full-width row would. Exactly one is visible at a time;
                         the panels paint CanvasDarkBrush through to the window
                         background, so both the placeholder and the Core link card are
                         hidden behind them. -->
                    <views:MemoryWorkspaceView x:Name="MemoryWorkspacePanel"
                                               Grid.Row="0"
                                               Grid.RowSpan="2"
                                               Visibility="Collapsed" />

                    <views:StartupWorkspaceView x:Name="StartupWorkspacePanel"
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Visibility="Collapsed" />

                    <views:LargeFilesWorkspaceView x:Name="LargeFilesWorkspacePanel"
                                                   Grid.Row="0"
                                                   Grid.RowSpan="2"
                                                   Visibility="Collapsed" />

                    <views:CleanerWorkspaceView x:Name="CleanerWorkspacePanel"
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Visibility="Collapsed" />

                    <views:SystemRepairView x:Name="SystemRepairWorkspacePanel"
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Visibility="Collapsed" />

                    <views:AppUninstallView x:Name="AppUninstallWorkspacePanel"
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Visibility="Collapsed" />

                    <views:ForceDeleteView x:Name="ForceDeleteWorkspacePanel"
                                           Grid.Row="0"
                                           Grid.RowSpan="2"
                                           Visibility="Collapsed" />

                    <views:ProcessWorkspaceView x:Name="ProcessWorkspacePanel"
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Visibility="Collapsed" />

                    <views:SettingsWorkspaceView x:Name="SettingsWorkspacePanel"
                                                 Grid.Row="0"
                                                 Grid.RowSpan="2"
                                                 Visibility="Collapsed" />

                    <views:AboutWorkspaceView x:Name="AboutWorkspacePanel"
                                              Grid.Row="0"
                                              Grid.RowSpan="2"
                                              Visibility="Collapsed" />
                </Grid>

                <!-- The activity log drawer. WPF kept it under the cleaner's bottom dock
                     and above the window edge, which is this position: the last row of
                     the content column, so opening it shrinks the workspace above it
                     instead of covering the status bar. It is a shell row rather than
                     part of the cleaner because every workspace writes to the stream. -->
                <views:ActivityLogView x:Name="ActivityLogPanel"
                                       Grid.Row="2"
                                       Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource HeaderDockBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Padding="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                         Width="6"
                         Height="6"
                         VerticalAlignment="Center"
                         Fill="{ThemeResource ElectricCyanBrush}" />

                <TextBlock x:Name="FooterText"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionText}"
                           Text="Ready"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <!-- Sound FX toggle: WPF's SoundToggleBtn (MainWindow.xaml:452,
                         MainWindow.Ui.cs:85). It is a real persisted preference, not a
                         session mute, so it drives the same SoundEnabled setting the
                         Settings toggle writes (ONE INTENTIONAL DEVIATION: it lives in
                         the status bar beside the theme toggle rather than the title
                         bar, for the same reason the theme toggle was re-homed). -->
                    <Button x:Name="SoundToggleButton"
                            Width="32"
                            Height="24"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnSoundToggleClick"
                            ToolTipService.ToolTip="Toggle Haptic Audio Feedback"
                            AutomationProperties.Name="Toggle haptic sound effects">
                        <FontIcon x:Name="SoundToggleIcon"
                                  Glyph="&#xE767;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="13" />
                    </Button>

                    <!-- Theme toggle. It lives in the status bar rather than the title
                         bar because the title bar is now the section search, and the
                         status bar is where the window's other state already is. -->
                    <Button x:Name="ThemeToggleButton"
                            Width="32"
                            Height="24"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnThemeToggleClick"
                            ToolTipService.ToolTip="Switch to light theme"
                            AutomationProperties.Name="Switch between light and dark theme">
                        <FontIcon x:Name="ThemeToggleIcon"
                                  Glyph="&#xE706;"
                                  FontFamily="{StaticResource IconFont}"
                                  FontSize="13" />
                    </Button>

                    <TextBlock x:Name="FooterVersion"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}"
                               Text="WinUI 3" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Surfaces that are genuinely overlays: they open over whichever workspace is
             showing instead of replacing it in the navigation. Declared after the body
             grid so they render above the placeholder and every workspace panel,
             mirroring how the WPF modals are the last children of the root grid. Row 1
             is the whole middle row, including the navigation rail, the way a WPF modal
             is.

             System Repair, App Uninstaller and Force Delete were declared here as well
             while they were Stage 2 modals. All three are workspace panels now, and
             nothing referenced the leftover copies - each one quietly built a second
             ViewModel and a second copy of its list. -->
        <views:AppDataFootprintView x:Name="FootprintView"
                                    Grid.Row="1"
                                    Visibility="Collapsed" />

        <views:LockedFilesView x:Name="LockedFilesOverlay"
                               Grid.Row="1"
                               Visibility="Collapsed" />

        <views:TopFilesView x:Name="TopFilesOverlay"
                            Grid.Row="1"
                            Visibility="Collapsed" />

        <views:MemoryOptimizerView x:Name="MemoryOverlay"
                                   Grid.Row="1"
                                   Visibility="Collapsed" />

        <views:CleanSummaryView x:Name="CleanSummaryOverlay"
                                Grid.Row="1"
                                Visibility="Collapsed" />

        <views:UpdateOfferView x:Name="UpdateOfferOverlay"
                               Grid.Row="1"
                               Visibility="Collapsed" />
    </Grid>
</Window>
