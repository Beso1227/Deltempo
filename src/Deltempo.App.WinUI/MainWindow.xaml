<Window
    x:Class="Deltempo.App.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Deltempo.App.WinUI.Views"
    mc:Ignorable="d"
    Title="Deltempo">

    <Grid Background="{ThemeResource CanvasDarkBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Custom title bar. ExtendsContentIntoTitleBar is set in code-behind; the
             48px drag region mirrors the WPF caption height. -->
        <Grid x:Name="TitleBarHost"
              Grid.Row="0"
              Background="{ThemeResource HeaderDockBrush}"
              BorderBrush="{ThemeResource HairlineBorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <!-- Reserved for the system caption buttons. With
                     ExtendsContentIntoTitleBar the min/max/close buttons are drawn over
                     this row by the shell, so nothing of ours may live in this column -
                     the section label used to sit here and ran under the buttons. -->
                <ColumnDefinition Width="144" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        Padding="16,0,0,0">
                <Border Width="3"
                        Height="16"
                        CornerRadius="2"
                        Background="{ThemeResource ElectricCyanBrush}" />
                <TextBlock Text="Deltempo"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextHighBrush}"
                           VerticalAlignment="Center" />
                <Border Width="1"
                        Height="13"
                        Background="{ThemeResource HairlineStrongBrush}"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="PrivilegeLabel"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Text="" />
            </StackPanel>

            <!-- Theme toggle. Right-aligned in the free column so it sits at the far
                 end of the title bar, clear of the caption buttons, and out of the
                 drag region's way of anything else. The glyph shows the theme the
                 button SWITCHES TO, and the tooltip says so in words. -->
            <Button x:Name="ThemeToggleButton"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="40"
                    Height="32"
                    Margin="0,0,8,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnThemeToggleClick"
                    ToolTipService.ToolTip="Switch to light theme"
                    AutomationProperties.Name="Switch between light and dark theme">
                <FontIcon x:Name="ThemeToggleIcon"
                          Glyph="&#xE706;"
                          FontFamily="{StaticResource IconFont}"
                          FontSize="14" />
            </Button>
        </Grid>

        <!-- Body: navigation rail + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Icon strip. The WPF header collapsed its labels below 1280px and
                     showed glyphs alone; here the rail is icon-only at every width and
                     the section name arrives as a tooltip on hover (BuildNavigation),
                     which is what keeps 64px of rail able to carry eight destinations
                     without guessing from glyphs alone. -->
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation pane. Acrylic rather than a flat fill, which is what a WinUI
                 NavigationView pane uses and what lets the Mica backdrop read through
                 the rail as well as the content. -->
            <Border Grid.Column="0"
                    Background="{ThemeResource PaneAcrylicBrush}"
                    BorderBrush="{ThemeResource HairlineBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListView x:Name="NavList"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          Padding="6,10,6,10"
                          VerticalAlignment="Stretch"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- Retemplated from ListViewItemPresenter for the translucent
                         selected fill and hover. The stock presenter in this WinUI
                         version has no SelectionIndicator* members, so the 3px accent
                         bar that a NavigationViewItem draws is added by the item
                         content instead (see BuildNavContent). Every brush here is one
                         of our tokens - no ThemeResource lookups, because a missing
                         resource key kills the process rather than falling back. -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- 44 DIP tall: the icon is the only affordance in the strip,
                                 so the hit target is the whole row, not the glyph. -->
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ListViewItemPresenter
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            Padding="{TemplateBinding Padding}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Background="{TemplateBinding Background}"
                                            PointerOverBackground="{ThemeResource SurfaceCardHoverBrush}"
                                            PointerOverForeground="{ThemeResource TextHighBrush}"
                                            PressedBackground="{ThemeResource SurfaceCardHoverBrush}"
                                            SelectedBackground="{ThemeResource SurfaceCardSelectedBrush}"
                                            SelectedForeground="{ThemeResource TextHighBrush}"
                                            SelectedPointerOverBackground="{ThemeResource SurfaceCardSelectedBrush}"
                                            SelectedPressedBackground="{ThemeResource SurfaceCardSelectedBrush}"
                                            SelectionCheckMarkVisualEnabled="False" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Border>

            <!-- Content column: a shell-owned page header, then the workspace host.
                 The page header lives here rather than in each panel so all eight
                 workspaces announce themselves with the same eyebrow / title /
                 description treatment and the title cannot drift per view. Named
                 because ShowWorkspace hands it to ShellMotion on every switch. -->
            <Grid Grid.Column="1" x:Name="ContentColumn">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="20,16,20,12"
                            Spacing="3">
                    <TextBlock x:Name="PageEyebrow"
                               Style="{StaticResource EyebrowText}"
                               Text="WORKSPACE" />
                    <TextBlock x:Name="PageTitle"
                               Style="{StaticResource PageTitleText}"
                               Text="Cleaner Workspace" />
                    <TextBlock x:Name="PageDescription"
                               Style="{StaticResource PageDescriptionText}"
                               MaxWidth="760"
                               HorizontalAlignment="Left"
                               Text="Finds temp files and caches. Nothing is deleted until you press Clean." />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Stage 1 content placeholder. Real screens land in Stage 2. -->
                    <StackPanel x:Name="PlaceholderPanel"
                                Grid.Row="0"
                                Margin="32"
                                Spacing="14"
                                VerticalAlignment="Top">
                        <TextBlock x:Name="PlaceholderTitle"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextHighBrush}"
                                   Text="Cleaner Workspace" />
                        <TextBlock x:Name="PlaceholderBody"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextMediumBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="640"
                                   HorizontalAlignment="Left"
                                   Text="Stage 1 shell. This screen is a placeholder - no cleanup logic is wired up and nothing here touches disk." />
                    </StackPanel>

                    <!-- Core connectivity proof: proves the WinUI 3 app can consume the
                         existing Core assembly, which is the whole point of this stage. -->
                    <Border x:Name="CoreLinkCard"
                            Grid.Row="1"
                            Margin="32,0,32,24"
                            Padding="14"
                            CornerRadius="8"
                            Background="{ThemeResource SurfaceCardBrush}"
                            BorderBrush="{ThemeResource HairlineBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextMediumBrush}"
                                       Text="CORE LINK CHECK" />
                            <TextBlock x:Name="CoreStatus"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextHighBrush}"
                                       TextWrapping="Wrap"
                                       Text="checking..." />
                        </StackPanel>
                    </Border>

                    <!-- Stage 3 workspace panels. They live inside the workspace host
                         and span both of its rows, so a panel can never cover the
                         navigation rail or the page header the way a child of the outer
                         grid's full-width row would. Exactly one is visible at a time;
                         the panels paint CanvasDarkBrush through to the window
                         background, so both the placeholder and the Core link card are
                         hidden behind them. -->
                    <views:MemoryWorkspaceView x:Name="MemoryWorkspacePanel"
                                               Grid.Row="0"
                                               Grid.RowSpan="2"
                                               Visibility="Collapsed" />

                    <views:StartupWorkspaceView x:Name="StartupWorkspacePanel"
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Visibility="Collapsed" />

                    <views:LargeFilesWorkspaceView x:Name="LargeFilesWorkspacePanel"
                                                   Grid.Row="0"
                                                   Grid.RowSpan="2"
                                                   Visibility="Collapsed" />

                    <views:CleanerWorkspaceView x:Name="CleanerWorkspacePanel"
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Visibility="Collapsed" />

                    <views:SystemRepairView x:Name="SystemRepairWorkspacePanel"
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Visibility="Collapsed" />

                    <views:AppUninstallView x:Name="AppUninstallWorkspacePanel"
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Visibility="Collapsed" />

                    <views:ForceDeleteView x:Name="ForceDeleteWorkspacePanel"
                                           Grid.Row="0"
                                           Grid.RowSpan="2"
                                           Visibility="Collapsed" />

                    <views:ProcessWorkspaceView x:Name="ProcessWorkspacePanel"
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Visibility="Collapsed" />

                    <views:SettingsWorkspaceView x:Name="SettingsWorkspacePanel"
                                                 Grid.Row="0"
                                                 Grid.RowSpan="2"
                                                 Visibility="Collapsed" />

                    <views:AboutWorkspaceView x:Name="AboutWorkspacePanel"
                                              Grid.Row="0"
                                              Grid.RowSpan="2"
                                              Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource HeaderDockBrush}"
                BorderBrush="{ThemeResource HairlineBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Padding="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                         Width="6"
                         Height="6"
                         VerticalAlignment="Center"
                         Fill="{ThemeResource ElectricCyanBrush}" />

                <TextBlock x:Name="FooterText"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionText}"
                           Text="Ready"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="FooterVersion"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionText}"
                           Text="WinUI 3" />
            </Grid>
        </Border>

        <!-- Surfaces that are genuinely overlays: they open over whichever workspace is
             showing instead of replacing it in the navigation. Declared after the body
             grid so they render above the placeholder and every workspace panel,
             mirroring how the WPF modals are the last children of the root grid. Row 1
             is the whole middle row, including the navigation rail, the way a WPF modal
             is.

             System Repair, App Uninstaller and Force Delete were declared here as well
             while they were Stage 2 modals. All three are workspace panels now, and
             nothing referenced the leftover copies - each one quietly built a second
             ViewModel and a second copy of its list. -->
        <views:AppDataFootprintView x:Name="FootprintView"
                                    Grid.Row="1"
                                    Visibility="Collapsed" />

        <views:LockedFilesView x:Name="LockedFilesOverlay"
                               Grid.Row="1"
                               Visibility="Collapsed" />

        <views:MemoryOptimizerView x:Name="MemoryOverlay"
                                   Grid.Row="1"
                                   Visibility="Collapsed" />
    </Grid>
</Window>