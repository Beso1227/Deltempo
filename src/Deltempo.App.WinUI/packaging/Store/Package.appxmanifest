<?xml version="1.0" encoding="utf-8"?>
<!--
  Package manifest for the Deltempo MSIX/Store flavor of the WinUI shell.

  Identity values are deliberately placeholders: the Store submission plan
  (docs/PUBLISHING_MICROSOFT_STORE.md section 1) requires copying the real
  Name / Publisher / PublisherId from Partner Center, and the manifest's
  Publisher must equal the identity Partner Center assigns. Unsigned
  build-sign only until that step is taken.

  Version is stamped from the same source the shell's footer shows
  (Assembly version), so the package and the UI cannot disagree.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <Identity
    Name="DeltempoWinUIPreview"
    Publisher="CN=Placeholder-Publisher"
    Version="3.2.0.0" />

  <mp:PhoneIdentity PhoneProductId="9a6f4b30-3b1f-4b48-8e7a-5c1e2f8a7d90" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Deltempo (WinUI Preview)</DisplayName>
    <PublisherDisplayName>Deltempo</PublisherDisplayName>
    <Logo>Assets\Store\Icon_44.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- Full trust: the shell cleans system temp state and forces deletes.
         runFullTrust is scope, not elevation - the process still starts
         unelevated per app.store.manifest (asInvoker). Executable + the
         Windows.FullTrustApplication EntryPoint on the Application element
         is the required form for a packaged desktop app: the Extension-only
         pattern is for auxiliary extensions (startup task, execution alias),
         not the main app's launch point. -->
    <Application Id="DeltempoWinUI"
                 Executable="Deltempo.WinUI.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Deltempo (WinUI Preview)"
        Description="Disk &amp; memory cleaning util"
        Square150x150Logo="Assets\Store\Icon_150.png"
        Square44x44Logo="Assets\Store\Icon_44.png"
        BackgroundColor="#0B0F14">
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- runFullTrust: the capability a full-trust desktop (windows/
       Windows.FullTrustApplication) package MUST declare. This is the
       scope declaration - it still says nothing about elevation; the
       process starts as the standard user per app.store.manifest. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
