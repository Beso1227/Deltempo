# NOTE: scripts/vendor/ holds the vendored third-party browser bundle (force-graph.min.js) and is
# SOURCE, not build output -- it must stay tracked. graphify-out/ below is ignored, so the committed
# copy in scripts/vendor/ is the only thing that lets a fresh clone regenerate a graph that renders
# with no network at all. If you ever ignore "vendor/" or "*.min.js", that offline guarantee silently
# disappears and the page will still appear to work online because of the CDN fallback.
graphify-out/
GRAPHIFY.md
vault/
brag-output/
.deploy*.cmd
ci_runs.json
ci_*.json
# Agent/MCP session transcripts and tool-call logs (NDJSON)
*.jsonl
.megamemory/
mcp_config.json

# Web & Package Manager Scratch
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python Scratch
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Brag video build sources (rendered deliverable lives in docs/deltempo.mp4)
brag-output-*/
brag-shots/

# UI verification captures (scripts/capture_layout_matrix.ps1)
artifacts/

# UI verification captures (elevated UI Automation + PrintWindow runs).
# *.png cannot be blanket-ignored because README and docs images are tracked, and
# ui-verify.txt is not matched by any existing pattern. Keep these two explicit.
ui-verify.txt
ui-verify*.png

# One-off scratch: encoded source dumps and ad-hoc repair scripts
encoded*.txt
scratch-*.py
fix*.py
# Root-level ad-hoc throwaway scripts, named with a leading underscore. These are
# what actually turns up when investigating a file - `_scan.py`, `_j.py` - and the
# named patterns above do not cover that shape. Scoped to the repository root and to
# .py/.txt only, so a legitimate underscore-prefixed file elsewhere is unaffected.
# Deliberately NOT `*.py` or `*.txt` at large: Python and text files can be source.
/_*.py
/_*.txt

# Release artefacts written outside artifacts/ or dist/. Both names come from
# release.yml; the workflow currently writes them under those directories, so these
# rules only catch a local or manual run at the repository root.
checksums.sha256
sbom-packages.json

# Elevated-UI verification captures. scripts/capture_layout_matrix.ps1 and the
# PrintWindow recipe can be pointed at an in-repo directory; the documented default
# lives outside the repo, so this is a backstop rather than the primary location.
nav-shots*/
nav-shots*/**
