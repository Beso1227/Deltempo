# ==============================================================================
# Build & Output Artifacts (.NET / C# / MSBuild)
# ==============================================================================
bin/
obj/
publish/
publish_*/
dist/
# The release workflow emits per-architecture and per-target staging directories
# alongside dist/ - dist_arm64\, dist_cli\, dist_cli_arm64\ are produced by the same
# build_release_exe.ps1 run. `dist/` does NOT match those siblings, and they were
# invisible to git purely by accident: every file inside them happened to match
# *.exe or *.pdb. Release output is not consistent about that - dist/ already
# contains a checksums.sha256, so the moment a non-binary lands in a sibling the
# whole directory surfaces as untracked and a `git add -A` commits the binaries.
dist_*/
TestResults/
[Bb]uildLog.*
*.binlog
*.old

# Compiled Binaries, Libraries & Symbols
*.exe
*.dll
*.pdb
*.old
*.com
*.so
*.dylib
*.msi
*.msix
*.appx

# NuGet Packages & Restores
*.nupkg
*.snupkg
project.lock.json
project.assets.json

# MSBuild incremental state. Normally under obj/, but a custom
# BaseIntermediateOutputPath drops these at the project root, where the
# bin//obj rules above do not reach them.
*.tsbuildinfo

# Alternate build output, used when bin\ is locked by a running process and MSBuild
# cannot overwrite it: dotnet build -p:BaseOutputPath=altout\
altout/
altoutcli/
**/altout/
**/altoutcli/

# Sidecar config emitted next to a built executable. `*.exe` does not match
# "app.exe.config", so without this the file leaks even though the exe is ignored.
*.exe.config

# Archives & Compressed Files
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.rar
*.cab

