# ==============================================================================
# Build & Output Artifacts (.NET / C# / MSBuild)
# ==============================================================================
bin/
obj/
publish/
publish_*/
dist/
TestResults/
[Bb]uildLog.*
*.binlog
*.old

# Compiled Binaries, Libraries & Symbols
*.exe
*.dll
*.pdb
*.old
*.com
*.so
*.dylib
*.msi
*.msix
*.appx

# NuGet Packages & Restores
*.nupkg
*.snupkg
project.lock.json
project.assets.json

# MSBuild incremental state. Normally under obj/, but a custom
# BaseIntermediateOutputPath drops these at the project root, where the
# bin//obj rules above do not reach them.
*.tsbuildinfo

# Alternate build output, used when bin\ is locked by a running process and MSBuild
# cannot overwrite it: dotnet build -p:BaseOutputPath=altout\
altout/
altoutcli/
**/altout/
**/altoutcli/

# Sidecar config emitted next to a built executable. `*.exe` does not match
# "app.exe.config", so without this the file leaks even though the exe is ignored.
*.exe.config

# Archives & Compressed Files
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.rar
*.cab

# ==============================================================================
# Secrets, Certificates & Environment Variables
# ==============================================================================
*.cer
*.pfx
*.pem
*.key
*.p12
*.crt
*.der
*.snk
*.kdbx
*.credentials
credentials.json
*.token
# GitHub Personal Access Token — local only, never commit, never share.
# Usage: $env:GITHUB_TOKEN = (Get-Content .\github.token -Raw).Trim()
github.token
secrets.json
appsettings*.local.json
appsettings.Development.json
.env
.env.*
*.env
!*.env.example
!*.env.template

