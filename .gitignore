credentials.json
*.token
# GitHub Personal Access Token — local only, never commit, never share.
# Usage: $env:GITHUB_TOKEN = (Get-Content .\github.token -Raw).Trim()
github.token
secrets.json
appsettings*.local.json
appsettings.Development.json
.env
.env.*
*.env
!*.env.example
!*.env.template

