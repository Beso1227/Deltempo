*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.opendb
*.VC.db
.vs/
UpgradeLog*.XML
UpgradeLog*.htm
_UpgradeReport_Files/

# JetBrains Rider / Resharper
.idea/
*.DotSettings.user
_ReSharper*/
*.rsuser

# Visual Studio Code (track shared config, ignore user scratch)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Generic Editor Buffers & Backups
*.swp
*.lock
*.bak
*.orig
*.rej
*~

