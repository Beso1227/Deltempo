{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/deltempo.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build:release",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/deltempo.sln",
        "-c",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/deltempo.sln",
        "-c",
        "Release",
        "--logger",
        "console;verbosity=normal"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/deltempo.sln"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch:gui",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/WinTempCleaner.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch:cli",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/Cli/Deltempo.Cli.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "format:verify",
      "command": "dotnet",
      "type": "process",
      "args": [
        "format",
        "${workspaceFolder}/deltempo.sln",
        "--verify-no-changes",
        "--no-restore"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "format:fix",
      "command": "dotnet",
      "type": "process",
      "args": [
        "format",
        "${workspaceFolder}/deltempo.sln"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish:gui",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/WinTempCleaner.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "true",
        "-p:PublishSingleFile=true"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish:cli",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/Cli/Deltempo.Cli.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "true",
        "-p:PublishSingleFile=true"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}