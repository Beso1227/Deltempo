<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>WinTempCleaner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Services\**\*.cs" Link="Services\%(RecursiveDir)%(FileName)%(Extension)" />
    <Compile Include="..\Models\**\*.cs" Link="Models\%(RecursiveDir)%(FileName)%(Extension)" />
    <Compile Include="..\ViewModels\**\*.cs" Link="ViewModels\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>

  <!--
    Core compiles Services\SoundService.cs, so it needs its own copy of the
    interface sounds. SoundService resolves them against its own assembly, and the
    LogicalName matches the copy in the GUI project exactly.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\Assets\Sounds\click.wav">
      <LogicalName>WinTempCleaner.Assets.Sounds.click.wav</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\Sounds\success.wav">
      <LogicalName>WinTempCleaner.Assets.Sounds.success.wav</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\Sounds\error.wav">
      <LogicalName>WinTempCleaner.Assets.Sounds.error.wav</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Assets\Sounds\warning.wav">
      <LogicalName>WinTempCleaner.Assets.Sounds.warning.wav</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Phase 4: pin the .NET analyzer set to an explicit version via CPM so results are
       reproducible across SDKs. CA rules stay at the default (recommended) level - see the
       analyzer governance note in Directory.Build.props for why latest-all is not enabled. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deltempo" />
    <InternalsVisibleTo Include="deltempo_cli" />
    <InternalsVisibleTo Include="Deltempo.Tests" />
  </ItemGroup>

</Project>
