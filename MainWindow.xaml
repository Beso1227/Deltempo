<Window x:Class="WinTempCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinTempCleaner"
        mc:Ignorable="d"
        Title="Deltempo"
        Icon="app.ico"
        Height="840" Width="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        KeyDown="Window_KeyDown"
        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
        AutomationProperties.Name="Deltempo"
        FontFamily="{DynamicResource AppFont}">

    <!-- Master Shell Container with Deep Ambient Shadow -->
    <Border x:Name="MasterShellBorder"
            Background="{DynamicResource CanvasDarkBrush}"
            BorderBrush="{DynamicResource HairlineBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.35"/>
        </Border.Effect>

        <!-- Inner Concentric Clipping Shell to guarantee flawless bottom rounding -->
        <Border CornerRadius="19" ClipToBounds="True" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Seamless Header / Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- 1: Double-Bezel Hero & Drive Telemetry -->
                    <RowDefinition Height="Auto"/> <!-- 2: Unified Command, Search & Filter Strip -->
                    <RowDefinition Height="*"/>    <!-- 3: Cleanable Category Cards -->
                    <RowDefinition Height="Auto"/> <!-- 4: Bottom Floating Action Dock -->
                    <RowDefinition Height="Auto"/> <!-- 5: Collapsible Log Stream -->
                </Grid.RowDefinitions>

                <!-- 0. SEAMLESS HEADER / TITLE BAR -->
                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderDockBrush}"
                        CornerRadius="19,19,0,0"
                        Padding="16,10"
                        MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Identity -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32"
                                CornerRadius="8"
                                Margin="0,0,10,0"
                                ClipToBounds="True"
                                Background="{DynamicResource SurfaceCardBrush}"
                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00E5FF" Opacity="0.4"/>
                            </Border.Effect>
                            <Image Source="app_icon.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Margin="2"
                                   AutomationProperties.Name="Deltempo Logo"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Deltempo"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextHighBrush}"/>
                                <Border BorderBrush="#2600E5FF"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2200E5FF" Offset="0"/>
                                            <GradientStop Color="#158B5CF6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock x:Name="AppVersionHeaderBadge"
                                               Text="v1.3.3"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#00E5FF"
                                               RenderOptions.ClearTypeHint="Enabled"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="BrandSubtitleText"
                                       Text="Windows Cleaner &amp; Memory Optimizer"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,1.5,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Structured Performance Tools Segmented Island -->
                    <Border Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceSubCardBrush}"
                            BorderBrush="{DynamicResource HairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ToolStartupBtn"
                                    Style="{DynamicResource HeaderToolButton}"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="Startup Apps Boot Accelerator"
                                    Click="OpenStartupModal_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7B5;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource ElectricCyanBrush}"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Startup"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ToolLargeFilesBtn"
                                    Style="{DynamicResource HeaderToolButton}"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="Large File &amp; Storage Hog Hunter"
                                    Click="OpenLargeFilesModal_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource ElectricCyanBrush}"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Large Files"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ToolProcessesBtn"
                                    Style="{DynamicResource HeaderToolButton}"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="Memory Hogs &amp; Background App Optimizer"
                                    Margin="0"
                                    Click="OpenProcessModal_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE9F5;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource ElectricCyanBrush}"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Processes"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right: Dedicated Admin Status & Quick Preferences Pod -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Dedicated Admin Elevation Status Capsule -->
                        <Button x:Name="AdminElevationButton"
                                FocusVisualStyle="{x:Null}"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0,0,8,0"
                                Height="24"
                                VerticalAlignment="Center"
                                Click="AdminElevationButton_Click"
                                ToolTip="Status of Administrator Privileges (Click to Elevate)"
                                AutomationProperties.Name="Administrator Privileges Status">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.82"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Opacity" Value="0.65"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Border x:Name="AdminBadgeBorder"
                                    Background="#142B20"
                                    BorderBrush="#3D10B981"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Height="24"
                                    Padding="8,0,9,0"
                                    SnapsToDevicePixels="True"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="AdminBadgeIcon"
                                               Text="&#xE73E;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="10"
                                               Foreground="#10B981"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AdminBadgeText"
                                               Text="Admin"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#34D399"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Quick Preferences Pod -->
                        <Border Background="{DynamicResource SurfaceSubCardBrush}"
                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="3,2"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Language Selector Pill -->
                                <ComboBox x:Name="LanguageComboBox"
                                          Style="{DynamicResource ModernComboBox}"
                                          Width="72" Height="24"
                                          FocusVisualStyle="{x:Null}"
                                          AutomationProperties.Name="Select Application Language"
                                          Margin="0"
                                          SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Style="{DynamicResource ModernComboBoxItem}" Content="🇺🇸 EN" IsSelected="True" Tag="en"/>
                                    <ComboBoxItem Style="{DynamicResource ModernComboBoxItem}" Content="🇸🇦 AR" Tag="ar"/>
                                    <ComboBoxItem Style="{DynamicResource ModernComboBoxItem}" Content="🇪🇸 ES" Tag="es"/>
                                    <ComboBoxItem Style="{DynamicResource ModernComboBoxItem}" Content="🇫🇷 FR" Tag="fr"/>
                                    <ComboBoxItem Style="{DynamicResource ModernComboBoxItem}" Content="🇩🇪 DE" Tag="de"/>
                                </ComboBox>

                                <!-- Subtle Vertical Separator -->
                                <Border Width="1" Height="14"
                                        Background="{DynamicResource HairlineBorderBrush}"
                                        Margin="4,0"/>

                                <!-- Sound FX Toggle -->
                                <Button x:Name="SoundToggleBtn"
                                        Style="{DynamicResource WindowControlButton}"
                                        Width="25" Height="24"
                                        FocusVisualStyle="{x:Null}"
                                        AutomationProperties.Name="Toggle Haptic Sound Effects"
                                        ToolTip="Toggle Haptic Audio Feedback"
                                        Margin="0,0,1,0"
                                        Click="SoundToggleBtn_Click">
                                    <TextBlock x:Name="SoundToggleIcon"
                                               Text="&#xE767;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource ElectricCyanBrush}"/>
                                </Button>

                                <!-- Theme Mode Toggle (Sun/Moon) -->
                                <Button x:Name="ThemeToggleBtn"
                                        Style="{DynamicResource WindowControlButton}"
                                        Width="25" Height="24"
                                        FocusVisualStyle="{x:Null}"
                                        AutomationProperties.Name="Toggle Dark / Light Theme"
                                        ToolTip="Toggle Light / Dark Mode"
                                        Margin="0,0,1,0"
                                        Click="ThemeToggleBtn_Click">
                                    <TextBlock x:Name="ThemeToggleIcon"
                                               Text="&#xE708;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource ElectricCyanBrush}"/>
                                </Button>

                                <!-- Settings Button -->
                                <Button x:Name="SettingsBtn"
                                        Style="{DynamicResource WindowControlButton}"
                                        Width="25" Height="24"
                                        FocusVisualStyle="{x:Null}"
                                        AutomationProperties.Name="Open Application Settings"
                                        ToolTip="Deltempo Preferences &amp; Guardian Settings"
                                        Margin="0"
                                        Click="SettingsBtn_Click">
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource ElectricCyanBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Window Min / Close Controls -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource WindowControlButton}"
                                    Content="&#xE921;"
                                    Width="28" Height="26"
                                    Margin="0,0,2,0"
                                    FocusVisualStyle="{x:Null}"
                                    AutomationProperties.Name="Minimize Window"
                                    Click="MinimizeButton_Click"/>
                            <Button Style="{DynamicResource WindowCloseButton}"
                                    Content="&#xE8BB;"
                                    Width="28" Height="26"
                                    FocusVisualStyle="{x:Null}"
                                    AutomationProperties.Name="Close Application"
                                    Click="CloseButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. DOUBLE-BEZEL HERO & DRIVE TELEMETRY -->
            <Border Grid.Row="1"
                    Background="{DynamicResource DoubleBezelOuterBrush}"
                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Margin="18,10,18,6"
                    Padding="2">
                <!-- Inner Core Card -->
                <Border Background="{DynamicResource DoubleBezelInnerBrush}"
                        CornerRadius="14"
                        Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Reclaimable Space -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeroHeaderLabel"
                                       Text="RECLAIMABLE JUNK &amp; APPDATA"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ElectricCyanBrush}"
                                       Opacity="0.9"/>
                            <TextBlock x:Name="HeroSizeText"
                                       Text="0.0 MB"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextHighBrush}"
                                       Margin="0,1,0,2"
                                       AutomationProperties.Name="Total Reclaimable Space"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="HeroSubtext"
                                       Text="Deep scan of User Profile, GPU Shaders, AppData &amp; System Temp"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMediumBrush}"/>

                            <!-- 1-Click Autonomous Deep Clean Action Bar -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="HeroOneClickDeepCleanBtn"
                                        Style="{DynamicResource HeroCTAButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        Padding="15,6.5"
                                        ToolTip="Autonomous 1-Click Deep Clean: purges all safe disk caches, superseded Windows updates, old restore points &amp; flushes RAM in 1 click"
                                        Click="HeroOneClickDeepCleanBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7E8;"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="12"
                                                   Foreground="#FFFFFF"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HeroOneClickBtnText"
                                                   Text="⚡ 1-Click Deep Clean"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="HeroRescanBtn"
                                        Style="{DynamicResource PillButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        Padding="12,6"
                                        Margin="8,0,0,0"
                                        ToolTip="Rescan all categories and update storage metrics (F5)"
                                        Click="ScanButton_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource ElectricCyanBrush}"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HeroRescanBtnText"
                                                   Text="Quick Rescan"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Dual Drive C: & RAM Telemetry Cards -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="270">
                            <!-- Drive C: Card -->
                            <Border Background="{DynamicResource SurfaceSubCardBrush}"
                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,8"
                                    Margin="0,0,0,5"
                                    AutomationProperties.Name="System Drive Storage Telemetry">
                                <StackPanel>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7F4;"
                                                       FontFamily="{DynamicResource IconFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentBlueBrush}"
                                                       Margin="0,0,5,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DriveTelemetryLabel"
                                                       Text="OS Drive (C:)"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextHighBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="DriveTelemetryPercentage"
                                                       Text="-- Free"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource ElectricCyanBrush}"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.LiveSetting="Polite"/>
                                            <Button Style="{DynamicResource PillButton}"
                                                    FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                                    Padding="8,2.5"
                                                    ToolTip="Scan Drive for AI-categorized Large Files"
                                                    Click="OpenLargeFilesModal_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8B7;"
                                                               FontFamily="{DynamicResource IconFont}"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource ElectricCyanBrush}"
                                                               Margin="0,0,4,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="Large Files"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ElectricCyanBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="5" CornerRadius="2.5" Background="{DynamicResource TrackBgBrush}" ClipToBounds="True" Margin="0,0,0,3">
                                        <ProgressBar x:Name="DriveUsageBar"
                                                     Height="5"
                                                     Minimum="0" Maximum="100"
                                                     Value="50"
                                                     Foreground="{DynamicResource BrandHeroGradientBrush}"
                                                     Background="Transparent"
                                                     BorderThickness="0"/>
                                    </Border>
                                    <TextBlock x:Name="DriveTelemetryDetails"
                                               Text="Calculating disk space..."
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMediumBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- RAM Telemetry & Quick Optimizer Card -->
                            <Border Background="{DynamicResource SurfaceSubCardBrush}"
                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,8"
                                    AutomationProperties.Name="System Memory RAM Telemetry">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE950;"
                                                       FontFamily="{DynamicResource IconFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ElectricCyanBrush}"
                                                       Margin="0,0,5,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="RAM Memory"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextHighBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="HeroRamPercentText"
                                                       Text="--%"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource ElectricCyanBrush}"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <Button Style="{DynamicResource PillButton}"
                                                    FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                                    Padding="8,2.5"
                                                    ToolTip="Open Deep Kernel Memory &amp; Cache Cleaner"
                                                    Click="OpenMemoryCleanerModal_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE950;" FontFamily="{DynamicResource IconFont}" FontSize="9.5" Foreground="{DynamicResource ElectricCyanBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="RAM Cleaner" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ElectricCyanBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="5" CornerRadius="2.5" Background="{DynamicResource TrackBgBrush}" ClipToBounds="True" Margin="0,0,0,4">
                                        <ProgressBar x:Name="HeroRamProgressBar"
                                                     Height="5"
                                                     Minimum="0" Maximum="100"
                                                     Value="50"
                                                     Foreground="{DynamicResource BrandHeroGradientBrush}"
                                                     Background="Transparent"
                                                     BorderThickness="0"/>
                                    </Border>
                                    <Grid>
                                        <TextBlock x:Name="HeroRamDetailText"
                                                   Text="Reading RAM telemetry..."
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMediumBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="HeroBoostRamBtn"
                                                Content="⚡ Quick Boost"
                                                Style="{DynamicResource PillButton}"
                                                FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                                Padding="8,2"
                                                FontSize="9.5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Click="HeroBoostRamBtn_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- 2. UNIFIED SCOPE EXPLORER & QUICK SELECTION STRIP -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceSubCardBrush}"
                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="18,4,18,8"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Tier 1: Category Filter Chips & Search -->
                        <RowDefinition Height="Auto"/> <!-- Tier 2: Selection Intelligence & Rescan Action -->
                    </Grid.RowDefinitions>

                    <!-- TIER 1: CATEGORY FILTER TABS & SEARCH INPUT -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <!-- Category Filter Chips -->
                            <ColumnDefinition Width="*"/>
                            <!-- Search Box -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category Filter Chips (Left) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="FilterAllRadio" Content="🌐 All" Style="{DynamicResource FilterChipRadio}" IsChecked="True" Checked="FilterChip_Checked" Tag="ALL"/>
                            <RadioButton x:Name="FilterSafeRadio" Content="🟢 Safe" Style="{DynamicResource FilterChipRadio}" Checked="FilterChip_Checked" Tag="SAFE"/>
                            <RadioButton x:Name="FilterDriversRadio" Content="⚙️ Drivers &amp; System" Style="{DynamicResource FilterChipRadio}" Checked="FilterChip_Checked" Tag="SYSTEM"/>
                            <RadioButton x:Name="FilterGamingRadio" Content="🎮 Gaming" Style="{DynamicResource FilterChipRadio}" Checked="FilterChip_Checked" Tag="GAMING"/>
                            <RadioButton x:Name="FilterMediaRadio" Content="📱 Media &amp; Apps" Style="{DynamicResource FilterChipRadio}" Checked="FilterChip_Checked" Tag="MEDIA"/>
                        </StackPanel>

                        <!-- Search Input (Right) -->
                        <Border Grid.Column="1"
                                Width="220" Height="30"
                                Background="{DynamicResource SurfaceCardBrush}"
                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,0"
                                VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="CategorySearchBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextHighBrush}"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         TextChanged="CategorySearchBox_TextChanged"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="SearchPlaceholderText"
                                           Text="Search 25+ scopes..."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Opacity="0.7"/>
                                <Button Grid.Column="2"
                                        x:Name="ClearSearchBtn"
                                        Content="&#xE711;"
                                        Style="{DynamicResource WindowControlButton}"
                                        Width="16" Height="16"
                                        FontSize="8"
                                        Visibility="Collapsed"
                                        Click="ClearSearchBtn_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TIER 2: SELECTION COMMAND BAR & RESCAN -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource HairlineBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Left: Active Scopes Telemetry -->
                                <ColumnDefinition Width="*"/>
                                <!-- Right: Selection Pod & Rescan -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Active Scope Indicator -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource SurfaceCardBrush}"
                                        BorderBrush="{DynamicResource HairlineBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="7,2"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="25+ DEEP SCOPES"
                                               FontSize="9.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ElectricCyanBrush}"/>
                                </Border>
                                <TextBlock Text="Select target scopes for precision system &amp; profile purge"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Right: Selection Pill Pod & Rescan Action -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Connected Select Segment -->
                                <Border Background="{DynamicResource SurfaceCardBrush}"
                                        BorderBrush="{DynamicResource HairlineBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="2"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SelectSafeBtn"
                                                Style="{DynamicResource PillButton}"
                                                FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                                ToolTip="Select 100% safe junk targets"
                                                Padding="9,3.5"
                                                FontSize="10.5"
                                                Margin="0,0,2,0"
                                                Click="SelectSafeOnlyButton_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE73E;"
                                                           FontFamily="{DynamicResource IconFont}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource EmeraldGreenBrush}"
                                                           Margin="0,0,4,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SelectSafeBtnText"
                                                           Text="Safe"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="SelectAllBtn"
                                                Content="All"
                                                Style="{DynamicResource PillButton}"
                                                FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                                ToolTip="Select all 25+ scopes"
                                                Padding="9,3.5"
                                                FontSize="10.5"
                                                Margin="0,0,2,0"
                                                Click="SelectAllButton_Click"/>

                                        <Button x:Name="ClearBtn"
                                                Content="None"
                                                Style="{DynamicResource PillButton}"
                                                FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                                ToolTip="Deselect all scopes"
                                                Padding="9,3.5"
                                                FontSize="10.5"
                                                Click="DeselectAllButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- 1-Click Smart Clean Action Pill -->
                                <Button x:Name="SmartCleanBtn"
                                        Style="{DynamicResource PillButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        ToolTip="1-Click Smart Clean: Selects 100% safe junk targets and cleans immediately"
                                        Padding="11,4.5"
                                        FontSize="10.5"
                                        Margin="0,0,6,0"
                                        Click="SmartCleanButton_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE945;"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource EmeraldGreenBrush}"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SmartCleanBtnText"
                                                   Text="Smart Clean"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Rescan Action Pill -->
                                <Button x:Name="QuickScanBtn"
                                        Style="{DynamicResource PillButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        ToolTip="Rescan all categories (F5)"
                                        Padding="11,4.5"
                                        FontSize="10.5"
                                        Click="ScanButton_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource ElectricCyanBrush}"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="QuickScanBtnText"
                                                   Text="Rescan"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. CLEANABLE CATEGORY CARDS (SCROLLABLE BENTO LIST) -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="18,0,18,6">
                <ItemsControl x:Name="TargetCardsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource ModernCard}"
                                    Margin="0,0,0,8"
                                    Padding="14,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Switch Checkbox -->
                                        <ColumnDefinition Width="Auto"/> <!-- Category Glyph Orb -->
                                        <ColumnDefinition Width="*"/>    <!-- Category Info -->
                                        <ColumnDefinition Width="Auto"/> <!-- Size, Stats & Inspect -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Switch Toggle -->
                                    <CheckBox Grid.Column="0"
                                              Style="{DynamicResource ModernSwitchCheckBox}"
                                              FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                              AutomationProperties.Name="{Binding Name}"
                                              AutomationProperties.HelpText="{Binding Description}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              Checked="TargetCheckBox_Changed"
                                              Unchecked="TargetCheckBox_Changed"/>

                                    <!-- Category Glyph Orb -->
                                    <Border Grid.Column="1"
                                            Width="38" Height="38"
                                            CornerRadius="10"
                                            Background="{DynamicResource SurfaceSubCardBrush}"
                                            BorderBrush="{DynamicResource HairlineBorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="17"
                                                   Foreground="{Binding CategoryColor}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Category Title, Safety Badge & Path -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextHighBrush}"/>

                                            <!-- Category Badge -->
                                            <Border Background="{DynamicResource SurfaceCardHoverBrush}"
                                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding CategoryColor}"/>
                                            </Border>

                                            <!-- Safety Badge -->
                                            <Border Background="{DynamicResource SafetyBadgeBgBrush}"
                                                    BorderBrush="{DynamicResource SafetyBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SafetyBadge}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SafetyBadgeTextBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMediumBrush}"
                                                   Margin="0,2,0,2"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding FolderPath}"
                                                   FontSize="10"
                                                   FontFamily="{DynamicResource MonospaceFont}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Size & Action Tag -->
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedSize}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextHighBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding FormattedStats}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,1,0,3"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusMessage}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource ElectricCyanBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>

                                            <Button Style="{DynamicResource PillButton}"
                                                    FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                                    AutomationProperties.Name="Inspect Large Files"
                                                    Padding="8,2"
                                                    FontSize="10"
                                                    Tag="{Binding}"
                                                    Click="InspectTarget_Click"
                                                    Visibility="{Binding HasTopFiles, Converter={StaticResource BoolToVisConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE721;"
                                                               FontFamily="{DynamicResource IconFont}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource ElectricCyanBrush}"
                                                               Margin="0,0,4,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="Inspect"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 4. BOTTOM FLOATING ACTION DOCK -->
            <Border x:Name="BottomActionDockBorder"
                    Grid.Row="4"
                    Background="{DynamicResource HeaderDockBrush}"
                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,19,19"
                    Padding="18,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Progress Bar & Status -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ProgressStatusText"
                                       Text="Ready for precision cleanup"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMediumBrush}"
                                       Margin="0,0,0,4"
                                       AutomationProperties.Name="Operation Status"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource TrackBgBrush}" ClipToBounds="True">
                                <ProgressBar x:Name="AppProgressBar"
                                             Height="5"
                                             Minimum="0" Maximum="100"
                                             Value="0"
                                             Foreground="{DynamicResource BrandHeroGradientBrush}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             AutomationProperties.Name="Cleanup Progress"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   x:Name="ProgressPercentageText"
                                   Text="0%"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextHighBrush}"
                                   VerticalAlignment="Center"
                                   Margin="14,8,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </Grid>

                    <!-- 3-Pillar Action Dock -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Pillar 1: Safety Shield (Left) -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Spacing / Center -->
                            <ColumnDefinition Width="*"/>
                            <!-- Pillar 2: Utility Tools (Center) -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Spacing / Center -->
                            <ColumnDefinition Width="*"/>
                            <!-- Pillar 3: Primary Action Execution (Right) -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pillar 1: Dedicated Safety Shield Capsule -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource SurfaceSubCardBrush}"
                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="SafeModeCheckBox"
                                          Style="{DynamicResource ModernSwitchCheckBox}"
                                          FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                          AutomationProperties.Name="Safety Shield Filter"
                                          AutomationProperties.HelpText="Protects files created or modified within the last 24 hours"
                                          IsChecked="False"
                                          VerticalAlignment="Center"
                                          Margin="0,0,7,0"
                                          Checked="SafeModeCheckBox_Changed"
                                          Unchecked="SafeModeCheckBox_Changed"/>
                                <TextBlock Text="&#xE72A;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource EmeraldGreenBrush}"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="SafeModeLabelText"
                                           Text="Safety Shield (>24h)"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextHighBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Pillar 2: Diagnostics & Audit Pod (Activity Log & Audit Report) -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource SurfaceSubCardBrush}"
                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ToggleLogBtn"
                                        Style="{DynamicResource HeaderToolButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        AutomationProperties.Name="Toggle Activity Log Stream"
                                        Padding="10,4"
                                        Margin="0,0,2,0"
                                        Click="ToggleLogBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="ToggleLogIcon"
                                                   Text="&#xE756;"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource ElectricCyanBrush}"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ToggleLogText"
                                                   Text="Activity Log"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ExportReportBtn"
                                        Style="{DynamicResource HeaderToolButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        AutomationProperties.Name="Export Cleanup Audit Report"
                                        Padding="10,4"
                                        Click="ExportAuditReport_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8A5;"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource ElectricCyanBrush}"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ExportReportBtnText"
                                                   Text="Audit Report"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Pillar 3: Primary Action Execution Group -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Style="{DynamicResource PillButton}"
                                    FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Cancel Active Operation"
                                    Padding="14,7"
                                    Margin="0,0,8,0"
                                    Click="CancelButton_Click"
                                    Visibility="Collapsed"/>

                            <Button x:Name="FooterOneClickBtn"
                                    Style="{DynamicResource PillButton}"
                                    FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                    ToolTip="1-Click Autonomous Deep Clean (All 26 Scopes, DISM &amp; RAM)"
                                    Padding="13,8.5"
                                    Margin="0,0,8,0"
                                    Click="HeroOneClickDeepCleanBtn_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7E8;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource ElectricCyanBrush}"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="⚡ 1-Click Deep Clean"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextHighBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="CleanButton"
                                    Style="{DynamicResource HeroCTAButton}"
                                    FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Clean Selected Items"
                                    AutomationProperties.HelpText="Shortcut: Ctrl+Enter"
                                    Padding="20,8.5"
                                    Click="CleanButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74D;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="13.5"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CleanButtonText"
                                               Text="Clean Selected (0.0 MB)"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 5. COLLAPSIBLE LOG STREAM -->
            <Border Grid.Row="5"
                    x:Name="LogDrawerBorder"
                    Background="{DynamicResource SurfaceSubCardBrush}"
                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,20,20"
                    MaxHeight="150"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Activity Log Drawer">
                <Grid Margin="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE81C;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource ElectricCyanBrush}"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVITY LOG STREAM"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextHighBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Copy"
                                    Style="{DynamicResource PillButton}"
                                    FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Copy Log to Clipboard"
                                    Padding="8,2"
                                    FontSize="10"
                                    Margin="0,0,4,0"
                                    Click="CopyLogButton_Click"/>
                            <Button Content="Clear"
                                    Style="{DynamicResource PillButton}"
                                    FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Clear Activity Log"
                                    Padding="8,2"
                                    FontSize="10"
                                    Click="ClearLogButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  x:Name="LogScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LogItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FormattedTime}"
                                                   FontFamily="{DynamicResource MonospaceFont}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextMediumBrush}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Top"/>

                                        <TextBlock x:Name="LogGlyphText"
                                                   Grid.Column="1"
                                                   Text="{Binding LevelGlyph}"
                                                   FontFamily="{DynamicResource MonospaceFont}"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource ElectricCyanBrush}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Top"/>

                                        <TextBlock x:Name="LogMessageText"
                                                   Grid.Column="2"
                                                   Text="{Binding Message}"
                                                   FontFamily="{DynamicResource MonospaceFont}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextHighBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                            <Setter TargetName="LogGlyphText" Property="Foreground" Value="{DynamicResource EmeraldGreenBrush}"/>
                                            <Setter TargetName="LogMessageText" Property="Foreground" Value="{DynamicResource EmeraldGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter TargetName="LogGlyphText" Property="Foreground" Value="{DynamicResource AmberWarningBrush}"/>
                                            <Setter TargetName="LogMessageText" Property="Foreground" Value="{DynamicResource AmberWarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                            <Setter TargetName="LogGlyphText" Property="Foreground" Value="{DynamicResource RoseErrorBrush}"/>
                                            <Setter TargetName="LogMessageText" Property="Foreground" Value="{DynamicResource RoseErrorBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Info">
                                            <Setter TargetName="LogGlyphText" Property="Foreground" Value="{DynamicResource ElectricCyanBrush}"/>
                                            <Setter TargetName="LogMessageText" Property="Foreground" Value="{DynamicResource TextHighBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 6. TOP FILES INSPECTOR OVERLAY MODAL -->
            <Grid Grid.RowSpan="6"
                  x:Name="InspectorModalOverlay"
                  Background="{DynamicResource ModalBackdropBrush}"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Large Files Inspector Dialog">
                <Border Style="{DynamicResource ModernCard}"
                        Width="660" Height="500"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ModalSurfaceBrush}"
                        BorderBrush="{DynamicResource ElectricCyanBrush}"
                        BorderThickness="1.5">
                    <Grid>
                        <Grid.RowDefinitions>
                             <RowDefinition Height="Auto"/><!-- Row 0: Header -->
                             <RowDefinition Height="Auto"/><!-- Row 1: Search & Refresh -->
                             <RowDefinition Height="*"/>   <!-- Row 2: List -->
                             <RowDefinition Height="Auto"/><!-- Row 3: Footer -->
                        </Grid.RowDefinitions>

                        <!-- Modal Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="InspectorTitleText"
                                           Text="Largest Junk Files Inspector"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextHighBrush}"/>
                                <TextBlock x:Name="InspectorSubtitleText"
                                           Text="Showing individual large files discovered in this category"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMediumBrush}"/>
                            </StackPanel>
                            <Button Style="{DynamicResource WindowCloseButton}"
                                    Content="&#xE8BB;"
                                    FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Close Inspector Dialog"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="CloseInspector_Click"/>
                        </Grid>

                        <!-- Items List -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource SurfaceSubCardBrush}"
                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="InspectorItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceCardBrush}"
                                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="0,0,0,6"
                                                    Padding="12,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextHighBrush}"/>
                                                        <TextBlock Text="{Binding FilePath}"
                                                                   FontSize="10"
                                                                   FontFamily="{DynamicResource MonospaceFont}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedSize}"
                                                                   FontSize="13.5"
                                                                   FontWeight="Bold"
