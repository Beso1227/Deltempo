                                        <ComboBox x:Name="LargeFileCategoryComboBox"
                                                  Style="{DynamicResource ModernComboBox}"
                                                  Width="150" Height="26"
                                                  SelectionChanged="LargeFileCategoryFilter_Changed">
                                            <ComboBoxItem Content="All Items" Tag="ALL"/>
                                            <ComboBoxItem Content="Safe to Delete Only" Tag="SAFE"/>
                                            <ComboBoxItem Content="Protected Files Only" Tag="RISK"/>
                                            <ComboBoxItem Content="Installers &amp; ISOs" Tag="Installer / ISO"/>
                                            <ComboBoxItem Content="Game Assets" Tag="Game Asset / Pak"/>
                                            <ComboBoxItem Content="Media &amp; Videos" Tag="Video / Media"/>
                                            <ComboBoxItem Content="Archives" Tag="Archive"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Rescan Button -->
                                    <Button Grid.Column="4"
                                            x:Name="RescanLargeFilesBtn"
                                            Style="{DynamicResource PillButton}"
                                            FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                            Padding="12,5"
                                            Click="RescanLargeFilesBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Scan Now" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Line 2: Smart AI Action & Selection Strip -->
                                <Border Background="{DynamicResource SurfaceCardHoverBrush}"
                                        BorderBrush="{DynamicResource HairlineBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="SelectSafeLargeFilesBtn"
                                                    Style="{DynamicResource PillButton}"
                                                    Padding="12,4"
                                                    FontSize="10.5"
                                                    FontWeight="Bold"
                                                    Margin="0,0,6,0"
                                                    Click="SelectSafeLargeFiles_Click"
                                                    ToolTip="Instantly select only verified 100% safe-to-delete installers, dumps, and old setup files with zero risk">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8E5;" FontFamily="{DynamicResource IconFont}" FontSize="11" Foreground="{DynamicResource EmeraldGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Select Safe Files" Foreground="{DynamicResource EmeraldGreenBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Content="Select All"
                                                    Style="{DynamicResource PillButton}"
                                                    Padding="8,3"
                                                    FontSize="10.5"
                                                    Margin="0,0,4,0"
                                                    Click="SelectAllLargeFiles_Click"/>
                                            <Button Content="Clear"
                                                    Style="{DynamicResource PillButton}"
                                                    Padding="8,3"
                                                    FontSize="10.5"
                                                    Click="ClearLargeFilesSelection_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LargeFilesSelectedSummaryText"
                                                   Text="Selected: 0 files (0 B)"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource ElectricCyanBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Row 3: Large Files List -->
                        <Border Grid.Row="3"
                                Background="{DynamicResource SurfaceSubCardBrush}"
                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,6"
                                Margin="0,0,0,10"
                                MinHeight="120"
                                MaxHeight="280">
                            <Grid>
                                <!-- File list -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LargeFilesItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceCardBrush}"
                                                        BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12,10"
                                                        Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/> <!-- Selection CheckBox -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Category Icon Pod -->
                                                            <ColumnDefinition Width="*"/>    <!-- File Details & AI Reasoning -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Formatted Size -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Reveal Button -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Recycle Button -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- CheckBox -->
                                                        <CheckBox Grid.Column="0"
                                                                  Style="{DynamicResource ModernSwitchCheckBox}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,12,0"
                                                                  Checked="LargeFileItem_CheckChanged"
                                                                  Unchecked="LargeFileItem_CheckChanged"/>

                                                        <!-- Category Icon Pod (Machined rounded square with vector icon) -->
                                                        <Border Grid.Column="1"
                                                                Width="38" Height="38"
                                                                CornerRadius="9"
                                                                Background="{DynamicResource SurfaceSubCardBrush}"
                                                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                                BorderThickness="1"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding CategoryIcon}"
                                                                       FontFamily="{DynamicResource IconFont}"
                                                                       FontSize="16"
                                                                       Foreground="{DynamicResource ElectricCyanBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- File Details & AI Reasoning -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <!-- Row 1: File Name + Category Badge + AI Safety Badge -->
                                                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,2">
                                                                <TextBlock Text="{Binding FileName}"
                                                                           FontSize="12.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextHighBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="380"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Category Badge -->
                                                                <Border Margin="8,0,0,0"
                                                                        Background="{DynamicResource SurfaceSubCardBrush}"
                                                                        BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="5"
                                                                        Padding="6,2"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextMediumBrush}"/>
                                                                </Border>

                                                                <!-- AI Safety Verdict Badge with dynamic dot & border -->
                                                                <Border Margin="6,0,0,0"
                                                                        Background="{Binding BadgeBackground}"
                                                                        BorderBrush="{Binding BadgeBorder}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="5"
                                                                        Padding="7,2"
                                                                        VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Ellipse Width="6" Height="6" Fill="{Binding AiBadgeColor}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding AiVerdict}" FontSize="9" FontWeight="Bold"
                                                                                   Foreground="{Binding AiBadgeColor}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </WrapPanel>

                                                            <!-- Row 2: File Path in clean Monospace -->
                                                            <TextBlock Text="{Binding FilePath}"
                                                                       FontSize="9.5"
                                                                       FontFamily="{DynamicResource MonospaceFont}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="500"
                                                                       Margin="0,1,0,3"/>

                                                            <!-- Row 3: AI Explanation & Origin Capsule -->
                                                            <Border Background="{DynamicResource SurfaceSubCardBrush}"
                                                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="8,5"
                                                                    HorizontalAlignment="Left"
                                                                    MaxWidth="510">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding AiOrigin}"
                                                                               FontSize="9.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource ElectricCyanBrush}"
                                                                               Margin="0,0,0,2"/>
                                                                    <TextBlock Text="{Binding AiExplanation}"
                                                                               FontSize="9.5"
                                                                               Foreground="{DynamicResource TextMediumBrush}"
                                                                               TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Formatted Size -->
                                                        <Border Grid.Column="3"
                                                                Background="{DynamicResource SurfaceSubCardBrush}"
                                                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10,4"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FormattedSize}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource ElectricCyanBrush}"/>
                                                        </Border>

                                                        <!-- Reveal in Explorer -->
                                                        <Button Grid.Column="4"
                                                                Style="{DynamicResource PillButton}"
                                                                FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                                                Padding="9,5"
                                                                Margin="0,0,6,0"
                                                                Click="RevealLargeFile_Click"
                                                                ToolTip="Show in File Explorer">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xED25;" FontFamily="{DynamicResource IconFont}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Reveal" FontSize="10.5" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Single Recycle -->
                                                        <Button Grid.Column="5"
                                                                Style="{DynamicResource PillButton}"
                                                                FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                                                Padding="9,5"
                                                                Click="RecycleLargeFile_Click"
                                                                ToolTip="Move to Windows Recycle Bin">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="11" Foreground="{DynamicResource DestructiveRedBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Recycle" FontSize="10.5" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Empty state — shown when scan returns 0 results or scan hasn't run yet -->
                                <StackPanel x:Name="LargeFilesEmptyState"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Visibility="Collapsed">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="36"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               Opacity="0.4"
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="LargeFilesEmptyStateTitle"
                                               Text="No large files found"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMediumBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="LargeFilesEmptyStateHint"
                                               Text="Try a different scope or lower the minimum file size."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 4: Footer Actions -->
                        <Grid Grid.Row="4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{DynamicResource PillButton}"
                                        Padding="11,6"
                                        Margin="0,0,10,0"
                                        Click="OpenRecycleBin_Click"
                                        ToolTip="Open Windows Recycle Bin to restore any recycled file">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open Recycle Bin" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="LargeFilesStatusText"
                                           Text="All files are safely recycled with 100% undo capability"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="RecycleSelectedLargeFilesBtn"
                                        Content="Recycle Selected (0 B)"
                                        Style="{DynamicResource HeroCTAButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        Padding="18,8"
                                        FontSize="11.5"
                                        FontWeight="Bold"
                                        Margin="0,0,8,0"
                                        IsEnabled="False"
                                        Click="RecycleSelectedLargeFiles_Click"/>
                                <Button Content="Close"
                                        Style="{DynamicResource PillButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        Padding="18,8"
                                        FontSize="11.5"
                                        Click="CloseLargeFilesModal_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 13. BACKGROUND PROCESS & MEMORY OPTIMIZER MODAL -->
            <Grid Grid.RowSpan="6"
                  x:Name="ProcessModalOverlay"
                  Background="{DynamicResource ModalBackdropBrush}"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Memory Hogs Dialog">
                <Border Width="600" MaxHeight="620"
                        Background="{DynamicResource ModalSurfaceBrush}"
                        BorderBrush="{DynamicResource ElectricCyanBrush}"
                        BorderThickness="1.5"
                        CornerRadius="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><!-- Row 0: Header -->
                            <RowDefinition Height="Auto"/><!-- Row 1: Search & Refresh -->
                            <RowDefinition Height="*"/>   <!-- Row 2: List -->
                            <RowDefinition Height="Auto"/><!-- Row 3: Footer -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38"
                                        CornerRadius="12"
                                        Background="{DynamicResource SurfaceSubCardBrush}"
                                        BorderBrush="{DynamicResource ElectricCyanBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="&#xE950;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="18"
                                               Foreground="{DynamicResource ElectricCyanBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🛑 Heavy Background Memory Apps"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextHighBrush}"/>
                                    <TextBlock Text="Trim working sets or safely close memory-heavy apps with SeDebug privilege"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMediumBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{DynamicResource WindowCloseButton}"
                                    Content="&#xE8BB;"
                                    FocusVisualStyle="{x:Null}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="CloseProcessModal_Click"/>
                        </Grid>

                        <!-- Search & Refresh Toolbar -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceSubCardBrush}"
                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,4"
                                    Height="28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="ProcessSearchBox"
                                             Grid.Column="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextHighBrush}"
                                             FontSize="11"
                                             VerticalAlignment="Center"
                                             TextChanged="ProcessSearchBox_TextChanged"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="ProcessSearchPlaceholder"
                                               Text="Search background apps by name or category..."
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Opacity="0.7"/>
                                </Grid>
                            </Border>
                            <Button Grid.Column="1"
                                    x:Name="RefreshProcessBtn"
                                    Style="{DynamicResource HeaderToolButton}"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="Refresh Active Processes"
                                    Margin="8,0,0,0"
                                    Height="28"
                                    Click="RefreshProcess_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ElectricCyanBrush}"
                                               Margin="0,0,4,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Process List -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource SurfaceSubCardBrush}"
                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,8"
                                Margin="0,0,0,12"
                                MaxHeight="380">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ProcessItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceCardBrush}"
                                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Category Icon Badge -->
                                                    <Border Grid.Column="0"
                                                            Width="32" Height="32"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource SurfaceSubCardBrush}"
                                                            BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                            BorderThickness="1"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CategoryIcon}"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- App Name & Dynamic Category Description -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextHighBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding CategoryDescription}"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextMediumBrush}"/>
                                                            <TextBlock Text=" • "
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding ProcessName}"
                                                                       FontSize="10"
                                                                       FontFamily="{DynamicResource MonospaceFont}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Reclaimable Working Set -->
                                                    <Border Grid.Column="2"
                                                            Background="{DynamicResource SurfaceSubCardBrush}"
                                                            BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,3"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedMemory}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource ElectricCyanBrush}"/>
                                                    </Border>

                                                    <!-- Actions -->
                                                    <Button Grid.Column="3"
                                                            Content="⚡ Trim RAM"
                                                            Style="{DynamicResource PillButton}"
                                                            FocusVisualStyle="{x:Null}"
                                                            Padding="8,4"
                                                            FontSize="10"
                                                            Margin="0,0,6,0"
                                                            Click="TrimProcessMemory_Click"/>
                                                    <Button Grid.Column="4"
                                                            Content="❌ End Task"
                                                            Style="{DynamicResource PillButton}"
                                                            FocusVisualStyle="{x:Null}"
                                                            Padding="8,4"
                                                            FontSize="10"
                                                            Click="TerminateProcess_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Footer Actions -->
                        <Grid Grid.Row="3">
                            <Button Content="⚡ Trim All Background Memory"
                                    Style="{DynamicResource PillButton}"
                                    FocusVisualStyle="{x:Null}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    FontSize="11"
                                    Click="TrimAllProcesses_Click"/>
                            <TextBlock x:Name="ProcessStatusSummaryText"
                                       Text=""
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Button Content="Done"
                                    Style="{DynamicResource HeroCTAButton}"
                                    FocusVisualStyle="{x:Null}"
                                    HorizontalAlignment="Right"
                                    Padding="22,7"
                                    FontSize="12"
                                    Click="CloseProcessModal_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- WINDOWS MEMORY CLEANER & STANDBY CACHE OPTIMIZER MODAL -->
            <Grid Grid.RowSpan="6"
                  x:Name="MemoryModalOverlay"
                  Visibility="Collapsed"
                  Background="{DynamicResource ModalBackdropBrush}">
            <Border Width="820" MaxHeight="680"
                    Background="{DynamicResource DoubleBezelOuterBrush}"
                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border Background="{DynamicResource ModalSurfaceBrush}"
                        CornerRadius="14"
                        Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 0: Header -->
                            <RowDefinition Height="Auto"/> <!-- 1: Telemetry Strip -->
                            <RowDefinition Height="Auto"/> <!-- 2: Selection Toolbar -->
                            <RowDefinition Height="*"/>    <!-- 3: Zones Bento List -->
                            <RowDefinition Height="Auto"/> <!-- 4: Footer -->
                        </Grid.RowDefinitions>

                        <!-- 0: Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40"
                                        CornerRadius="12"
                                        Background="{DynamicResource SurfaceSubCardBrush}"
                                        BorderBrush="{DynamicResource ElectricCyanBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="&#xE950;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="18"
                                               Foreground="{DynamicResource ElectricCyanBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Windows Memory Cleaner &amp; Standby Cache"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextHighBrush}"/>
                                    <TextBlock Text="Kernel-level Standby List, System File Cache &amp; Working Set Optimizer"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextMediumBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{DynamicResource WindowCloseButton}"
                                    Content="&#xE8BB;"
                                    FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="CloseMemoryCleanerModal_Click"/>
                        </Grid>

                        <!-- 1: Telemetry Strip (3 Concentric Double-Bezel Pods) -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pod 1: Physical RAM -->
                            <Border Grid.Column="0" Margin="0,0,6,0"
                                    Background="{DynamicResource SurfaceSubCardBrush}"
                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="TOTAL PHYSICAL RAM" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock x:Name="ModalTotalRamText" Text="16.0 GB" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextHighBrush}" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="ModalUsedRamText" Text="7.8 GB (49%) In Use" FontSize="10.5" Foreground="{DynamicResource ElectricCyanBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Pod 2: Reclaimable Standby & File Cache -->
                            <Border Grid.Column="1" Margin="3,0,3,0"
                                    Background="{DynamicResource SurfaceSubCardBrush}"
                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="RECLAIMABLE STANDBY CACHE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock x:Name="ModalStandbyCacheText" Text="4.2 GB" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessGlowBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="Cached inactive pages" FontSize="10.5" Foreground="{DynamicResource SuccessGlowBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Pod 3: Kernel Immunity Shield -->
                            <Border Grid.Column="2" Margin="6,0,0,0"
                                    Background="{DynamicResource SurfaceSubCardBrush}"
                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="KERNEL ISOLATION SHIELD" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="100% IMMUNE" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextHighBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="Windows, Explorer &amp; Security protected" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 2: Selection Toolbar -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Select All"
                                        Style="{DynamicResource PillButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        Padding="8,3"
                                        FontSize="10"
                                        Margin="0,0,6,0"
                                        Click="SelectAllMemoryZones_Click"/>
                                <Button Content="Deselect All"
                                        Style="{DynamicResource PillButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        Padding="8,3"
                                        FontSize="10"
                                        Click="DeselectAllMemoryZones_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="MemoryModalStatusText"
                                       Text="8 memory zones ready for privileged NT flush"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 3: Zones Bento List -->
                        <Border Grid.Row="3"
                                Background="{DynamicResource SurfaceSubCardBrush}"
                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,6"
                                Margin="0,0,0,12"
                                MaxHeight="330">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="MemoryAreaItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceCardBrush}"
                                                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                        <ColumnDefinition Width="*"/>    <!-- Details -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Badge -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Size -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Action -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- CheckBox -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0"/>

                                                    <!-- Icon pod -->
                                                    <Border Grid.Column="1"
                                                            Width="32" Height="32"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource SurfaceSubCardBrush}"
                                                            BorderBrush="{DynamicResource ElectricCyanBrush}"
                                                            BorderThickness="1"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IconGlyph}"
                                                                   FontFamily="{DynamicResource IconFont}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource ElectricCyanBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Zone Details -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextHighBrush}"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="360"
                                                                   Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <!-- Safety Badge -->
                                                    <Border Grid.Column="3"
                                                            Background="{DynamicResource SurfaceSubCardBrush}"
                                                            BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="7,2"
                                                            Margin="8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SafetyBadge}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource ElectricCyanBrush}"/>
                                                    </Border>

                                                    <!-- Estimated Cache / Usage Size -->
                                                    <Border Grid.Column="4"
                                                            Background="{DynamicResource SurfaceSubCardBrush}"
                                                            BorderBrush="{DynamicResource HairlineBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,3"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            MinWidth="70">
                                                        <TextBlock Text="{Binding FormattedCurrent}"
                                                                   FontSize="10.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextHighBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                    </Border>

                                                    <!-- Per-zone surgical flush button -->
                                                    <Button Grid.Column="5"
                                                            Content="⚡ Flush"
                                                            Tag="{Binding Target}"
                                                            Style="{DynamicResource PillButton}"
                                                            FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                                            Padding="10,4"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"
                                                            Click="PerAreaBoostButton_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- 4: Footer Actions -->
                        <Grid Grid.Row="4">
                            <Button Content="⚡ Quick Trim Working Sets"
                                    Style="{DynamicResource PillButton}"
                                    FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Padding="14,6"
                                    FontSize="11"
                                    Click="QuickTrimWorkingSets_Click"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="PurgeSelectedZonesBtn"
                                        Content="⚡ Purge Selected Zones"
                                        Style="{DynamicResource HeroCTAButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        Padding="18,7"
                                        FontSize="11.5"
                                        Margin="0,0,8,0"
                                        Click="PurgeSelectedZones_Click"/>
                                <Button Content="Close"
                                        Style="{DynamicResource PillButton}"
                                        FocusVisualStyle="{DynamicResource AccessibleFocusVisualStyle}"
                                        Padding="16,7"
                                        FontSize="11"
                                        Click="CloseMemoryCleanerModal_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Border>
</Border>
</Window>
