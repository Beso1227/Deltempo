<Window x:Class="WinTempCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinTempCleaner"
        mc:Ignorable="d"
        Title="Deltempo — Pure Precision Windows Cleaner"
        Icon="app_icon.png"
        Height="800" Width="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        KeyDown="Window_KeyDown"
        FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
        AutomationProperties.Name="Deltempo Windows &amp; User Profile Cleaner"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- Modal Entrance Storyboard -->
        <Storyboard x:Key="ModalEntranceStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuarticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Master Shell Container with Deep Ambient Shadow -->
    <Border Background="{StaticResource CanvasDarkBrush}"
            BorderBrush="{StaticResource HairlineBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Seamless Header / Title Bar -->
                <RowDefinition Height="Auto"/> <!-- 1: Double-Bezel Hero & Drive Telemetry -->
                <RowDefinition Height="Auto"/> <!-- 2: Minimalist Toolbar & Category Filters -->
                <RowDefinition Height="*"/>    <!-- 3: Cleanable Category Cards -->
                <RowDefinition Height="Auto"/> <!-- 4: Bottom Floating Action Dock -->
                <RowDefinition Height="Auto"/> <!-- 5: Collapsible Log Stream -->
            </Grid.RowDefinitions>

            <!-- 0. SEAMLESS HEADER / TITLE BAR -->
            <Border Grid.Row="0"
                    Background="#0D1017"
                    CornerRadius="20,20,0,0"
                    Padding="18,12"
                    MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Identity -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30"
                                CornerRadius="8"
                                Margin="0,0,12,0"
                                ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#00E5FF" Opacity="0.4"/>
                            </Border.Effect>
                            <Image Source="app_icon.png" 
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="Deltempo Logo"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Deltempo"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextHighBrush}"/>
                                <Border Background="#162032"
                                        BorderBrush="#1E2E48"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="6,1.5"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="KING EDITION"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource ElectricCyanBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Windows &amp; User Profile Guardian"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center / Right: Admin Status Pill + Sound Toggle + Language -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                        <!-- Sound FX Toggle -->
                        <Button x:Name="SoundToggleBtn"
                                Style="{StaticResource WindowControlButton}"
                                FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                AutomationProperties.Name="Toggle Haptic Sound Effects"
                                ToolTip="Toggle Haptic Audio Feedback"
                                Margin="0,0,8,0"
                                Click="SoundToggleBtn_Click">
                            <TextBlock x:Name="SoundToggleIcon"
                                       Text="&#xE767;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource ElectricCyanBrush}"/>
                        </Button>

                        <!-- Language Selector Pill -->
                        <ComboBox x:Name="LanguageComboBox"
                                  Style="{StaticResource ModernComboBox}"
                                  Width="88" Height="28"
                                  FocusVisualStyle="{x:Null}"
                                  AutomationProperties.Name="Select Application Language"
                                  Margin="0,0,10,0"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="🇺🇸 EN" IsSelected="True" Tag="en"/>
                            <ComboBoxItem Content="🇸🇦 AR" Tag="ar"/>
                            <ComboBoxItem Content="🇪🇸 ES" Tag="es"/>
                            <ComboBoxItem Content="🇫🇷 FR" Tag="fr"/>
                            <ComboBoxItem Content="🇩🇪 DE" Tag="de"/>
                        </ComboBox>

                        <!-- Admin Badge -->
                        <Border x:Name="AdminBadgeBorder"
                                Background="#10241B"
                                BorderBrush="#10B981"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Elevated Administrator Status">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource EmeraldGreenBrush}"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Administrator"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource EmeraldGreenBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Window Min / Close Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowControlButton}"
                                Content="&#xE921;"
                                Margin="0,0,4,0"
                                FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                AutomationProperties.Name="Minimize Window"
                                Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource WindowCloseButton}"
                                Content="&#xE8BB;"
                                FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                AutomationProperties.Name="Close Application"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. DOUBLE-BEZEL HERO & DRIVE TELEMETRY -->
            <Border Grid.Row="1"
                    Background="{StaticResource DoubleBezelOuterBrush}"
                    BorderBrush="{StaticResource HairlineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Margin="18,12,18,6"
                    Padding="2">
                <!-- Inner Core Card -->
                <Border Background="{StaticResource DoubleBezelInnerBrush}"
                        CornerRadius="14"
                        Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Reclaimable Space -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="RECLAIMABLE JUNK &amp; APPDATA"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ElectricCyanBrush}"
                                       Opacity="0.9"/>
                            <TextBlock x:Name="HeroSizeText"
                                       Text="0.0 MB"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextHighBrush}"
                                       Margin="0,1,0,3"
                                       AutomationProperties.Name="Total Reclaimable Space"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="HeroSubtext"
                                       Text="Deep scan of User Profile, GPU Shaders, AppData &amp; System Temp"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextMediumBrush}"/>
                        </StackPanel>

                        <!-- Right: Live Drive C: Space Card -->
                        <Border Grid.Column="1"
                                Background="#121722"
                                BorderBrush="{StaticResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,12"
                                VerticalAlignment="Center"
                                MinWidth="260"
                                AutomationProperties.Name="System Drive Storage Telemetry">
                            <StackPanel>
                                <!-- Top Row: Icon + Label on Left, Percentage on Right -->
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7F4;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentBlueBrush}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DriveTelemetryLabel"
                                                   Text="OS Drive (C:)"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextHighBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               x:Name="DriveTelemetryPercentage"
                                               Text="-- Free"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource ElectricCyanBrush}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </Grid>

                                <!-- Middle: Drive Gauge Bar -->
                                <ProgressBar x:Name="DriveUsageBar"
                                             Height="6"
                                             Minimum="0" Maximum="100"
                                             Value="50"
                                             Foreground="{StaticResource BrandHeroGradientBrush}"
                                             Background="#1D2436"
                                             BorderThickness="0"
                                             Margin="0,0,0,6"
                                             AutomationProperties.Name="Drive Usage Gauge"/>

                                <!-- Bottom: Formatted Details -->
                                <TextBlock x:Name="DriveTelemetryDetails"
                                           Text="Calculating disk space..."
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextMediumBrush}"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Border>

            <!-- 2. MINIMALIST TOOLBAR & ACCESSIBLE ACTION BUTTONS -->
            <Grid Grid.Row="2" Margin="18,6,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Quick Select & Smart Select -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🟢 Select 100% Safe"
                            Style="{StaticResource PillButton}"
                            FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                            AutomationProperties.Name="Select 100% Safe Caches"
                            AutomationProperties.HelpText="Selects all risk-free cache and temporary targets"
                            Padding="12,5"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Click="SelectSafeOnlyButton_Click"/>
                    <Button Content="Select All"
                            Style="{StaticResource PillButton}"
                            FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                            AutomationProperties.Name="Select All Categories"
                            Padding="10,5"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Click="SelectAllButton_Click"/>
                    <Button Content="Clear"
                            Style="{StaticResource PillButton}"
                            FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                            AutomationProperties.Name="Deselect All Categories"
                            Padding="10,5"
                            FontSize="11"
                            Margin="0,0,10,0"
                            Click="DeselectAllButton_Click"/>
                    <Button x:Name="QuickScanBtn"
                            Style="{StaticResource PillButton}"
                            FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                            AutomationProperties.Name="Rescan All Categories"
                            AutomationProperties.HelpText="Shortcut: F5 or Ctrl+R"
                            Padding="12,5"
                            FontSize="11"
                            Click="ScanButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="11"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Rescan (F5)"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Safety Shield Switch -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="SafeModeCheckBox"
                              Style="{StaticResource ModernSwitchCheckBox}"
                              FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                              AutomationProperties.Name="Safety Shield Filter"
                              AutomationProperties.HelpText="Protects files created or modified within the last 24 hours"
                              IsChecked="False"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Checked="SafeModeCheckBox_Changed"
                              Unchecked="SafeModeCheckBox_Changed"/>
                    <TextBlock Text="Safety Shield (&gt;24h Old)"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMediumBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 3. CLEANABLE CATEGORY CARDS (SCROLLABLE BENTO LIST) -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="18,0,18,6">
                <ItemsControl x:Name="TargetCardsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernCard}"
                                    Margin="0,0,0,8"
                                    Padding="14,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Switch Checkbox -->
                                        <ColumnDefinition Width="Auto"/> <!-- Category Glyph Orb -->
                                        <ColumnDefinition Width="*"/>    <!-- Category Info -->
                                        <ColumnDefinition Width="Auto"/> <!-- Size, Stats & Inspect -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Switch Toggle -->
                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource ModernSwitchCheckBox}"
                                              FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                              AutomationProperties.Name="{Binding Name}"
                                              AutomationProperties.HelpText="{Binding Description}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              Checked="TargetCheckBox_Changed"
                                              Unchecked="TargetCheckBox_Changed"/>

                                    <!-- Category Glyph Orb -->
                                    <Border Grid.Column="1"
                                            Width="38" Height="38"
                                            CornerRadius="10"
                                            Background="#141926"
                                            BorderBrush="{StaticResource HairlineBorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="17"
                                                   Foreground="{Binding CategoryColor}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Category Title, Safety Badge & Path -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextHighBrush}"/>

                                            <!-- Category Badge -->
                                            <Border Background="#161C2C"
                                                    BorderBrush="{StaticResource HairlineBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding CategoryColor}"/>
                                            </Border>

                                            <!-- Safety Badge (e.g. 100% Safe Cache / Orphaned Residual) -->
                                            <Border Background="#101F1A"
                                                    BorderBrush="{StaticResource HairlineBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SafetyBadge}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding SafetyBadgeColor}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMediumBrush}"
                                                   Margin="0,2,0,2"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding FolderPath}"
                                                   FontSize="10"
                                                   FontFamily="{StaticResource MonospaceFont}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Size & Action Tag -->
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedSize}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextHighBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding FormattedStats}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,1,0,3"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusMessage}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource ElectricCyanBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>

                                            <Button Content="Inspect"
                                                    Style="{StaticResource PillButton}"
                                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                                    AutomationProperties.Name="Inspect Large Files"
                                                    Padding="8,2"
                                                    FontSize="10"
                                                    Tag="{Binding}"
                                                    Click="InspectTarget_Click"
                                                    Visibility="{Binding HasTopFiles, Converter={x:Null}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 4. BOTTOM FLOATING ACTION DOCK -->
            <Border Grid.Row="4"
                    Background="#0D1017"
                    BorderBrush="{StaticResource HairlineBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Progress Bar & Status -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ProgressStatusText"
                                       Text="Ready for precision cleanup"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMediumBrush}"
                                       Margin="0,0,0,4"
                                       AutomationProperties.Name="Operation Status"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <ProgressBar x:Name="AppProgressBar"
                                         Height="5"
                                         Minimum="0" Maximum="100"
                                         Value="0"
                                         Foreground="{StaticResource BrandHeroGradientBrush}"
                                         Background="#1A2130"
                                         BorderThickness="0"
                                         AutomationProperties.Name="Cleanup Progress"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   x:Name="ProgressPercentageText"
                                   Text="0%"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextHighBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,12,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </Grid>

                    <!-- Action Dock Buttons -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Secondary Actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="ToggleLogBtn"
                                    Style="{StaticResource PillButton}"
                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Toggle Activity Log Stream"
                                    Padding="12,7"
                                    Margin="0,0,6,0"
                                    Click="ToggleLogBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ToggleLogIcon"
                                               Text="&#xE756;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="11"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ToggleLogText"
                                               Text="Activity Log"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Content="Export Report"
                                    Style="{StaticResource PillButton}"
                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Export Cleanup Audit Report"
                                    Padding="12,7"
                                    FontSize="11.5"
                                    Click="ExportAuditReport_Click"/>
                        </StackPanel>

                        <!-- Right Primary Action Button -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Style="{StaticResource PillButton}"
                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Cancel Active Operation"
                                    Padding="16,8"
                                    Margin="0,0,8,0"
                                    Click="CancelButton_Click"
                                    Visibility="Collapsed"/>

                            <Button x:Name="CleanButton"
                                    Style="{StaticResource HeroCTAButton}"
                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Clean Selected Items"
                                    AutomationProperties.HelpText="Shortcut: Ctrl+Enter"
                                    Click="CleanButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CleanButtonText"
                                               Text="Clean Selected (0.0 MB)"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 5. COLLAPSIBLE LOG STREAM -->
            <Border Grid.Row="5"
                    x:Name="LogDrawerBorder"
                    Background="#07090E"
                    BorderBrush="{StaticResource HairlineBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,20,20"
                    MaxHeight="150"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Activity Log Drawer">
                <Grid Margin="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="ACTIVITY LOG STREAM"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Copy"
                                    Style="{StaticResource PillButton}"
                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Copy Log to Clipboard"
                                    Padding="8,2"
                                    FontSize="10"
                                    Margin="0,0,4,0"
                                    Click="CopyLogButton_Click"/>
                            <Button Content="Clear"
                                    Style="{StaticResource PillButton}"
                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Clear Activity Log"
                                    Padding="8,2"
                                    FontSize="10"
                                    Click="ClearLogButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  x:Name="LogScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LogItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FormattedTime}"
                                                   FontFamily="{StaticResource MonospaceFont}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,8,0"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Message}"
                                                   FontFamily="{StaticResource MonospaceFont}"
                                                   FontSize="10.5"
                                                   Foreground="{Binding BadgeColor}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 6. TOP FILES INSPECTOR OVERLAY MODAL -->
            <Grid Grid.RowSpan="6"
                  x:Name="InspectorModalOverlay"
                  Background="#DD05070B"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Large Files Inspector Dialog">
                <Border Style="{StaticResource ModernCard}"
                        Width="660" Height="500"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#10141F"
                        BorderBrush="{StaticResource ElectricCyanBrush}"
                        BorderThickness="1.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Modal Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="InspectorTitleText"
                                           Text="Largest Junk Files Inspector"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextHighBrush}"/>
                                <TextBlock x:Name="InspectorSubtitleText"
                                           Text="Showing individual large files discovered in this category"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextMediumBrush}"/>
                            </StackPanel>
                            <Button Style="{StaticResource WindowCloseButton}"
                                    Content="&#xE8BB;"
                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                    AutomationProperties.Name="Close Inspector Dialog"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="CloseInspector_Click"/>
                        </Grid>

                        <!-- Items List -->
                        <Border Grid.Row="1"
                                Background="#0A0C12"
                                BorderBrush="{StaticResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="InspectorItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#131722"
                                                    BorderBrush="{StaticResource HairlineBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="0,0,0,6"
                                                    Padding="12,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextHighBrush}"/>
                                                        <TextBlock Text="{Binding FilePath}"
                                                                   FontSize="10"
                                                                   FontFamily="{StaticResource MonospaceFont}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedSize}"
                                                                   FontSize="13.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource ElectricCyanBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding FormattedDate}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMediumBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Modal Footer -->
                        <Button Grid.Row="2"
                                Content="Close Inspector (Esc)"
                                Style="{StaticResource PillButton}"
                                FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                AutomationProperties.Name="Close Inspector Dialog"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0"
                                Padding="18,7"
                                Click="CloseInspector_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 7. GORGEOUS CONFIRMATION OVERLAY MODAL -->
            <Grid Grid.RowSpan="6"
                  x:Name="ConfirmModalOverlay"
                  Background="#EE05070B"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Confirm Cleanup Dialog">
                <Border Width="540"
                        Background="#0F131E"
                        BorderBrush="{StaticResource ElectricCyanBrush}"
                        BorderThickness="1.5"
                        CornerRadius="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="28,24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.85"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Top Icon & Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="48" Height="48"
                                    CornerRadius="14"
                                    Background="#141C2B"
                                    BorderBrush="{StaticResource ElectricCyanBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,16,0">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="22"
                                           Foreground="{StaticResource ElectricCyanBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Confirm Precision Cleanup"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextHighBrush}"/>
                                <TextBlock Text="Ready to purge selected disposable cache files"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Highlight Stat Callout -->
                        <Border Background="#090C14"
                                BorderBrush="{StaticResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,14"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ESTIMATED RECLAIMABLE SPACE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource ElectricCyanBrush}"/>
                                    <TextBlock x:Name="ConfirmModalSizeText"
                                               Text="14.2 GB"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextHighBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        x:Name="ConfirmModalShieldBadge"
                                        Background="#10241B"
                                        BorderBrush="{StaticResource EmeraldGreenBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="ConfirmModalShieldText"
                                               Text="🟢 Safety Shield: ON"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource EmeraldGreenBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="ConfirmModalSummaryText"
                                   Text="Cleaning 7 selected categories. User configs and personal files remain 100% protected."
                                   FontSize="12"
                                   Foreground="{StaticResource TextMediumBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24"/>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1"
                                    Content="Cancel"
                                    Style="{StaticResource PillButton}"
                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                    Padding="18,9"
                                    Margin="0,0,10,0"
                                    Click="CancelConfirmModal_Click"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource HeroCTAButton}"
                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                    Padding="22,9"
                                    Click="ProceedConfirmModal_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Start Cleanup"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 8. CELEBRATION / SUCCESS MODAL -->
            <Grid Grid.RowSpan="6"
                  x:Name="CelebrationModalOverlay"
                  Background="#EE05070B"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Cleanup Completed Celebration Dialog">
                <Border Width="500"
                        Background="#0F131E"
                        BorderBrush="{StaticResource EmeraldGreenBrush}"
                        BorderThickness="1.5"
                        CornerRadius="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="28,24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.85"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Animated Glowing Orb -->
                        <Border Width="60" Height="60"
                                CornerRadius="30"
                                Background="#10241B"
                                BorderBrush="{StaticResource EmeraldGreenBrush}"
                                BorderThickness="2"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="28"
                                       Foreground="{StaticResource EmeraldGreenBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Cleanup Completed!"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextHighBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CelebrationReclaimedText"
                                   Text="Successfully Reclaimed 6.6 GB"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ElectricCyanBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,20"/>

                        <!-- Stats Bento Card -->
                        <Border Background="#090C14"
                                BorderBrush="{StaticResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Width="440"
                                Padding="16"
                                Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="FILES DELETED" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="CelebrationFilesText" Text="14,280" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextHighBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="FOLDERS PURGED" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="CelebrationFoldersText" Text="412" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextHighBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="TIME ELAPSED" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="CelebrationTimeText" Text="14.2s" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextHighBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Export Report"
                                    Style="{StaticResource PillButton}"
                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                    Padding="18,9"
                                    Margin="0,0,10,0"
                                    Click="CelebrationExport_Click"/>
                            <Button Content="Awesome!"
                                    Style="{StaticResource HeroCTAButton}"
                                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                                    Padding="28,9"
                                    Click="CloseCelebration_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
